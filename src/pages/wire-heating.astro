---
import Busy from '../components/Busy.astro';
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../tools/wire-heating/style.css';
import { HOW } from '../tools/wire-heating/how';
import {
  AC_OPT,
  ENDS_OPT,
  FORM_OPT,
  KIND_OPT,
  MAT_OPT,
  MODE_OPT,
  PARAMS,
  PRESET_OPT,
  SHAPE_OPT,
  SURF_OPT,
} from '../tools/wire-heating/params';
import Theory from '../tools/wire-heating/Theory.astro';

const name = '配線の発熱';
const P = Object.fromEntries(PARAMS.map((d) => [d.k, d]));
const playIcon =
  '<svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.2l7.6 4.8L3 10.8z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9"/><rect x="7.2" y="1.5" width="2.8" height="9"/></svg>';
---
<SiteLayout title={name} tool={{ id: 'wire-heating', name }}>
  <PageTitle title={name}>電流を流した導線や基板の銅箔がどれだけ熱くなるかを計算します。</PageTitle>

  <div class="tgrid wh-grid" id="wh" data-form="board">
    <div class="wh-main">
      <Panel hid="hd-fig" title="配線" fixed>
        <span slot="aux" class="aux tp-st"><span class="led" id="wh-led" aria-hidden="true"></span><span id="wh-st" aria-live="polite"></span></span>
        <div slot="aux" class="seg" id="wh-form" role="group" aria-label="形">
          {FORM_OPT.map(([v, l], i) => <button type="button" data-v={v} aria-pressed={i === 0 ? 'true' : 'false'}>{l}</button>)}
        </div>

        <div class="wh-tools">
          <div class="seg wh-board" id="wh-view" role="group" aria-label="表示">
            <button type="button" data-v="T" aria-pressed="true">温度</button>
            <button type="button" data-v="J" aria-pressed="false">電流密度</button>
          </div>
          <div class="seg" id="wh-scale" role="group" aria-label="色の目盛りの上限">
            <button type="button" data-v="all" aria-pressed="true" title="通電から最後までの最高温度">全体の最高</button>
            <button type="button" data-v="now" aria-pressed="false" title="今の時刻の最高温度。冷えていく熱の広がりが見やすい">今の最高</button>
          </div>
        </div>

        <div class="wh-board">
          <div class="scope wh-scr"><canvas class="wh-cv wh-hBd" id="cv-board" role="img" aria-label="基板の温度または電流密度の分布。指した所の値を左上に表示"></canvas><Busy id="bd-busy" text="計算中…" /></div>
        </div>

        <div class="wh-line">
          <div class="scope wh-scr"><canvas class="wh-cv wh-hW" id="cv-wire" role="img" aria-label="導線を横から見た温度の色と、上の空気・放射・端子へ逃げる熱"></canvas></div>
          <div class="sbar wh-lg">
            <span class="stag"><i class="wh-dot" aria-hidden="true"></i>空気の流れ</span>
            <span class="stag"><i class="sw rd" aria-hidden="true"></i>放射</span>
            <span class="stag"><i class="sw tm" aria-hidden="true"></i>端子への伝導</span>
          </div>
        </div>

        <div class="wh-path">
          <div class="wh-tools">
            <div class="chips" id="wh-preset" role="group" aria-label="経路の見本" data-nosave>
              {PRESET_OPT.map(([v, l], i) => <button type="button" class="chip" data-v={v} aria-pressed={i === 2 ? 'true' : 'false'}>{l}</button>)}
            </div>
            <button type="button" class="tg" id="tg-air" aria-pressed="true" title="周りの空気の温度と流れ"><span class="led on" aria-hidden="true"></span>空気</button>
          </div>
          <div class="scope wh-scr"><canvas class="wh-cv wh-hPa wh-drag" id="cv-path" role="img" aria-label="縦に立てた経路の温度と周りの空気。点をドラッグして形を変更"></canvas></div>
          <p class="wh-note">縦に立てた経路を横から。点のドラッグで経路を変更</p>
        </div>

        <p class="wh-say" id="wh-say" aria-live="off"></p>
        <div class="tp">
          <button type="button" class="tp-ib" id="tp-home" title="最初へ" aria-label="最初へ"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="1.8" height="9"/><path d="M10.5 1.5v9L4 6z"/></svg></button>
          <button type="button" class="tp-pp on" id="tp-pp" title="一時停止" aria-label="一時停止" set:html={playIcon} />
          <div class="tp-tl">
            <div class="tp-trk" id="tp-trk" role="slider" tabindex="0" aria-label="通電からの時間" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <div class="tp-rail"></div>
              <div class="tp-fill" id="tp-fill"></div>
              <div class="tp-th" id="tp-th"></div>
            </div>
            <div class="tp-tm"><span>通電から <b id="tp-a">0 s</b></span><span id="tp-b"></span></div>
          </div>
          <div class="tp-side"></div>
        </div>
        <div class="ptab"><ParamRow d={P.rate} /><ParamRow d={P.span} /></div>
      </Panel>

      <Panel hid="hd-air" title="周りの空気" class="wh-line">
        <div class="scope wh-scr"><canvas class="wh-cv wh-hA" id="cv-air" role="img" aria-label="線の断面と、温まって昇る空気の温度"></canvas></div>
        <div class="sbar wh-lg">
          <span class="stag"><i class="sw air" aria-hidden="true"></i>空気の温度上昇</span>
          <span class="stag"><i class="wh-dot" aria-hidden="true"></i>空気の流れ</span>
        </div>
        <p class="wh-note">線の断面を横から。粒の動きは実際の 1/10 の速さ</p>
      </Panel>

      <Panel hid="hd-temp" title="温度">
        <div class="wh-c2">
          <div>
            <div class="wh-ghr">
              <h3 class="wh-gh"><span class="wh-board">配線に沿った温度</span><span class="wh-line">長さ方向</span><span class="wh-path">経路に沿って</span></h3>
            </div>
            <div class="scope wh-scr"><canvas class="wh-cv wh-hP" id="cv-prof" role="img" aria-label="配線に沿った温度の分布"></canvas></div>
          </div>
          <div>
            <div class="wh-ghr">
              <h3 class="wh-gh">時間の変化</h3>
              <div class="seg wh-sseg" id="wh-taxis" role="group" aria-label="横軸の目盛り">
                <button type="button" data-v="log" aria-pressed="true" title="短い時間ほど引き伸ばす">対数</button>
                <button type="button" data-v="lin" aria-pressed="false" title="時間に比例">線形</button>
              </div>
            </div>
            <div class="scope wh-scr"><canvas class="wh-cv wh-hT" id="cv-time" data-seek role="slider" tabindex="-1" aria-label="最高温度と平均温度の時間の変化。押すとその時刻へ"></canvas></div>
          </div>
        </div>
        <div class="sbar wh-lg">
          <span class="stag"><i class="sw mx" aria-hidden="true"></i>最高</span>
          <span class="stag"><i class="sw av" aria-hidden="true"></i>平均</span>
          <span class="stag"><i class="sw lim" aria-hidden="true"></i><span class="wh-board">Tg</span><span class="wh-wire">融点・耐熱</span></span>
        </div>
      </Panel>

      <Panel hid="hd-xs" title="断面と熱の行き先" class="wh-wire">
        <div class="wh-c2">
          <div>
            <h3 class="wh-gh">断面の電流密度</h3>
            <div class="scope wh-scr"><canvas class="wh-cv wh-hX" id="cv-xs" role="img" aria-label="断面の電流密度の分布"></canvas></div>
          </div>
          <div>
            <h3 class="wh-gh">熱の行き先</h3>
            <div class="scope wh-scr"><canvas class="wh-cv wh-hX" id="cv-bal" role="img" aria-label="発熱と、対流・放射・端子・温度上昇への内訳"></canvas></div>
          </div>
        </div>
      </Panel>
    </div>

    <div class="wh-side">
      <Panel hid="hd-res" title="結果">
        <dl class="metrics wh-res" id="wh-res"></dl>
      </Panel>

      <Panel hid="hd-board" title="基板" class="wh-board">
        <div class="ptab">
          <ChoiceRow k="kind" name="パターン" choices={KIND_OPT} value="neck" layout="chips" />
          <ParamRow d={P.bw} />
          <ParamRow d={P.tcu} />
          <ParamRow d={P.tb} />
        </div>
      </Panel>

      <Panel hid="hd-cond" title="導体" class="wh-wire">
        <div class="ptab">
          <ChoiceRow k="mat" name="材料" choices={MAT_OPT} value="cu" layout="chips" />
          <ChoiceRow k="shape" name="断面" choices={SHAPE_OPT} value="round" />
          <ParamRow d={P.d} />
          <ParamRow d={P.w} />
          <ParamRow d={P.t} />
          <div class="wh-line"><ParamRow d={P.len} /></div>
          <div class="wh-path"><ParamRow d={P.scale} /></div>
          <ChoiceRow k="surf" name="表面" choices={SURF_OPT} value="oxid" />
          <ChoiceRow k="ends" name="端子" choices={ENDS_OPT} value="sink" />
        </div>
      </Panel>

      <Panel hid="hd-cur" title="電流">
        <div class="ptab">
          <div class="wh-wire"><ParamRow d={P.I} /></div>
          <div class="wh-board"><ParamRow d={P.bI} /></div>
          <ChoiceRow k="ac" name="種類" choices={AC_OPT} value="dc" />
          <ParamRow d={P.f} />
          <ChoiceRow k="mode" name="通電" choices={MODE_OPT} value="cont" />
          <ParamRow d={P.tp} />
        </div>
      </Panel>

      <Panel hid="hd-env" title="周り">
        <div class="ptab">
          <ParamRow d={P.Ta} />
          <div class="wh-wire"><ParamRow d={P.wind} /></div>
        </div>
      </Panel>
    </div>

    <Panel hid="hd-how" title="発熱のしくみ" class="wh-howp">
      <ol class="wh-how">
        {HOW.map(([h, fig, d], i) => (
          <li><h3><b>{i + 1}</b>{h}</h3><Fragment set:html={fig} /><p>{d}</p></li>
        ))}
      </ol>
    </Panel>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="wire-heating" />
  <script>
    import '../tools/wire-heating/client';
  </script>
</SiteLayout>
