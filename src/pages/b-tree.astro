---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../tools/b-tree/style.css';
import { DEFS, STAGES } from '../tools/b-tree/model';
import { SIZE, SPEED, VOL } from '../tools/b-tree/params';
import Theory from '../tools/b-tree/Theory.astro';
import { rng, SHAPES, shapeAt } from '../tools/list-queue-stack/model';

const name = 'B木';
/** バーの選択肢の小さな絵 */
const shapeSvg = (k: (typeof SHAPES)[number][0]): string => {
  const r = rng(5),
    bars = Array.from({ length: 8 }, (_, i) => {
      const h = shapeAt(k, i / 7, r) * 11;
      return `<rect x="${(i * 3.2).toFixed(1)}" y="${(12 - h).toFixed(1)}" width="2.3" height="${h.toFixed(1)}"/>`;
    }).join('');
  return `<svg viewBox="0 0 26 12" aria-hidden="true">${bars}</svg>`;
};
/* 初めはランダムを先頭に置く */
const BARS = [...SHAPES]
  .sort((a, b) => Number(b[0] === 'rand') - Number(a[0] === 'rand'))
  .map(([k, t]) => ({ k, t, svg: shapeSvg(k) }));
---
<SiteLayout title={name} tool={{ id: 'b-tree', name }}>
  <PageTitle title={name}>1 つのノードに多くのキーを入れた、段の少ない探索木です。ディスクを読む回数が少ないので、データベースやファイルシステムで使われます。</PageTitle>

  <div class="tgrid" id="bt" data-mode="one">
    <Panel hid="hd-fig" title="B木" class="a-fig" fixed>
      <span slot="aux" class="aux tp-st" id="bt-st" hidden><span class="led" id="bt-led" aria-hidden="true"></span><span id="bt-stT"></span></span>
      <div slot="aux" class="seg" id="bt-mode" role="group" aria-label="表示">
        <button type="button" data-v="one" aria-pressed="true">単独</button>
        <button type="button" data-v="cmp" aria-pressed="false">比較</button>
        <button type="button" data-v="list" aria-pressed="false">一覧</button>
      </div>
      <div class="sbar bt-lg">
        <span class="bt-lgl">
          <span class="stag"><i class="bt-sw bt-cmp" aria-hidden="true"></i>読み込み・比較</span>
          <span class="stag"><i class="bt-sw bt-mov" aria-hidden="true"></i>書き込み</span>
          <span class="stag"><i class="bt-sw bt-bad" aria-hidden="true"></i>あふれ・不足</span>
          <span class="stag"><i class="bt-sw" aria-hidden="true"></i>キー</span>
          <span class="stag"><i class="bt-sw bt-wait" aria-hidden="true"></i>待機中</span>
          <span class="stag"><i class="bt-sw bt-done" aria-hidden="true"></i>読み出し済み</span>
        </span>
        <span class="bt-end"><span class="sr" id="bt-say"></span><button type="button" class="prst" id="bt-reset2" hidden>リセット</button></span>
      </div>
      <div class="bt-steps" id="bt-steps" role="group" aria-label="工程">
        {STAGES.map(([, t, d], i) => (
          <button type="button" data-s={i} aria-pressed={i === 0 ? 'true' : 'false'}><b>{i + 1} {t}</b><em></em><span>{d}</span></button>
        ))}
      </div>
      <div class="scope bt-scr bt-solo"><canvas id="bt-cv" role="img" aria-label="B木"></canvas></div>
      <div class="bt-race" id="bt-race"></div>
      <div class="tp">
        <button type="button" class="tp-ib" id="tp-home" title="最初へ" aria-label="最初へ"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="1.8" height="9"/><path d="M10.5 1.5v9L4 6z"/></svg></button>
        <button type="button" class="tp-pp" id="tp-pp" title="再生" aria-label="再生"><svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.2l7.6 4.8L3 10.8z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9"/><rect x="7.2" y="1.5" width="2.8" height="9"/></svg></button>
        <div class="tp-tl">
          <div class="tp-trk" id="tp-trk" role="slider" tabindex="0" aria-label="進み具合" aria-valuemin="0" aria-valuemax="1" aria-valuenow="0">
            <div class="tp-rail"></div>
            <div class="tp-fill" id="tp-fill"></div>
            <div class="tp-th" id="tp-th"></div>
          </div>
          <div class="tp-tm"><span><b id="tp-a">0</b> / <span id="tp-b">0</span> 手順</span><span id="tp-t"></span></div>
        </div>
        <div class="tp-side">
          <button type="button" class="tp-sq" id="tp-back" title="前の手順" aria-label="前の手順"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12 3L6 8l6 5M4 3v10"/></svg></button>
          <button type="button" class="tp-sq" id="tp-step" title="次の手順" aria-label="次の手順"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3l6 5-6 5M12 3v10"/></svg></button>
        </div>
      </div>
      <div class="ptab bt-row"><ParamRow d={SPEED} /></div>
    </Panel>

    <Panel hid="hd-mat" title="操作と計算量" class="a-mat">
      <span slot="aux" class="aux">n = キーの数　m = 次数　k = 読むキーの数　* 償却</span>
      <div class="bt-mx"><table class="bt-mt" id="bt-mx"></table></div>
    </Panel>

    <Panel hid="hd-cmp" title="計算結果" class="a-cmp">
      <div class="bt-rw"><table class="bt-rt" id="bt-rt"></table></div>
    </Panel>

    <div class="col">
      <Panel hid="hd-str" title="データ構造" class="a-str">
        <span slot="aux" class="aux" id="bt-an"></span>
        <div id="bt-str">
          <div class="chips">
            {DEFS.map((d) => <button type="button" class="chip" data-v={d.id} aria-pressed={d.id === 'b' ? 'true' : 'false'}>{d.name}</button>)}
          </div>
        </div>
        <div class="ptab bt-row" id="bt-byw" hidden>
          <ChoiceRow k="by" name="比較の対象" choices={[['str', 'データ構造'], ['m', '次数'], ['shape', 'キーの順番']]} value="str" />
        </div>
      </Panel>
      <Panel hid="hd-data" title="データ" class="a-data">
        <button slot="aux" type="button" class="prst" id="bt-new">新しいデータ</button>
        <div class="ptab bt-row">
          <ChoiceRow k="m" name="次数" choices={[[3, '3'], [4, '4'], [5, '5'], [8, '8'], [16, '16'], [32, '32']]} value={4} msg />
          <ParamRow d={SIZE} />
          <div class="prow chr wide">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-shape">キーの順番</span></div>
            <div class="c-rst"></div>
            <div class="c-sub"><div class="chips" id="bt-shape" role="group" aria-labelledby="n-shape">
              {BARS.map(({ k, t, svg }) => <button type="button" class="chip" data-v={k} aria-pressed={k === 'rand' ? 'true' : 'false'}><Fragment set:html={svg} />{t}</button>)}
            </div></div>
          </div>
          <ChoiceRow k="method" name="追加の方法" choices={[['add', '1 個ずつ'], ['bulk', 'まとめて構築']]} value="add" msg />
          <ChoiceRow k="del" name="削除の方法" choices={[['half', '半分で併合'], ['empty', '空で解放']]} value="half" msg />
        </div>
      </Panel>
      <Panel hid="hd-lv" title="データベースの段数" class="a-lv">
        <div class="ptab bt-row">
          <ChoiceRow k="rows" name="行数" choices={[['1e4', '1 万'], ['1e6', '100 万'], ['1e8', '1 億'], ['1e10', '100 億']]} value="1e8" />
          <ChoiceRow k="page" name="ページ" layout="chips" choices={[[4096, '4 KB SQLite'], [8192, '8 KB PostgreSQL'], [16384, '16 KB MySQL InnoDB']]} value={8192} />
        </div>
        <div class="bt-lv" id="bt-lv"></div>
      </Panel>
    </div>
    <div class="col">
      <Panel hid="hd-ops" title="操作" class="a-ops">
        <button slot="aux" type="button" class="prst" id="bt-reset" hidden>リセット</button>
        <div class="bt-ow">
          <table class="bt-ot">
            <thead><tr><th scope="col">実行</th><th scope="col" class="bt-how">内容</th><th scope="col" class="r">計算量</th><th scope="col" class="r" title="キー 31 個で 8 通りのデータを試した 1 回の平均。読み込みと書き込みの合計">n = 31 の平均</th></tr></thead>
            <tbody id="bt-ops"></tbody>
          </table>
        </div>
      </Panel>
      <Panel hid="hd-out" title="計算結果" class="a-out">
        <dl class="metrics bt-res">
          <div class="m m-main"><dt>読み込みと書き込み</dt><dd><span id="o-t">0</span><span class="u">回</span></dd></div>
          <div class="m"><dt>読み込み</dt><dd id="o-r">0</dd></div>
          <div class="m"><dt>書き込み</dt><dd id="o-w">0</dd></div>
          <div class="m"><dt>比較</dt><dd id="o-c">0</dd></div>
          <div class="m"><dt>分割</dt><dd id="o-s">0</dd></div>
          <div class="m"><dt>併合</dt><dd id="o-m">0</dd></div>
          <div class="m"><dt>木の段数</dt><dd id="o-d">–</dd></div>
          <div class="m"><dt>ノード</dt><dd id="o-n">0</dd></div>
          <div class="m"><dt>キー</dt><dd id="o-k">0</dd></div>
          <div class="m"><dt>充填率</dt><dd id="o-f">–</dd></div>
          {DEFS.map((d) => <div class="m m-sub m-w" data-for={d.id}><dt>利用例</dt><dd>{d.ex}</dd></div>)}
        </dl>
      </Panel>
      <Panel hid="hd-snd" title="音" class="a-snd">
        <div slot="aux" class="seg"><button type="button" id="bt-snd" aria-pressed="true"><span class="led on" id="bt-sndL" aria-hidden="true"></span> <span id="bt-sndT">オン</span></button></div>
        <div class="ptab bt-row"><ParamRow d={VOL} /></div>
      </Panel>
    </div>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="b-tree" />
  <script>
    import '../tools/b-tree/client';
  </script>
</SiteLayout>
