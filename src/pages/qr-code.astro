---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import More from '../components/More.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import RowReset from '../components/RowReset.astro';
import { order, TOOLS, type Tool } from '../data/tools';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../tools/qr-code/style.css';
import { BOOST_CHOICES, ECC_CHOICES, MAX_LEN, MODE_CHOICES, TEXT0, VER } from '../tools/qr-code/params';
import Theory from '../tools/qr-code/Theory.astro';

const name = 'QR コード';
/* 同じカテゴリ（準備中を含む）の後ろに、符号化を扱うもの、ほかの公開中のツールを並べる */
const CAT = '信号・通信';
const NEAR = ['jpeg', 'noise'];
const related = [
  ...order(TOOLS.filter((t) => t.c === CAT && t.id !== 'qr-code')),
  ...NEAR.map((id) => TOOLS.find((t) => t.id === id)).filter((t): t is Tool => !!t && !t.s),
  ...TOOLS.filter((t) => t.c !== CAT && !t.s && !NEAR.includes(t.id)),
];
const STAGES = [
  ['文字列', 'q-s0'],
  ['ビット列', 'q-s1'],
  ['符号語', 'q-s2'],
  ['誤り訂正', 'q-s3'],
  ['配置', 'q-s4'],
  ['マスク', 'q-s5'],
  ['完成', 'q-s6'],
];
const TOOLS_SOIL = [
  ['ink', 'しみ', '押した所のまわりを黒くする', '<path d="M12 3c3 4 6 7.5 6 11a6 6 0 0 1-12 0c0-3.5 3-7 6-11z"/>'],
  ['rub', 'こすれ', '押した所のまわりを白くする', '<path d="M4 18L18 4M8 20L20 8"/>'],
  [
    'flip',
    '1 つずつ',
    '押したモジュールの明暗を入れ替える',
    '<rect x="5" y="5" width="6" height="6"/><rect x="13" y="13" width="6" height="6"/>',
  ],
];
---
<SiteLayout title={name} tool={{ id: 'qr-code', name }} description="文字列から QR コードができるまでを段階ごとに確認でき、誤り訂正の実験もできます。" note="符号化と復号は、このツールの実装によるものです。画像から格子を読み取る処理はしません。QRコードは株式会社デンソーウェーブの登録商標です。">
  <PageTitle title={name}>文字列から QR コードができるまでを、モード・ビット列・符号語・リード・ソロモン符号の誤り訂正語・配置・マスク・形式情報の段に分けて追います。図のモジュールと符号語の表は結びついていて、押した符号語のビットがどの文字のどの部分か、どこに置かれたかが分かります。「誤り訂正実験」に切り替えて図をなぞると、しみやこすれで壊れた符号語をリード・ソロモン符号で訂正して読み取り、訂正できる上限を超えると読み取れなくなります。</PageTitle>

  <div class="tgrid">
    <Panel hid="hd-map" title="QR コードの構造" class="a-map" fixed>
      <div slot="aux" class="seg" id="p-act" role="group" aria-label="図で行うこと" data-nosave>
        <button type="button" data-v="look" aria-pressed="true" title="押した符号語の中身と配置した場所を調べる">調べる</button><button type="button" data-v="soil" aria-pressed="false" title="図にしみやこすれを付け、読み取って誤り訂正する">誤り訂正実験</button>
      </div>
      <div slot="aux" class="seg"><button type="button" id="saveBtn" title="今の図の QR コードを PNG で保存する">保存</button></div>

      <div class="q-stagerow" id="q-stagerow">
        <ol class="q-stage" id="q-stage" aria-label="符号化の段">
          {STAGES.map(([t, id], i) => <li><button type="button" data-s={i} aria-labelledby={id}></button><span id={id}>{t}<small class="hw" data-ph="000 ビット"></small></span></li>)}
        </ol>
      </div>

      <div class="q-map">
        <div class="q-left">
          <div class="q-tools" id="q-tools" role="group" aria-label="汚れを付ける道具" hidden>
            {TOOLS_SOIL.map(([v, l, t, ic], i) => <button type="button" class="q-tool" data-t={v} aria-pressed={i === 0 ? 'true' : 'false'} title={t}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic} />{l}</button>)}
            <button type="button" class="q-tool" id="q-rand" title="ランダムに 8 個のモジュールの明暗を入れ替える"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="8" r="1.5"/><circle cx="16" cy="6" r="1.5"/><circle cx="12" cy="13" r="1.5"/><circle cx="6" cy="17" r="1.5"/><circle cx="18" cy="16" r="1.5"/></svg>ランダム</button>
            <button type="button" class="q-tool r" id="q-clean" title="汚れをすべて消す"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4.5V9h4.5"/></svg>元に戻す</button>
          </div>
          <div class="q-fig" id="q-fig" tabindex="0" role="group" aria-roledescription="図" aria-label="QR コードの図。押した符号語を選ぶ。← → で前後の符号語へ移る"><canvas id="cv-map" width="370" height="370"></canvas></div>
          <div class="sbar rdbar" data-ph="(176, 176) · 符号語 3705 のビット 7 · 誤り訂正"><span class="rd" id="q-rd"></span></div>
          <div class="q-leg" id="q-leg"><span><i class="h"></i>モードと文字数</span><span><i class="d"></i>データ</span><span><i class="p"></i>終端と埋め草</span><span><i class="e"></i>誤り訂正語</span><span><i class="f"></i>形式情報</span></div>
          <div class="q-leg" id="q-leg2" hidden><span><i class="x"></i>元と違うモジュール</span><span><i class="xd"></i>訂正した符号語</span></div>
        </div>
        <div class="q-right">
          <p class="q-sub">符号語<small id="q-cwn"></small></p>
          <div class="q-cwbox"><div class="q-cws" id="q-cws" role="group" aria-label="符号語（配置順）"></div></div>
          <div class="q-exp" id="q-exp" hidden>
            <p class="q-sub">読み取り結果<small id="q-readst"></small></p>
            <div class="q-meters" id="q-meters"></div>
            <div class="q-out" id="q-out" aria-live="polite"></div>
          </div>
          <div class="q-insp" id="q-insp" aria-live="polite"></div>
          <div class="q-stepnav" id="q-stepnav"><button type="button" class="q-step" id="q-prev"><svg viewBox="0 0 6 10" aria-hidden="true"><path d="M5 1L1 5L5 9"/></svg><span><small>前の段</small><b></b></span></button><button type="button" class="q-step r" id="q-next"><span><small>次の段</small><b></b></span><svg viewBox="0 0 6 10" aria-hidden="true"><path d="M1 1L5 5L1 9"/></svg></button></div>
        </div>
      </div>
    </Panel>

    <div class="col c1">
      <Panel hid="hd-in" title="入力" class="a-in">
        <div class="ptab">
          <div class="prow q-txt" id="p-text">
            <div class="c-name"><label class="pn" for="q-text">文字列</label></div>
            <RowReset label="文字列を既定値に戻す" />
            <div class="c-val"><textarea id="q-text" rows="2" maxlength={MAX_LEN} spellcheck="false" autocomplete="off" autocapitalize="off" aria-describedby="q-cnt m-text">{TEXT0}</textarea></div>
            <div class="c-sub"><p class="q-cnt" id="q-cnt"></p><p class="msg" id="m-text" aria-live="polite"></p></div>
          </div>
          <ChoiceRow k="ecc" name="誤り訂正" sub="誤り訂正語の割合。高いほど汚れに強いが、同じ文字列でもバージョンが大きくなる" choices={ECC_CHOICES} value="M" />
          <ParamRow d={VER} />
        </div>
        <More id="g-in"><div class="ptab">
          <ChoiceRow k="mode" name="モード" sub="文字をビットにする方法。文字列全体を 1 つのモードで符号化する" choices={MODE_CHOICES} value="auto" msg />
          <ChoiceRow k="boost" name="レベルを上げる" sub="バージョンを変えずに入るなら、誤り訂正のレベルを上げる（多くの生成ライブラリの既定）" choices={BOOST_CHOICES} value="0" />
        </div></More>
      </Panel>

      <Panel hid="hd-out" title="計算結果" class="a-out">
        <dl class="metrics c3">
          <div class="m m-main"><dt>バージョン</dt><dd><span id="o-ver"></span><span class="m-sub" id="o-vers"></span></dd></div>
          <div class="m"><dt>データ</dt><dd><span id="o-data"></span><span class="m-sub" id="o-datas"></span></dd></div>
          <div class="m"><dt>誤り訂正語</dt><dd><span id="o-ec"></span><span class="m-sub" id="o-ecs"></span></dd></div>
          <div class="m"><dt>マスク</dt><dd><span id="o-mask"></span><span class="m-sub" id="o-masks"></span></dd></div>
          <div class="m"><dt>暗いモジュール</dt><dd><span id="o-dark"></span><span class="m-sub" id="o-darks"></span></dd></div>
          <div class="m"><dt>余り</dt><dd><span id="o-room"></span><span class="m-sub" id="o-rooms"></span></dd></div>
          <div class="m"><dt>余りのビット</dt><dd><span id="o-rem"></span><span class="m-sub" id="o-rems"></span></dd></div>
        </dl>
      </Panel>
    </div>

    <div class="col c2">
      <Panel hid="hd-mask" title="マスクの比較" class="a-mask">
        <div slot="aux" class="seg" id="p-mauto" role="group" aria-label="マスクの選び方" data-nosave>
          <button type="button" data-v="auto" aria-pressed="true" title="ペナルティがいちばん小さいマスクを使う">自動</button><button type="button" data-v="fix" aria-pressed="false" title="下で選んだマスクを使う">固定</button>
        </div>
        <div class="q-masks-c"><div class="q-masks" id="q-masks" role="group" aria-label="マスク">
          {Array.from({ length: 8 }, (_, i) => <button type="button" class="q-mask" data-m={i} aria-pressed="false"><canvas width="58" height="58" aria-hidden="true"></canvas><span class="t"><b>{i}</b><span></span></span></button>)}
        </div></div>
        <p class="q-sub q-sub2">ペナルティの内訳<small>小さいほど読み取りやすい</small></p>
        <div class="q-pen" id="q-pen"></div>
        <div class="q-pen-leg"><span><i class="n1"></i>N1 同じ色の並び</span><span><i class="n2"></i>N2 2×2 の塊</span><span><i class="n3"></i>N3 ファインダーに似た並び</span><span><i class="n4"></i>N4 明暗の偏り</span></div>
      </Panel>
    </div>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools list={related} />
  <script>
    import '../tools/qr-code/client';
  </script>
</SiteLayout>
