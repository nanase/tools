          <div class="m"><dt>減衰時間 <i>T</i><sub>60</sub>（垂直）</dt><dd><span id="o-tv"></span><span class="m-sub" id="o-tvs"></span></dd></div>
          <div class="m"><dt>減衰時間 <i>T</i><sub>60</sub>（平行）</dt><dd><span id="o-th"></span><span class="m-sub" id="o-ths"></span></dd></div>
          <div class="m"><dt>胴へ逃げる損失</dt><dd><span id="o-eb"></span><span class="m-sub" id="o-ebs"></span></dd></div>
