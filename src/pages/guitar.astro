---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import More from '../components/More.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Transport from '../components/Transport.astro';
import TransportButton from '../components/TransportButton.astro';
import TransportState from '../components/TransportState.astro';
import { order, TOOLS } from '../data/tools';
import SiteLayout from '../layouts/SiteLayout.astro';
import { outVol, TEMPO } from '../lib/play';
import { ROOMS } from '../lib/reverb';
import { gridSvg } from '../lib/scope';
import '../tools/guitar/style.css';
import { BODY_TYPES, WOODS } from '../tools/guitar/body';
import Credits from '../tools/guitar/Credits.astro';
import { CHORD_KEYS, QUALITIES, ROOT_KEYS, ROOTS } from '../tools/guitar/chords';
import { TOOLS as PICKS } from '../tools/guitar/model';
import {
  AMP,
  ANGLE,
  DIA,
  DIST,
  EXAG,
  FMAX,
  HOLE,
  NOISE,
  POS,
  SCALE,
  SLANT,
  SLOW,
  SPANS,
  TEN,
  THICK,
  VIB_HZ,
  VIB_W,
  VOL0,
  VOLUME,
} from '../tools/guitar/params';
import { bodyGrid } from '../tools/guitar/plot';
import { PIECES } from '../tools/guitar/score';
import { MATERIALS, SETS, TUNINGS } from '../tools/guitar/strings';
import Theory from '../tools/guitar/Theory.astro';

const name = 'ギター音響モデル';
/* 同じカテゴリ（準備中を含む）の後ろに、ほかのカテゴリの公開中のツールを並べる */
const CAT = '音響モデル';
const related = [
  ...order(TOOLS.filter((t) => t.c === CAT && t.id !== 'guitar')),
  ...TOOLS.filter((t) => t.c !== CAT && !t.s),
];
const tunName = (n: readonly number[]) => {
  const L = ['C', 'C♯', 'D', 'D♯', 'E', 'F', 'F♯', 'G', 'G♯', 'A', 'A♯', 'B'];
  return [...n]
    .reverse()
    .map((x) => L[x % 12])
    .join(' ');
};
/* コードの根音を選ぶ 1 オクターブの鍵盤（黒鍵は左右の白鍵の境目に置く。fm-synth の鍵盤と同じ並べ方） */
const BLACK = new Set([1, 3, 6, 8, 10]),
  PW = 100 / 7,
  PBW = PW * 0.62;
let pwi = 0;
const PIANO = ROOTS.map((_, i) => {
  const black = BLACK.has(i),
    k = { i, black, left: black ? pwi * PW - PBW / 2 : pwi * PW };
  if (!black) pwi++;
  return k;
});
---
<SiteLayout title={name} tool={{ id: 'guitar', name }} description="アコースティックギターを物理モデルで鳴らします。弦の材質・太さ・張力、押さえるフレット、弾く位置、表板と胴、部屋の残響から、弦の振動と音を計算します。" note="音と計算結果は、論文の模型を簡略化した物理モデルによるものです。">
  <PageTitle title={name}>弦の振動（曲げ剛性と周波数で変わる損失を含む硬い弦）と、駒でつながった胴（表板とサウンドホールの空気の共振、高い周波数の多数のモード）を計算して、ギターの音を作ります。弦を押すと、そのフレットを押さえて弾きます。押したまま動かすとビブラート、胴の上でなでると横切った弦が鳴ります。弦の材質・太さ・張力、弾く位置や向き、表板の厚さや胴の容積を変えると、音と振動がすぐに変わります。部屋の残響を付けて、曲の演奏もできます。</PageTitle>

  <div class="tgrid">
    <Panel hid="hd-neck" title="指板" class="a-neck" fixed>
      <div slot="aux" class="seg" id="p-nv" role="group" aria-label="振動の見せ方"><button type="button" data-v="blur" aria-pressed="true" title="実際の速さで、目に見える残像（振れる範囲）を描く">残像</button><button type="button" data-v="slow" aria-pressed="false" title="振動をゆっくりにして、弦の形（折れ目が往復する様子）を描く。減衰は実際の速さ">スロー</button></div>
      <div class="sbar">
        <span class="stag"><i class="sw" aria-hidden="true"></i>弦の変位 <b id="nk-ex"></b></span>
        <span class="stag" id="nk-tm"></span>
        <span class="stag" id="nk-chd" hidden></span>
        <span class="stag nk-note" id="nk-note"></span>
      </div>
      <div class="nkw" id="nkw">
        <svg class="neck" id="neck" tabindex="0" role="group" aria-roledescription="指板" aria-label="指板と弦。弦を押すと、そのフレットを押さえて弾く。押したまま上下に動かすと弦を押し上げ、左右に動かすと弦の向きに揺らす（ビブラート）。駒の側の胴の上を押すと、押さえたままのフレットで弾き、押したまま動かすと横切った弦を弾く。弾く位置の線の両端と三角をつかむと、弾く位置を動かす。矢印キーで弦とフレットを選び、Enter で弾く"></svg>
      </div>
      <p class="sr" id="nk-live" aria-live="polite"></p>
      <More id="g-neck" title="表示の設定"><div class="ana2">
        <div class="ptab">
          <ChoiceRow k="ex" name="振幅の強調" sub="弦の変位を何倍にして描くか。×1 は弦の間隔に対して実際の大きさ（弦の間隔は実際より広げて描く）" choices={EXAG.map((v) => [v, `×${v}`] as const)} value={3} />
        </div>
        <div class="ptab" id="sl-row" hidden>
          <ChoiceRow k="sl" name="スローの速さ" sub="振動を何分の 1 の速さで描くか" choices={SLOW.map((v) => [v, `1/${v}`] as const)} value={50} />
        </div>
      </div></More>
    </Panel>

    <Collapsible hid="hd-chd" title="コード" class="a-chd">
      <div class="chd">
        <div class="ptab chd-l">
          <div class="prow chr wide" id="p-croot">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-croot">ルート</span><p class="desc tip" id="t-croot" role="tooltip" hidden>コードの根音。押すと、そのコードを押さえる。鍵の下の文字はキーボードのキー（中段が白鍵、上段が黒鍵）。次によく続くコードの根音は色が付き、その種類を小さく添える</p></div>
            <div class="c-sub"><div class="ckb" id="ckb" role="group" aria-labelledby="n-croot" aria-describedby="t-croot">
              {PIANO.filter((k) => !k.black).map((k) => <button type="button" class="kk w ck" data-v={k.i} style={`left:${k.left.toFixed(3)}%;width:${PW.toFixed(3)}%`} aria-pressed="false" aria-label={`${ROOTS[k.i]}（キー ${ROOT_KEYS[k.i]}）`}><b>{ROOTS[k.i]}</b><i class="ck-s"></i><span class="ky">{ROOT_KEYS[k.i]}</span></button>)}
              {PIANO.filter((k) => k.black).map((k) => <button type="button" class="kk b ck" data-v={k.i} style={`left:${k.left.toFixed(3)}%;width:${PBW.toFixed(3)}%`} aria-pressed="false" aria-label={`${ROOTS[k.i]}（キー ${ROOT_KEYS[k.i]}）`}><b>{ROOTS[k.i]}</b><i class="ck-s"></i><span class="ky">{ROOT_KEYS[k.i]}</span></button>)}
            </div></div>
          </div>
        </div>
        <div class="ptab chd-r">
          <div class="prow chr wide" id="p-cq">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-cq">種類</span><p class="desc tip" id="t-cq" role="tooltip" hidden>コードの種類。押すと、そのコードを押さえる。右の数字はキーボードのキー。今の根音のままで次によく続く種類は色が付く</p></div>
            <div class="c-sub"><div class="chips cq" role="group" aria-labelledby="n-cq" aria-describedby="t-cq">
              {QUALITIES.map((q, i) => <button type="button" class="chip" data-v={q.v} aria-pressed="false" aria-label={`${q.l}（キー ${CHORD_KEYS[i]}）`}>{q.l}<span class="ky">{CHORD_KEYS[i]}</span></button>)}
            </div></div>
          </div>
          <div class="prow chr wide" id="p-cnx">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-cnx">次によく続くコード</span><p class="desc tip" id="t-cnx" role="tooltip" hidden>今のコードの次によく使うコード（和声の教本とポピュラー音楽によくある進行の目安）。色が濃いほどよく続く。押すか、右に書いたキー（下段の Z〜,）で、そのコードを押さえる</p></div>
            <div class="c-sub"><div class="chips cnx" id="cnx" role="group" aria-labelledby="n-cnx" aria-describedby="t-cnx"><span class="cnx-e">コードを押さえると出ます</span></div></div>
          </div>
          <div class="prow chr segr" id="p-cv">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-cv">押さえ方</span><p class="desc tip" id="t-cv" role="tooltip" hidden>調弦とフレットの数から自動で求めた押さえ方（6 弦から。x は鳴らさない弦）。左右のボタンか ↑↓ キーで、指板の上の位置を変える</p></div>
            <div class="c-val"><div class="seg cv-seg" role="group" aria-labelledby="n-cv" aria-describedby="t-cv">
              <button type="button" id="cvPrev" title="低い位置の押さえ方（↓ キー）" aria-label="低い位置の押さえ方" disabled>◀</button>
              <span class="cv-shape hw" id="cv-shape" data-ph="(10)(12)(12)(11)(10)(10)">—</span>
              <button type="button" id="cvNext" title="高い位置の押さえ方（↑ キー）" aria-label="高い位置の押さえ方" disabled>▶</button>
            </div></div>
          </div>
        </div>
      </div>
      <div class="pbtns">
        <p class="pl-bar hw" id="chd-name" data-ph="F♯m7♭5  10 / 10" aria-live="polite"></p>
        <button type="button" class="tg" id="chdSnd" aria-pressed="false" title="押さえたときに、太い弦から順にかき鳴らす"><span class="led" id="chdLed" aria-hidden="true"></span>コードを鳴らす</button>
        <button type="button" class="tg" id="chdRel" title="左手を弦から離して、コードの形をやめる（すべて開放弦にする。Esc キー）" disabled>リリース</button>
      </div>
      <p class="aux chd-keys">この枠を開いている間は、ボタンに書いたキーでも選べます。↑↓ キーで押さえ方、Esc キーでリリース</p>
    </Collapsible>

    <div class="col c1">
      <Panel hid="hd-play" title="演奏" class="a-play">
        <TransportState slot="aux" />
        <div class="ptab">
          <div class="prow pick" id="p-piece">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><label class="pn" id="n-piece" for="piece">曲</label><p class="desc tip" id="t-piece" role="tooltip" hidden>著作権の切れた曲を、このツールでギター用に編曲したもの。運指（弦とフレット）は自動で決める</p></div>
            <div class="c-val sel"><select id="piece" autocomplete="off" aria-describedby="t-piece">{PIECES.map((p) => <option value={p.v} title={p.by}>{p.name}</option>)}</select></div>
          </div>
        </div>
        <Transport>
          <TransportButton id="relBtn" icon="up" label="リリース" title="鳴っている弦をすべて止める（演奏は続ける）" />
          <TransportButton id="muteBtn" icon="mute" label="消音" title="鳴っている弦をすべて止める（手のひらで弦に触れる。演奏と位置はそのまま）" />
        </Transport>
        <div class="ptab">
          <ParamRow d={TEMPO} />
          <ParamRow d={outVol(VOL0)} />
        </div>
        <p class="msg er snd-msg" id="snd-msg" aria-live="polite"></p>
      </Panel>

      <Panel hid="hd-pk" title="弾き方" class="a-pk">
        <div class="ptab">
          <ChoiceRow k="tool" name="弾くもの" sub="弦に触れる幅。指の腹は広く（高い倍音が弱い柔らかい音）、爪とピックは狭い（明るい音）" choices={PICKS.map((t) => [t.v, t.name, `触れる幅 ${t.w * 1000} mm`] as const)} value="finger" />
          <ParamRow d={POS} />
          <ParamRow d={SLANT} />
          <ParamRow d={AMP} />
          <ParamRow d={ANGLE} />
          <ChoiceRow k="vib" name="曲のビブラート" sub="曲の演奏で、押さえた旋律の長い音の高さを揺らす。開放弦には掛からない。弦を押したまま動かせば、手で揺らすこともできる" choices={[['0', 'なし'], ['1', 'あり']]} value="1" />
          <ParamRow d={VIB_W} />
          <ParamRow d={VIB_HZ} />
          <ChoiceRow k="nz" name="フレットノイズ" sub="押さえる位置を変えたときに、指が巻弦の上をすべる音（キュッという音）の大きさ。巻弦の巻線を 1 本越えるたびに小さな音が出る" choices={NOISE} value="1" />
        </div>
      </Panel>

      <Panel hid="hd-str" title="弦" class="a-str">
        <div slot="aux" class="seg" id="p-set" role="group" aria-label="弦のセット" data-nosave>
          {SETS.map((s, i) => <button type="button" data-v={s.v} aria-pressed={i === 0 ? 'true' : 'false'} title={s.name}>{s.v === 'nylon' ? 'ナイロン' : 'スチール'}</button>)}
        </div>
        <div class="ptab">
          <ChoiceRow k="tun" name="調弦" sub="開放弦の音（6 弦から）。演奏する曲によっては自動で変える" choices={TUNINGS.map((t) => [t.v, t.name, tunName(t.notes)] as const)} value="std" layout="chips" />
          <ChoiceRow k="tm" name="張力の決め方" sub="調弦に合わせるなら、材質と太さから音程が合う張力を求める。手で決めるなら、張力に応じて音程がずれる" choices={[['auto', '調弦に合わせる'], ['man', '手で決める']]} value="auto" />
          <ChoiceRow k="sel" name="設定する弦" sub="材質・外径・張力を変える弦" choices={[0, 1, 2, 3, 4, 5].map((i) => [i, `${i + 1} 弦`] as const)} value={0} layout="chips" />
          <ChoiceRow k="mat" name="材質" sub="プレーン弦（ナイロン・スチール）と、芯線に金属の線を巻いた巻弦。巻弦は重くて柔らかく、低い弦に使う" choices={MATERIALS.map((m) => [m.v, m.name] as const)} value="nylon" layout="chips" />
          <ParamRow d={DIA} />
          <ParamRow d={TEN} />
        </div>
        <More id="g-str"><div class="ptab"><ParamRow d={SCALE} /></div></More>
        <div class="stw">
          <table class="stab" id="stab">
            <thead><tr><th scope="col">弦</th><th scope="col">開放</th><th scope="col">材質</th><th scope="col">外径</th><th scope="col">張力</th><th scope="col"><i>f</i><sub>1</sub></th><th scope="col">ずれ</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </Panel>
    </div>

    <div class="col c2">
      <Panel hid="hd-body" title="胴" class="a-body">
        <div slot="aux" class="seg" id="p-body" role="group" aria-label="胴の形" data-nosave>
          {BODY_TYPES.map((b, i) => <button type="button" data-v={b.v} aria-pressed={i === 0 ? 'true' : 'false'} title={`表板の面積 ${b.area * 1e4} cm²、駒 ${b.mb * 1000} g`}>{b.name}</button>)}
        </div>
        <div class="ptab">
          <ChoiceRow k="wood" name="表板の木材" sub="スプルースは硬く軽い（明るく反応の速い音）、シダーはさらに軽く柔らかい" choices={WOODS.map((w) => [w.v, w.name, `密度 ${w.rho} kg/m³、ヤング率 ${w.EL / 1e9}・${w.ER / 1e9} GPa（木目の方向・直交方向）`] as const)} value="spruce" />
          <ParamRow d={THICK} />
          <ParamRow d={VOLUME} />
          <ParamRow d={HOLE} />
        </div>
        <dl class="metrics bmet">
          <div class="m"><dt>第 1 共振 <i>f</i><sub>−</sub></dt><dd id="b-fm"></dd></div>
          <div class="m"><dt>ヘルムホルツ <i>f</i><sub>h</sub></dt><dd id="b-fh"></dd></div>
          <div class="m"><dt>第 2 共振 <i>f</i><sub>+</sub></dt><dd id="b-fp"></dd></div>
          <div class="m"><dt>表板だけ <i>f</i><sub>p0</sub></dt><dd id="b-f0"></dd></div>
          <div class="m"><dt>表板の等価質量 <i>m</i><sub>p</sub></dt><dd id="b-mp"></dd></div>
          <div class="m"><dt>高いモードの間隔 Δ<i>f</i></dt><dd id="b-df"></dd></div>
        </dl>
        <div class="sbar bsbar">
          <span class="stag"><i class="sw" aria-hidden="true"></i>CH1 駒のアドミタンス <b>10 dB</b>/div</span>
          <span class="stag"><i class="sw c2" aria-hidden="true"></i>CH2 音圧 ÷ 力 <b>10 dB</b>/div</span>
          <span class="stag">X LOG <b>50 Hz – 5 kHz</b></span>
        </div>
        <div class="scope">
          <svg viewBox="-46 -16 492 282" id="b-svg" role="img" aria-label="胴の応答">
            <defs><clipPath id="b-clip"><rect x="0" y="-2" width="400" height="244"/></clipPath></defs>
            <g set:html={bodyGrid()} />
            <g id="b-mk"></g>
            <g clip-path="url(#b-clip)"><path class="t2" id="b-t2"/><path class="t1" id="b-t1"/></g>
            <g id="b-pt"></g>
            <path class="cur" id="b-cur"/>
            <g id="b-axes"></g>
          </svg>
        </div>
        <div class="sbar rdbar" data-ph="f 1.234 kHz   CH1 −37.7 dB   CH2 −16.5 dB"><span class="rd" id="b-rd"></span></div>
      </Panel>

      <Panel hid="hd-room" title="残響" class="a-room">
        <div class="ptab">
          <ChoiceRow k="room" name="部屋" sub="響きを付ける部屋。寸法と吸音率から残響時間を求める（再生の音だけに付け、音の波形と計算結果には含めない）" choices={ROOMS.map((r) => [r.v, r.name, r.v === 'off' ? '残響なし' : `${r.dim.join(' × ')} m、平均吸音率 ${r.a}`] as const)} value="small" layout="chips" wide />
          <ParamRow d={DIST} />
        </div>
        <dl class="metrics rmet">
          <div class="m"><dt>残響時間 <i>T</i><sub>60</sub>（500 Hz）</dt><dd id="r-t"></dd></div>
          <div class="m"><dt>残響時間 <i>T</i><sub>60</sub>（4 kHz）</dt><dd id="r-th"></dd></div>
          <div class="m"><dt>臨界距離 <i>r</i><sub>c</sub></dt><dd id="r-rc"></dd></div>
          <div class="m"><dt>残響音 ÷ 直接音</dt><dd id="r-dr"></dd></div>
        </dl>
      </Panel>

      <Collapsible hid="hd-wave" title="音の波形" class="a-wave">
        <div class="seg wv-sw" id="p-ov" role="group" aria-label="表示"><button type="button" data-v="yt" aria-pressed="true" title="1 m 先の音圧の時間変化">波形</button><button type="button" data-v="sp" aria-pressed="false" title="周波数ごとの大きさ（初めの 1.37 秒）">スペクトラム</button></div>
        <div id="v-yt">
          <div class="sbar">
            <span class="stag"><i class="sw" aria-hidden="true"></i>CH1 音圧 <b class="hw" id="w-vd" data-ph="0.005 Pa"></b>/div</span>
            <span class="stag">H <b class="hw" id="w-hd" data-ph="500 ms"></b>/div</span>
            <span class="stag hw wst" id="w-st" data-ph="PEAK 999 mPa"></span>
          </div>
          <div class="scope">
            <svg viewBox="-50 -14 462 194" id="w-svg" role="img" aria-label="音の波形">
              <defs><clipPath id="w-clip"><rect x="0" y="0" width="400" height="160"/></clipPath></defs>
              <g set:html={gridSvg(4)} />
              <g clip-path="url(#w-clip)"><path class="t1" id="w-t1"/></g>
              <path class="cur" id="w-cur"/>
              <g id="w-axes"></g>
            </svg>
          </div>
          <div class="sbar rdbar" data-ph="t 12.34 ms   CH1 −1.234 Pa"><span class="rd" id="w-rd"></span></div>
          <More id="g-yt" title="表示の設定"><div class="ptab"><ChoiceRow k="span" name="表示する長さ" sub="弾いてからの時間" choices={SPANS.map((v) => [v, v < 1 ? `${v * 1000} ms` : `${v} s`] as const)} value={0.2} /></div></More>
        </div>
        <div id="v-sp" hidden>
          <div class="sbar">
            <span class="stag"><i class="sw" aria-hidden="true"></i>CH1 音圧 <b>30 dB</b>/div</span>
            <span class="stag">X <b id="s-x"></b></span>
            <span class="stag">WIN <b>B-HARRIS</b></span>
          </div>
          <div class="scope">
            <svg viewBox="-56 -14 468 194" id="s-svg" role="img" aria-label="音のスペクトラム">
              <defs><clipPath id="s-clip"><rect x="0" y="0" width="400" height="160"/></clipPath></defs>
              <g set:html={gridSvg(4)} />
              <g clip-path="url(#s-clip)"><path class="t1 sp" id="s-t1"/></g>
              <path class="cur" id="s-cur"/>
              <g id="s-axes"></g>
            </svg>
          </div>
          <div class="sbar rdbar" data-ph="f 1.234 kHz（12.34 倍）   CH1 −123.4 dB"><span class="rd" id="s-rd"></span></div>
