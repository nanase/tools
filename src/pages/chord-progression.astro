---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { outVol } from '../lib/play';
import { ROOMS } from '../lib/reverb';
import '../tools/chord-progression/style.css';
import How from '../tools/chord-progression/How.astro';
import { ICON } from '../tools/chord-progression/icons';
import { BPM, CLICK, VOL0 } from '../tools/chord-progression/params';
import { SAMPLES } from '../tools/chord-progression/samples';
import { STYLE_NAMES, STYLE_ORDER } from '../tools/chord-progression/song';
import Theory from '../tools/chord-progression/Theory.astro';

const name = 'コード進行';
const samples = SAMPLES;
const rooms = ROOMS.map((r) => [r.v, r.name] as [string, string]);
const styles = STYLE_ORDER.map((s) => [s, STYLE_NAMES[s]] as [string, string]);
---
<SiteLayout title={name} tool={{ id: 'chord-progression', name }}>
  <PageTitle title={name}>和音の地図を歩いて進行を作り、バンドで鳴らします。</PageTitle>

  <div class="tgrid" id="cp-page">
    <Panel hid="hd-map" title="和音の地図" class="cp-mapp" fixed>
      <span slot="aux" class="aux cp-posw"><b id="cp-pos">–</b></span>
      <div class="cp-mapw" id="cp-mapw">
        {/* 地図と小窓は操作で中身ごと描き直す */}
        <div class="cp-mapsc" id="cp-mapsc"><canvas id="cp-map" class="cp-map" role="img" aria-label="和音の地図。三角形 1 つが 1 つの和音で、隣どうしは 2 音を共有する" data-shift="ok"></canvas></div>
        <div class="cp-rcw" id="cp-rcw"><canvas id="cp-rc" class="cp-rc" role="img" aria-label="緊張の高さのレールと和音の駅。高いほど戻りたく、落ちる所が解決。駅を押すと選び、横へドラッグすると並べ替え" data-shift="ok"></canvas></div>
        <div class="cp-tools" role="group" aria-label="演奏">
          <button type="button" class="tp-ib" id="cp-prev" title="前の小節へ" aria-label="前の小節へ"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="1.8" height="9"/><path d="M10.5 1.5v9L4 6z"/></svg></button>
          <button type="button" class="tp-pp" id="cp-pp" title="選んだ和音から演奏" aria-label="演奏"><svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.2l7.6 4.8L3 10.8z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9"/><rect x="7.2" y="1.5" width="2.8" height="9"/></svg></button>
          <button type="button" class="tp-ib" id="cp-next" title="次の小節へ" aria-label="次の小節へ"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 1.5v9L8 6z"/><rect x="8.7" y="1.5" width="1.8" height="9"/></svg></button>
          <i class="cp-sep" aria-hidden="true"></i>
          <button type="button" class="cp-pi" id="cp-undo" title="元に戻す（Ctrl+Z）" aria-label="元に戻す"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.5L2.5 6.5L5.5 9.5"/><path d="M2.5 6.5H10a3.5 3.5 0 0 1 0 7H7"/></svg></button>
          <button type="button" class="cp-pi" id="cp-redo" title="やり直し（Ctrl+Y）" aria-label="やり直し"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 3.5L13.5 6.5L10.5 9.5"/><path d="M13.5 6.5H6a3.5 3.5 0 0 0 0 7h3"/></svg></button>
        </div>
        <div class="cp-meta">
          <button type="button" class="cp-keyb cp-songb" id="cp-songb" aria-expanded="false" aria-controls="cp-songpop" title="曲の選択と保存"><span id="cp-songn">カノン進行</span><svg viewBox="0 0 10 7" aria-hidden="true"><path d="M0 0H10L5 7z"/></svg></button>
          <button type="button" class="cp-keyb" id="cp-key" aria-expanded="false" aria-controls="cp-keypop" title="曲の調">C メジャー</button>
        </div>
        <div class="cp-keypop" id="cp-keypop" hidden></div>
        <div class="cp-keypop cp-songpop" id="cp-songpop" role="dialog" aria-label="曲の選択と保存" hidden>
          <div class="cp-er2"><span class="cp-rl">サンプル</span>
            <div class="chips" id="cp-samples">{samples.map((s) => <button type="button" class="chip" data-s={s.id}>{s.name}</button>)}</div>
          </div>
          <div class="cp-er2"><span class="cp-rl">保存した進行</span><ul class="cp-saved" id="cp-saved"></ul></div>
          <div class="cp-row cp-file">
            <input type="text" id="cp-name" maxlength="60" placeholder="進行の名前" aria-label="進行の名前" />
            <button type="button" class="cp-pi" id="cp-save" title="保存" aria-label="保存" set:html={ICON.save} />
            <button type="button" class="cp-pi" id="cp-new" title="新規" aria-label="新規" set:html={ICON.new} />
            <button type="button" class="cp-pi" id="cp-export" title="書き出し" aria-label="書き出し" set:html={ICON.export} />
            <button type="button" class="cp-pi" id="cp-import" title="読み込み" aria-label="読み込み" set:html={ICON.import} />
            <input type="file" id="cp-file" accept="application/json,.json" hidden />
          </div>
          <p class="cp-msg" id="cp-msg" role="status" aria-live="polite"></p>
        </div>
      </div>
      <div class="cp-lg static">
        <span class="cp-fT"><i class="cp-sw"></i>トニック</span><span class="cp-fS"><i class="cp-sw"></i>サブドミナント</span><span class="cp-fD"><i class="cp-sw"></i>ドミナント</span>
        <span><svg class="cp-road" viewBox="0 0 26 10" aria-hidden="true"><path d="M1 5H17"/><path class="h" d="M25 5L15 0.5V9.5z"/></svg>コード進行</span><span><i class="cp-cand"></i>行きやすい和音（太いほど定番）</span>
      </div>
    </Panel>

    <Panel hid="hd-band" title="バンド">
      <span slot="aux" class="aux tp-st" id="cp-st"><span class="led" id="cp-led" aria-hidden="true"></span><span id="cp-stT">待機中</span></span>
      <div class="cp-band" id="cp-band" role="group" aria-label="メンバー（押すとミュート）"></div>
      <div class="ptab">
        <ChoiceRow k="style" name="スタイル" layout="chips" choices={styles} value="pop" />
        <ChoiceRow k="meter" name="拍子" choices={[['4', '4/4'], ['3', '3/4']]} value="4" />
        <ParamRow d={BPM} />
        <ParamRow d={outVol(VOL0)} />
        <ParamRow d={CLICK} />
        <ChoiceRow k="room" name="残響" layout="chips" choices={rooms} value="off" />
      </div>
      <div class="cp-row"><button type="button" class="tg" id="cp-loop" aria-pressed="true"><span class="led on" aria-hidden="true"></span>くり返し</button><button type="button" class="tg" id="cp-met" aria-pressed="false"><span class="led" aria-hidden="true"></span>メトロノーム</button></div>
    </Panel>

    <Panel hid="hd-how" title="しくみ">
      <How />
    </Panel>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="chord-progression" />
  <script>
    import '../tools/chord-progression/client';
  </script>
</SiteLayout>
