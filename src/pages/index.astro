---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PageList } from '@/page';
---

<BaseLayout title="Tools + Simulators" description="Web上で各種計算＋シミュレーションができるツール群です">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="mb-8 text-3xl font-bold">Tools + Simulators</h1>
    <p class="mb-12 text-[var(--color-on-background)]">
      Web上で各種計算＋シミュレーションができるツール群です
    </p>

    {
      PageList.map((section) => (
        <section class="mb-10">
          <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-[var(--color-on-background)] opacity-60">
            {section.name}
          </h2>
          <ul class="m-0 list-none space-y-3 p-0">
            {section.pages.map((page) => (
              <li>
                <a
                  href={page.path ?? `/tools/${page.id}`}
                  class="block rounded-lg border border-[var(--color-surface)] p-4 no-underline transition-colors hover:bg-[var(--color-surface)]"
                >
                  <div class="flex items-center gap-3">
                    {page.icon && <span class={`mdi ${page.icon} text-2xl text-[var(--color-primary)]`} />}
                    <div>
                      <div class="font-semibold text-[var(--color-on-background)]">{page.title}</div>
                      {page.description && (
                        <div class="mt-1 text-sm text-[var(--color-on-background)] opacity-70">{page.description}</div>
                      )}
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <footer class="mt-16 border-t border-[var(--color-surface)] pt-6 text-center text-sm opacity-60">
      <a href="https://github.com/nanase/tools/" class="inline-flex items-center gap-2 no-underline">
        <span class="mdi mdi-github text-lg"></span>
        GitHub
      </a>
    </footer>
  </main>
</BaseLayout>
