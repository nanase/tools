---
import ToolCard from '../components/ToolCard.astro';
import { CATS, order, TOOLS } from '../data/tools';
import SiteLayout from '../layouts/SiteLayout.astro';

const shelves = CATS.map((c) => [c, order(TOOLS.filter((t) => t.c === c))] as const);
---
<SiteLayout description="電子回路やフィルタの計算と楽器・光学・天文のシミュレーションができるツール集">
  <h1 class="sr">Tools + Simulators</h1>

  <div class="filter">
    <label class="qf">
      <svg class="ic-s" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
      <span class="sr">ツールを絞り込み</span>
      <input id="q" type="search" placeholder="例: 555、抵抗、JJY" autocomplete="off" spellcheck="false" enterkeyhint="search" title="/ キーでここへ移動">
      <span class="count" id="count" aria-live="polite">{TOOLS.length} / {TOOLS.length}</span>
    </label>
    <div class="views" id="views" role="group" aria-label="表示">
      <button type="button" data-v="list" aria-pressed="true" aria-label="一覧" title="一覧">
        <svg class="ic-s" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="4.5" width="7.5" height="5" rx="1"/><rect x="2.5" y="14.5" width="7.5" height="5" rx="1"/><path d="M13.5 7h8M13.5 17h8"/></svg>
      </button>
      <button type="button" data-v="card" aria-pressed="false" aria-label="カード" title="カード">
        <svg class="ic-s" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"/></svg>
      </button>
    </div>
  </div>
  <div id="shelves" data-view="list">
    {/* 保存した表示（scripts/home.ts）を描く前に戻す */}
    <script is:inline>try{if(JSON.parse(localStorage.getItem('settings:'+location.pathname)||'{}')['c:view']==='card'){document.currentScript.parentElement.dataset.view='card';document.querySelectorAll('#views [data-v]').forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.v==='card'))})}}catch(e){}</script>
    {shelves.map(([c, L]) => (
      <section aria-label={c} data-c={c}>
        <h2 class="shelf-h">{c}<span class="n">{L.length}</span></h2>
        <div class="units">{L.map((t) => <ToolCard t={t} filterable />)}</div>
      </section>
    ))}
    <p class="empty" hidden>該当するツールはありません。</p>
  </div>
  {/* 一覧で行にマウスを乗せたとき、その行のカードを浮かべる（中身は scripts/home.ts が複製する） */}
  <div class="peek" id="peek" aria-hidden="true" hidden></div>
  <script>
    import '../scripts/home';
  </script>
</SiteLayout>
