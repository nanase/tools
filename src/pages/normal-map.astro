---
import Busy from '../components/Busy.astro';
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import FsButton from '../components/FsButton.astro';
import HowSteps from '../components/HowSteps.astro';
import LedToggle from '../components/LedToggle.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../tools/normal-map/style.css';
import { PATS } from '../tools/normal-map/heights';
import { EL, HS } from '../tools/normal-map/params';
import { STEPS } from '../tools/normal-map/steps';
import Theory from '../tools/normal-map/Theory.astro';

const name = '法線マップ';
const pats = PATS.map(([k, n]) => [k, n] as const);
---
<SiteLayout title={name} tool={{ id: 'normal-map', name }}>
  <PageTitle title={name}>平らな板に、光で動く凹凸の陰影を付けます。形そのものの凹凸と並べて見比べることもできます。</PageTitle>

  <div class="tgrid">
    <Panel hid="hd-fig" title="板" class="a-fig" fixed>
      <div slot="aux" class="nm-aux">
        <div class="seg" id="nm-mode" role="group" aria-label="表示">
          <button type="button" data-v="one" aria-pressed="true">単独</button><button type="button" data-v="cmp" aria-pressed="false">比較</button>
        </div>
        <LedToggle id="nm-rot" label="光を回す" on />
      </div>
      <div class="nm-fig" id="nm-fig">
        <div id="nm-one">
          <div class="nm-view nm-wide"><canvas id="nm-c0" tabindex="0" role="img" aria-label="法線マップを貼った板。触れた所へ光が動く（矢印キーでも）。ホイールで拡大、右ボタンのドラッグで回す"></canvas></div>
        </div>
        <div class="nm-two" id="nm-two" hidden>
          <figure>
            <div class="nm-view"><canvas id="nm-c1" tabindex="0" role="img" aria-label="形そのものの凹凸。触れた所へ光が動く。ホイールで拡大、右ボタンのドラッグで回す"></canvas><span class="nm-tag">本物の凹凸</span></div>
            <figcaption class="nm-cap static"><span>三角形 約 52 万</span><span>影あり</span></figcaption>
          </figure>
          <figure>
            <div class="nm-view"><canvas id="nm-c2" tabindex="0" role="img" aria-label="法線マップを貼った平らな板。触れた所へ光が動く。ホイールで拡大、右ボタンのドラッグで回す"></canvas><span class="nm-tag">法線マップ</span></div>
            <figcaption class="nm-cap static"><span>三角形 2・画像 1 枚</span><span>影なし</span></figcaption>
          </figure>
        </div>
        <button type="button" class="nm-home" id="nm-home" aria-label="視点を戻す" title="視点を戻す"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 9.5L10 3.5l7 6M5.5 8v8.5h9V8"/></svg></button>
        <FsButton id="nm-fs" />
        <Busy id="nm-busy" text="準備中…" center />
        <p class="nm-msg" id="nm-msg" hidden>このブラウザでは WebGL2 が使えないため表示できません</p>
      </div>
    </Panel>

    <Panel hid="hd-set" title="設定" class="a-set">
      <div class="ptab">
        <ChoiceRow k="pat" name="模様" layout="chips" value="brick" choices={pats} />
        <div class="nm-imgrows" id="nm-imgrows" hidden>
          <div class="prow segr" id="p-img">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-img">画像</span><p class="desc tip" role="tooltip" hidden>手元の画像の明るさを高さにする。画像は端末の外へ送らない</p></div>
            <div class="c-val nm-open"><button type="button" class="nm-openb" id="nm-openb" aria-labelledby="n-img nm-openb">開く</button><span class="nm-imgname" id="nm-imgname">見本</span><input type="file" id="nm-file" accept="image/*" hidden></div>
          </div>
          <ChoiceRow k="inv" name="高い所" sub="画像のどちらを高くするか" value="light" choices={[['light', '明るい所'], ['dark', '暗い所']]} />
        </div>
        <ParamRow d={EL} />
        <ParamRow d={HS} />
        <ChoiceRow k="nm" name="法線マップ" sub="なしでは平らな板の向きのまま光を計算する" value="1" choices={[['0', 'なし'], ['1', 'あり']]} />
        <ChoiceRow k="col" name="色" sub="模様ごとの色の画像を重ねる。なしでは灰色" value="1" choices={[['0', 'なし'], ['1', 'あり']]} />
        <ChoiceRow k="rgh" name="つや" sub="場所ごとの粗さの画像を重ねる。なしではどこも同じつや" value="1" choices={[['0', 'なし'], ['1', 'あり']]} />
      </div>
    </Panel>

    <Panel hid="hd-how" title="しくみ" class="a-how">
      <HowSteps side id="nm-how" steps={STEPS.map((s) => ({ h: s.h, fig: `<canvas role="img" aria-label="${s.h}"></canvas>`, p: s.p }))} />
    </Panel>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="normal-map" />
  <script>
    import '../tools/normal-map/client';
  </script>
</SiteLayout>
