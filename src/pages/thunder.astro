---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import More from '../components/More.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { DIST, ENERGIES, GROUNDS, HILL, HILLS, LAPSE, STROKES, VOL, WAITS } from '../tools/thunder/params';
import '../tools/thunder/style.css';
import { SURROUNDS } from '../tools/thunder/surround';
import Theory from '../tools/thunder/Theory.astro';
import { TERRAINS } from '../tools/thunder/terrain';

const name = '雷鳴';
/* 同じカテゴリ（準備中を含む）の後ろに、ほかのカテゴリの公開中のツールを並べる */
---
<SiteLayout title={name} tool={{ id: 'thunder', name }} note="放電路は乱数で作った模型で、エネルギーと音になる割合は文献の値の 1 つです。大きさは同じ雷を 1 km 先で聞いたときとの差だけを出します。">
  <PageTitle title={name}>稲妻の放電路の衝撃波を再現し、雷鳴として試聴できます。</PageTitle>
  <div class="mini" data-mini="op" aria-hidden="true"><span>WAIT<b id="m-wait">—</b></span><span>DIST<b id="m-dist">—</b></span><span>LEN<b id="m-len">—</b></span></div>

  <div class="tgrid">
    <Panel hid="hd-fig" title="断面" class="a-fig" fixed>
      <span slot="aux" class="aux th-st" id="th-st"></span>
      <div class="sbar">
        <span class="stag"><i class="sw th-sw-t th-dk" aria-hidden="true"></i>音が届く早さ</span>
        <span class="stag"><i class="th-dot th-dk" aria-hidden="true"></i>聞き手</span>
        <span class="stag"><i class="sw th-sw-d th-dk" aria-hidden="true"></i>直接音</span>
        <span class="stag"><i class="sw th-sw-e th-dk" aria-hidden="true"></i>反射音</span>
        <span class="stag th-hint">地面をドラッグして聞き手を動かす</span>
      </div>
      <div class="th-cv th-dk"><canvas id="th-sec" class="th-sec" role="img" aria-label="横から見た放電路と聞き手"></canvas><div class="th-busy" aria-hidden="true"><i></i>計算しています</div></div>
      <h3 class="vh">音圧の波形<span>横軸は光ってからの時間</span></h3>
      <div class="th-cv th-tr"><canvas id="th-wave" role="img" aria-label="聞き手に届く音圧の波形"></canvas><canvas id="th-hist" role="img" aria-label="N 波の量: 50 ms ごとの、届く N 波の山の高さの和（直接音と反射音）"></canvas></div>
      <div class="tp">
        <div class="th-lead"><button type="button" class="tp-sq" id="th-seed" title="別の雷（放電路を作り直す）" aria-label="別の雷"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 1.5L4 9h4l-1.5 5.5L12 7H8z"/></svg></button></div>
        <button type="button" class="tp-ib" id="th-home" title="最初から（光る前へ戻す）" aria-label="最初から"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="1.8" height="9"/><path d="M10.5 1.5v9L4 6z"/></svg></button>
        <button type="button" class="tp-pp" id="th-pp" title="光らせる" aria-label="光らせる"><svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.2l7.6 4.8L3 10.8z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9"/><rect x="7.2" y="1.5" width="2.8" height="9"/></svg></button>
        <div class="tp-tl">
          <div class="tp-trk" id="th-trk" role="slider" tabindex="0" aria-label="光ってからの時間" aria-valuemin="0" aria-valuemax="1" aria-valuenow="0"><div class="tp-rail"></div><div class="th-wait" id="th-waitbar"></div><div class="tp-fill" id="th-fill"></div><div class="tp-th" id="th-th"></div></div>
          <div class="tp-tm"><span>光ってから <b id="th-tau">0.0</b> s</span><span id="th-end"></span></div>
        </div>
      </div>
      <p class="sr" id="th-live" aria-live="polite"></p>
    </Panel>

    <div class="col c1">
      <Panel hid="hd-src" title="雷と聞き手" class="a-src">
        <div class="ptab">
          <ParamRow d={DIST} />
          <ChoiceRow k="n" name="放電の回数" sub="1 回の雷で同じ放電路に電流が流れる回数。2 回目からは雲の中で分かれて先へ伸びる" choices={STROKES} value="4" />
          <ChoiceRow k="e" sym="<i>E</i>" name="放電路のエネルギー" sub="放電路 1 m あたりに出るエネルギー [J/m]。大きいほど N 波が長く、音が低い" choices={ENERGIES} value="1e6" />
        </div>
      </Panel>
      <Panel hid="hd-env" title="地面と周囲" class="a-env">
        <div class="ptab">
          <ChoiceRow k="gnd" name="地面の反射" sub="地面で返る音を足すか" choices={GROUNDS} value="1" />
          <ChoiceRow k="env" name="周囲の反響" sub="聞き手の近くの家・木・建物で散った音が遅れて重なる" choices={SURROUNDS} value="town" />
          <ChoiceRow k="ter" name="地形の反響" sub="数 km 先の丘・山・林で散って戻る音。高い音は途中で吸われ、低い音ほど長く残る" choices={TERRAINS} value="hills" />
          <ChoiceRow k="hill" name="後方の山" sub="聞き手の後方に崖を置き、そこで返る音（こだま）を足す" choices={HILLS} value="0" />
          {HILL.map((d) => <ParamRow d={d} />)}
        </div>
        <More id="g-env"><div class="ptab"><ParamRow d={LAPSE} /></div></More>
      </Panel>
    </div>

    <div class="col c2">
      <Panel hid="hd-snd" title="音" class="a-snd">
        <div class="ptab">
          <ChoiceRow k="wait" name="光ってから音まで" sub="待つ: 音が届くまで実際の時間だけ待つ。待たない: 最初の音の直前から鳴らす" choices={WAITS} value="1" />
          <ParamRow d={VOL} />
        </div>
      </Panel>
      <Panel hid="hd-out" title="計算結果" class="a-out">
        <dl class="metrics">
          <div class="m m-main"><dt>光ってから音まで</dt><dd><span id="o-wait">—</span><span class="m-sub hh" id="o-waits" data-ph="÷ 3 で 0.0 km（聞き手まで 0.00 km）"></span></dd></div>
          <div class="m"><dt>鳴り続ける時間</dt><dd><span id="o-len">—</span><span class="m-sub" id="o-lens"></span></dd></div>
          <div class="m"><dt>スペクトルの山</dt><dd><span id="o-pk">—</span><span class="m-sub" id="o-pks"></span></dd></div>
          <div class="m"><dt>大きさ</dt><dd><span id="o-db">—</span><span class="m-sub" id="o-dbs">1 km 先で聞いたときとの差</span></dd></div>
          <div class="m m-wide"><dt>雲の底の音が届く距離</dt><dd><span id="o-rng">—</span><span class="m-sub" id="o-rngs"></span></dd></div>
        </dl>
        <h3 class="vh th-sph">スペクトル<span>最大を 0 dB、横軸は Hz</span></h3>
        <div class="th-cv"><canvas id="th-spec" role="img" aria-label="聞き手に届く音のスペクトル"></canvas></div>
      </Panel>
    </div>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="thunder" />
  <script>
    import '../tools/thunder/client';
  </script>
</SiteLayout>
