---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import More from '../components/More.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { VOL } from '../tools/engine/params';
import '../tools/transmission/style.css';
import { SCENES, SPEC } from '../tools/transmission/model';
import Theory from '../tools/transmission/Theory.astro';

const name = '変速機';
const ONOFF = [
  ['1', 'オン'],
  ['0', 'オフ'],
] as const;
const VIEWS = [
  ['sec', '', '歯車とクラッチの展開図'],
  ['side', '', '右から見た遠心クラッチと歯車とチェーン'],
  ['drum', '', 'シフトドラムの溝とペダル'],
] as const;
const SPEEDS = [
  ['1', '実際の速さ'],
  ['0.25', '1/4'],
  ['0.05', '1/20'],
] as const;
const RATES = [
  ['0.2', '1/5'],
  ['0.05', '1/20'],
  ['0.01', '1/100'],
] as const;
const HOW = [
  ['遠心クラッチ', 'ドラムへ開くシュー 3 個', '接触 2,000 rpm・滑走 約 2,900 rpm'],
  ['ワンウェイクラッチ', 'ドラムからクランクへの向きだけ伝達', 'エンジンブレーキ・押しがけ・キック'],
  ['1 次減速', '19 歯 → 65 歯', '1 次減速比 3.421'],
  ['多板クラッチ', 'チェンジペダルと連動', '摩擦板 4 枚・クラッチ板 3 枚'],
  ['変速機', 'スライドする M2・C3 のドグで結合', '空転する歯車 M3・M4・C1・C2'],
  ['シフトドラム', '5 か所で止まる 2 本の溝', '停車中だけ 4 と N の間を回る'],
] as const;
const DOG = ['C3 → C1', 'C3 → C2', 'M2 → M3', 'M2 → M4'];
const playIcon =
  '<svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.2l7.6 4.8L3 10.8z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9"/><rect x="7.2" y="1.5" width="2.8" height="9"/></svg>';
---
<SiteLayout title={name} tool={{ id: 'transmission', name }}>
  <PageTitle title={name}>CT125 の遠心クラッチから後輪のスプロケットまでの動きを追います。歯数は Honda の部品表、仕組みは特許、クラッチの効き方は実車の録音に合わせました。</PageTitle>

  <div class="tgrid tm-g" id="tm">
    <Panel hid="hd-fig" title="駆動系" fixed>
      <div slot="aux" class="tm-aux">
        <button type="button" class="tg" id="tm-pause" aria-pressed="false" title="運転の一時停止（Space）"><span class="led" aria-hidden="true"></span>一時停止</button>
        <div class="seg" id="tm-slow" role="group" aria-label="回転の見え方の速さ">
          {SPEEDS.map(([v, t]) => <button type="button" data-v={v} aria-pressed={v === '1' ? 'true' : 'false'}>{t}</button>)}
        </div>
      </div>
      <div class="sbar lg tm-leg">
        <span class="stag" id="tm-leg-path"><i class="tm-sq pow" aria-hidden="true"></i>動力の伝達</span>
        <span class="stag"><i class="tm-sq spin" aria-hidden="true"></i>空転</span>
        <span class="stag"><i class="tm-sq stop" aria-hidden="true"></i>停止</span>
        <span class="stag"><i class="tm-hat" aria-hidden="true"></i>滑走</span>
        <span class="stag"><i class="tm-dash" aria-hidden="true"></i>ブッシュ</span>
        <span class="stag tm-src" id="tm-src"></span>
      </div>
      <div class="tm-tri">
        {VIEWS.map(([k, cap, label]) => (
          <div class:list={['tm-v', `tm-v-${k}`]}>
            <canvas data-cv={k} class:list={['tm-cv', `tm-h-${k}`]} role="img" aria-label={label}></canvas>
            {cap && <span class="tm-cap">{cap}</span>}
            <div class="tm-tip" hidden></div>
          </div>
        ))}
      </div>
      <More id="tm-view" title="表示の設定">
        <div class="ana2">
          <div class="ptab">
            <ChoiceRow k="v-path" name="伝達経路の色" choices={ONOFF} value="1" />
            <ChoiceRow k="v-flow" name="伝達経路の点線" choices={ONOFF} value="1" />
          </div>
          <div class="ptab">
            <ChoiceRow k="v-blur" name="モーションブラー" choices={ONOFF} value="1" />
            <ChoiceRow k="v-cut" name="遠心クラッチの拡大図" choices={ONOFF} value="1" />
          </div>
        </div>
      </More>
    </Panel>

    <Panel hid="hd-scn" title="場面" shut class="tm-scn">
      <p slot="aux" class="aux" id="tm-scnaux"></p>
      <ol class="tm-st" id="tm-list"></ol>
      <div class="tp tm-tp">
        <button type="button" class="tp-ib" id="tp-home" title="最初へ" aria-label="最初へ"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="1.8" height="9"/><path d="M10.5 1.5v9L4 6z"/></svg></button>
        <button type="button" class="tp-pp" id="tp-pp" title="再生" aria-label="再生" set:html={playIcon} />
        <div class="tp-tl">
          <div class="tp-trk" id="tp-trk" role="slider" tabindex="0" aria-label="再生位置" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="tp-rail"></div>
            <div class="tp-fill" id="tp-fill"></div>
            <svg class="tp-tk" id="tp-tk" viewBox="0 0 100 7" preserveAspectRatio="none" aria-hidden="true"><path class="mj" vector-effect="non-scaling-stroke"/></svg>
            <div class="tp-th" id="tp-th"></div>
          </div>
          <div class="tp-tm"><span>段階 <b id="tp-i">1</b> / <span id="tp-n">–</span></span><span id="tp-t"></span></div>
        </div>
        <div class="tp-side">
          <button type="button" class="tp-sq" id="tp-prev" title="前の段階" aria-label="前の段階"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12 3L6 8l6 5M4 3v10"/></svg></button>
          <button type="button" class="tp-sq" id="tp-next" title="次の段階" aria-label="次の段階"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3l6 5-6 5M12 3v10"/></svg></button>
        </div>
      </div>
      <div class="tm-scrow">
        <div class="seg" id="tm-scene" role="group" aria-label="場面">
        {Object.entries(SCENES).map(([k, v]) => <button type="button" data-v={k} aria-pressed={k === 'up' ? 'true' : 'false'}>{v.name}</button>)}
        </div>
        <div class="sbar tm-rate"><span>再生の速さ</span>
        <div class="seg" id="tm-rate" role="group" aria-label="再生の速さ">
          {RATES.map(([v, t]) => <button type="button" data-v={v} aria-pressed={v === '0.05' ? 'true' : 'false'}>{t}</button>)}
        </div>
        </div>
      </div>
    </Panel>

    <div class="tm-2">
      <div class="tm-col">
      <Panel hid="hd-run" title="運転">
        <div slot="aux" class="tm-aux">
          <button type="button" class="tg tm-flb" id="tm-flb" aria-pressed="false" title="操作盤を右下に浮かべる" aria-label="操作盤を右下に浮かべる"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="11" rx="1.5"/><rect class="tm-fi" x="8" y="8" width="5" height="4" rx=".6"/></svg></button>
          <button type="button" class="tg" id="tm-auto" aria-pressed="false"><span class="led" aria-hidden="true"></span>自動運転</button>
        </div>
        <div class="drv tm-drv">
          <div class="drv-g"><span class="drv-l">ギア</span><b id="o-gear" data-o="gear">N</b></div>
          <div class="drv-s">
            <button type="button" class="tg" data-ped="-1" title="シフトダウン（↓）" aria-label="シフトダウン">▼</button>
            <button type="button" class="tg" data-ped="1" title="シフトアップ（↑）" aria-label="シフトアップ">▲</button>
          </div>
          <div class="drv-v"><span class="drv-l">速度</span><b id="o-kmh" data-o="kmh">0.0</b><span class="u">km/h</span></div>
          <div class="drv-d"><span class="drv-l">エンジン</span><b id="o-rpm" data-o="rpm">0</b><span class="u">rpm</span></div>
        </div>
        <div class="thr-row">
          <div class="thr" data-pad="thr" tabindex="0" role="slider" aria-label="スロットル" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <span class="thr-f"></span>
            <span class="thr-l" aria-hidden="true"><b>0</b><b>25</b><b>50</b><b>75</b><b>100 %</b></span>
            <span class="thr-t">スロットル</span><span class="thr-v" aria-hidden="true"></span>
          </div>
          <button type="button" class="tg thr-lk" id="tm-lock" aria-pressed="false"><span class="led" aria-hidden="true"></span>固定</button>
        </div>
        <div class="thr brk" data-pad="brk" tabindex="0" role="slider" aria-label="ブレーキ" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span class="thr-f"></span><span class="thr-t">ブレーキ</span><span class="thr-v" aria-hidden="true"></span></div>
      </Panel>

      <Panel hid="hd-snd" title="音">
        <div slot="aux" class="seg"><button type="button" id="tm-snd" aria-pressed="false" title="エンジン音響モデルの音（回転数とスロットルに合わせる）"><span class="led" aria-hidden="true"></span><span id="tm-sndT">再生</span></button></div>
        <div class="ptab">
          <ChoiceRow k="muf" name="マフラー" choices={[['stock', '純正'], ['delta', '社外品']]} value="stock" />
          <ParamRow d={VOL} />
        </div>
        <p class="msg er snd-msg" id="tm-sndmsg" aria-live="polite"></p>
      </Panel>
      </div>

      <Panel hid="hd-gr" title="回転数">
        <div class="sbar static">
          <span class="stag"><i class="sw" aria-hidden="true"></i>クランク</span>
          <span class="stag"><i class="sw c2" aria-hidden="true"></i>ドラム</span>
          <span class="stag"><i class="sw tm-c3" aria-hidden="true"></i>メインシャフト × 3.42</span>
          <span class="stag"><i class="tm-sq tm-sl" aria-hidden="true"></i>滑走</span>
        </div>
        <div class="scope tm-scope"><canvas id="tm-graph" class="tm-cv tm-hg" role="img" aria-label="クランクとドラムとメインシャフトの回転数のグラフ"></canvas></div>
        <dl class="metrics tm-met">
          <div class="m"><dt>遠心クラッチ</dt><dd id="o-cf">—</dd></div>
          <div class="m"><dt>多板クラッチ</dt><dd id="o-mp">—</dd></div>
          <div class="m"><dt>ドラムの回転数</dt><dd id="o-drpm">—</dd></div>
          <div class="m"><dt>後輪の回転数</dt><dd id="o-wrpm">—</dd></div>
        </dl>
      </Panel>
    </div>

    <Panel hid="hd-how" title="しくみ">
      <div class="tm-how">
        {HOW.map(([h, a, b], i) => (
          <div class="tm-hw"><b>{i + 1}</b><div><h3>{h}</h3><p>{a}</p><p class="tm-sub">{b}</p></div></div>
        ))}
      </div>
      <table class="tm-tab">
        <thead><tr><th>ギア</th><th>メインシャフト</th><th>カウンターシャフト</th><th>変速比</th><th>ドグの結合</th></tr></thead>
        <tbody>
          {SPEC.pairs.map((p, i) => (
            <tr><td>{i + 1} 速</td><td>M{i + 1} {p.m}</td><td>C{i + 1} {p.c}</td><td>{(p.c / p.m).toFixed(3)}</td><td>{DOG[i]}</td></tr>
          ))}
        </tbody>
      </table>
    </Panel>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <div class="tm-fl" id="tm-fl" role="region" aria-label="操作盤" hidden>
    <div class="tm-fl-h"><button type="button" class="tg" id="tm-fl-snd" aria-pressed="false" title="エンジン音の再生"><span class="led" aria-hidden="true"></span>音</button><button type="button" class="tg" id="tm-fl-auto" aria-pressed="false"><span class="led" aria-hidden="true"></span>自動運転</button><button type="button" class="tg" id="tm-fl-pause" aria-pressed="false" title="運転の一時停止（Space）"><span class="led" aria-hidden="true"></span>一時停止</button><button type="button" class="tm-fl-x" id="tm-fl-x" title="閉じる" aria-label="操作盤を閉じる"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7"/></svg></button></div>
    <div class="drv tm-drv tm-fl-drv">
      <div class="drv-g"><span class="drv-l">ギア</span><b data-o="gear">N</b></div>
      <div class="drv-s">
        <button type="button" class="tg" data-ped="-1" title="シフトダウン（↓）" aria-label="シフトダウン">▼</button>
        <button type="button" class="tg" data-ped="1" title="シフトアップ（↑）" aria-label="シフトアップ">▲</button>
      </div>
      <div class="drv-v"><span class="drv-l">速度</span><b data-o="kmh">0.0</b><span class="u">km/h</span></div>
      <div class="drv-d"><span class="drv-l">エンジン</span><b data-o="rpm">0</b><span class="u">rpm</span></div>
    </div>
    <div class="tm-fl-pads">
      <div class="thr" data-pad="thr" tabindex="0" role="slider" aria-label="スロットル" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span class="thr-f"></span><span class="thr-t">スロットル</span><span class="thr-v" aria-hidden="true"></span></div>
      <button type="button" class="tg thr-lk" id="tm-fl-lock" aria-pressed="false"><span class="led" aria-hidden="true"></span>固定</button>
      <div class="thr brk" data-pad="brk" tabindex="0" role="slider" aria-label="ブレーキ" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span class="thr-f"></span><span class="thr-t">ブレーキ</span><span class="thr-v" aria-hidden="true"></span></div>
    </div>
  </div>

  <RelatedTools current="transmission" />
  <script>
    import '../tools/transmission/client';
  </script>
</SiteLayout>
