---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { bigO } from '../lib/big-o';
import '../tools/list-queue-stack/style.css';
import { DEFS, KEYS, rng, SHAPES, shapeAt } from '../tools/list-queue-stack/model';
import { SIZE, SPEED, VOL } from '../tools/list-queue-stack/params';
import Theory from '../tools/list-queue-stack/Theory.astro';

const name = 'リスト・キュー・スタック';
const RULE_IN = [
  ['left', '先頭'],
  ['right', '末尾'],
  ['sort', '小さい順'],
  ['rand', 'ランダム'],
];
const RULE_OUT = [
  ['left', '先頭'],
  ['right', '末尾'],
];
/** バーの選択肢の小さな絵 */
const shapeSvg = (k: (typeof SHAPES)[number][0]): string => {
  const r = rng(5),
    bars = Array.from({ length: 8 }, (_, i) => {
      const h = shapeAt(k, i / 7, r) * 11;
      return `<rect x="${(i * 3.2).toFixed(1)}" y="${(12 - h).toFixed(1)}" width="2.3" height="${h.toFixed(1)}"/>`;
    }).join('');
  return `<svg viewBox="0 0 26 12" aria-hidden="true">${bars}</svg>`;
};
const BARS = SHAPES.map(([k, t]) => ({ k, t, svg: shapeSvg(k) }));
const short = (s: string) => s.replace(/（.*）/, '');
---
<SiteLayout title={name} tool={{ id: 'list-queue-stack', name }}>
  <PageTitle title={name}>データ構造ごとの順序と計算量をバーの動きで比べます。</PageTitle>

  <div class="tgrid" id="ls" data-mode="one">
    <Panel hid="hd-fig" title="スタック" class="a-fig" fixed>
      <span slot="aux" class="aux tp-st" id="ls-st" hidden><span class="led" id="ls-led" aria-hidden="true"></span><span id="ls-stT"></span></span>
      <div slot="aux" class="seg" id="ls-mode" role="group" aria-label="表示">
        <button type="button" data-v="one" aria-pressed="true">単独</button>
        <button type="button" data-v="cmp" aria-pressed="false">比較</button>
        <button type="button" data-v="list" aria-pressed="false">一覧</button>
      </div>
      <div class="sbar lg ls-lg">
        <span class="ls-lgl">
          <span class="stag"><i class="sw" aria-hidden="true"></i>書き込み</span>
          <span class="stag"><i class="sw c2" aria-hidden="true"></i>読み取り</span>
          <span class="stag"><i class="ls-sw" aria-hidden="true"></i>待機中</span>
        </span>
        <span class="ls-end"><b id="ls-say"></b><button type="button" class="prst" id="ls-reset2" hidden>リセット</button></span>
      </div>
      <div class="scope ls-scr"><canvas id="ls-cv" role="img" aria-label="スタック"></canvas></div>
      <div class="tp">
        <button type="button" class="tp-ib" id="tp-home" title="最初へ" aria-label="最初へ"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="1.8" height="9"/><path d="M10.5 1.5v9L4 6z"/></svg></button>
        <button type="button" class="tp-pp" id="tp-pp" title="再生" aria-label="再生"><svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.2l7.6 4.8L3 10.8z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9"/><rect x="7.2" y="1.5" width="2.8" height="9"/></svg></button>
        <div class="tp-tl">
          <div class="tp-trk" id="tp-trk" role="slider" tabindex="0" aria-label="進み具合" aria-valuemin="0" aria-valuemax="1" aria-valuenow="0">
            <div class="tp-rail"></div>
            <div class="tp-fill" id="tp-fill"></div>
            <div class="tp-th" id="tp-th"></div>
          </div>
          <div class="tp-tm"><span><b id="tp-a">0</b> / <span id="tp-b">0</span> 手順</span><span id="tp-t"></span></div>
        </div>
        <div class="tp-side">
          <button type="button" class="tp-sq" id="tp-back" title="前の手順" aria-label="前の手順"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12 3L6 8l6 5M4 3v10"/></svg></button>
          <button type="button" class="tp-sq" id="tp-step" title="次の手順" aria-label="次の手順"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3l6 5-6 5M12 3v10"/></svg></button>
        </div>
      </div>
      <div class="ptab ls-row"><ParamRow d={SPEED} /></div>
    </Panel>

    <Panel hid="hd-mat" title="操作と計算量" class="a-mat">
      <span slot="aux" class="aux">n = 要素数　* 償却</span>
      <div class="ls-mx">
        <table class="ls-mt" id="ls-mx">
          <thead><tr><th></th>{KEYS.map(([k, t]) => <th scope="col"><button type="button" class="ls-mh" data-k={k} title="データ構造を比較">{t}</button></th>)}<th scope="col">取り出す順</th><th scope="col">1 要素のメモリ</th></tr></thead>
          <tbody>
            {DEFS.map((d) => (
              <tr>
                <th scope="row"><button type="button" class="ls-mr" data-a={d.id}>{d.name}</button></th>
                {KEYS.map(([k]) => {
                  const o = d.ops.find((x) => x.key === k);
                  return <td>{o ? <button type="button" class:list={['ls-c', { on: o.o === 'O(n)' }]} data-a={d.id} data-k={k} title={`${d.name}: ${o.label}`} set:html={bigO(o.o.replace('償却 ', '') + (o.amort ? '*' : ''))} /> : <span class="ls-no">–</span>}</td>;
                })}
                <td class="ls-tx">{short(d.order)}</td>
                <td class="ls-tx">{short(d.mem)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Panel>

    <Panel hid="hd-cmp" title="計算結果" class="a-cmp">
      <div class="ls-rw"><table class="ls-rt" id="ls-rt"></table></div>
    </Panel>

    <div class="col">
      <Panel hid="hd-str" title="データ構造" class="a-str">
        <span slot="aux" class="aux" id="ls-an"></span>
        <div id="ls-str">
          <div class="chips">
          {DEFS.map((d) => <button type="button" class="chip" data-v={d.id} aria-pressed={d.id === 'stack' ? 'true' : 'false'}>{d.name}</button>)}
        </div>
        </div>
      </Panel>
      <Panel hid="hd-data" title="データ" class="a-data">
        <button slot="aux" type="button" class="prst" id="ls-new">新しいデータ</button>
        <div class="ptab ls-row">
          <div class="prow chr wide">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-shape">バー</span></div>
            <div class="c-rst"></div>
            <div class="c-sub"><div class="chips" id="ls-shape" role="group" aria-labelledby="n-shape">
              {BARS.map(({ k, t, svg }) => <button type="button" class="chip" data-v={k} aria-pressed={k === 'ramp' ? 'true' : 'false'}><Fragment set:html={svg} />{t}</button>)}
            </div></div>
          </div>
          <ParamRow d={SIZE} />
          <ChoiceRow k="pat" name="実行順" choices={[['bulk', 'まとめて'], ['mix', '交互']]} value="bulk" />
          <div class="prow segr" id="ls-ri" data-nosave>
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn">追加する位置</span></div>
            <div class="c-val"><div class="seg" role="group" aria-label="追加する位置">{RULE_IN.map(([v, t]) => <button type="button" data-v={v} aria-pressed={v === 'sort' ? 'true' : 'false'}>{t}</button>)}</div><p class="c-off"></p></div>
            <div class="c-rst"></div>
          </div>
          <div class="prow segr" id="ls-ro" data-nosave>
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn">取り出す位置</span></div>
            <div class="c-val"><div class="seg" role="group" aria-label="取り出す位置">{RULE_OUT.map(([v, t]) => <button type="button" data-v={v} aria-pressed={v === 'left' ? 'true' : 'false'}>{t}</button>)}</div><p class="c-off"></p></div>
            <div class="c-rst"></div>
          </div>
        </div>
      </Panel>
    </div>
    <div class="col">
      <Panel hid="hd-ops" title="操作" class="a-ops">
        <button slot="aux" type="button" class="prst" id="ls-reset" hidden>リセット</button>
        <div class="ls-ow">
          <table class="ls-ot">
            <thead><tr><th scope="col">実行</th><th scope="col">計算量</th><th scope="col">n = 32</th></tr></thead>
            <tbody id="ls-ops"></tbody>
          </table>
        </div>
      </Panel>
      <Panel hid="hd-out" title="計算結果" class="a-out">
        <dl class="metrics ls-res">
          <div class="m m-main"><dt>読み書き</dt><dd><span id="o-t">0</span><span class="u">回</span></dd></div>
          <div class="m"><dt>読み取り</dt><dd id="o-r">0</dd></div>
          <div class="m"><dt>書き込み</dt><dd id="o-w">0</dd></div>
          <div class="m"><dt>現在の要素数</dt><dd id="o-l">0</dd></div>
          <div class="m"><dt>最大の要素数</dt><dd id="o-m">0</dd></div>
          <div class="m"><dt>平均の待ち回数</dt><dd id="o-a">–</dd></div>
          <div class="m"><dt>最長の待ち回数</dt><dd id="o-x">–</dd></div>
          <div class="m"><dt>追加順の維持率</dt><dd id="o-k">–</dd></div>
          {DEFS.map((d) => (
            <>
              <div class="m m-sub" data-for={d.id}><dt>取り出す順</dt><dd>{d.order}</dd></div>
              <div class="m m-sub" data-for={d.id}><dt>1 要素のメモリ</dt><dd>{d.mem}</dd></div>
              <div class="m m-sub m-w" data-for={d.id}><dt>利用例</dt><dd>{d.ex}</dd></div>
            </>
          ))}
        </dl>
      </Panel>
      <Panel hid="hd-snd" title="音" class="a-snd">
        <div slot="aux" class="seg"><button type="button" id="ls-snd" aria-pressed="true"><span class="led on" id="ls-sndL" aria-hidden="true"></span> <span id="ls-sndT">オン</span></button></div>
        <div class="ptab ls-row"><ParamRow d={VOL} /></div>
      </Panel>
    </div>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="list-queue-stack" />
  <script>
    import '../tools/list-queue-stack/client';
  </script>
</SiteLayout>
