---
import ToolLayout from '@/layouts/ToolLayout.astro';
import ThemeCheckerTool from '@/svg/ThemeCheckerTool.vue';
---

<ToolLayout
  title="SVG テーマスキーマチェッカー"
  description="ライトテーマとダークテーマによって、SVGの外観が意図したものになるかを確認できます。"
  pageId="svg/theme-checker"
>
  <ThemeCheckerTool client:only="vue" />

  <hr class="my-8 border-[var(--color-on-background)]/10" />
  <footer class="pb-8">
    <h4 class="mb-2 font-semibold">参考文献</h4>
    <ul>
      <li>
        <a href="https://zenn.dev/nanase_t/articles/7c14092b24424c" target="_blank">
          SVG テーマスキーマチェッカーの技術参考記事
        </a>
      </li>
    </ul>
  </footer>
</ToolLayout>
