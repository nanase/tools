---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import { TOOLS } from '../data/tools';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../tools/biquad/style.css';
import { gridSvg } from '../lib/scope';
import { hzMath } from '../tools/biquad/math';
import { L0, LENS, PARAMS, TYPES } from '../tools/biquad/params';
import { blockSvg, lvGrid } from '../tools/biquad/plot';
import Theory from '../tools/biquad/Theory.astro';

const name = '双2次フィルタ';
const row = (ks: string[]) => PARAMS.filter((d) => ks.includes(d.k));
const t0 = TYPES[0];
/* 同じカテゴリにほかのツールがないため、公開中のほかのツールを並べる */
const related = TOOLS.filter((t) => !t.s && t.id !== 'biquad');
---
<SiteLayout title={name} tool={{ id: 'biquad', name }} note="係数と特性は倍精度の数値計算による参考値です。" description="各種フィルタ特性に対応する双2次フィルタ（バイクアッドフィルタ）の係数を計算します。">
  <PageTitle title={name}>双2次フィルタ（バイクアッドフィルタ）の係数を、フィルタの種類・カットオフ周波数・Q・増幅量・サンプリング周波数から求めます。周波数特性とインパルス応答を描き、ホワイトノイズに掛けた音も聞けます。</PageTitle>
  <div class="mini" aria-hidden="true"><span id="mt"></span><span><i>f</i><sub>c</sub><b id="mfc"></b></span><span><i>Q</i><b id="mq2"></b></span><span><i>A</i>(<i>f</i><sub>c</sub>)<b id="ma"></b></span></div>

  <div class="tgrid">
    <div class="col c-a">
      <Panel hid="hd-in" title="入力" class="a-in">
        <div slot="aux" class="seg ptype" id="p-type" role="group" aria-label="フィルタの種類">
          {TYPES.map((t) => <button type="button" data-v={t.v} aria-pressed={t.v === t0.v ? 'true' : 'false'} title={t.t}>{t.ab}</button>)}
        </div>
        <div class="ptab">{row(['fc', 'q', 'g', 'fs']).map((d) => <ParamRow d={d} fold={d.k === 'g'} />)}</div>
      </Panel>

      <Panel hid="hd-snd" title="試聴" class="a-snd">
        <div slot="aux" class="seg"><button type="button" id="playBtn" aria-pressed="false" title="ホワイトノイズにこのフィルタを掛けて鳴らす"><span class="led" aria-hidden="true"></span><span id="playT">再生</span></button></div>
        <div class="sbar">
          <span class="stag">IN <b>WHITE NOISE</b></span>
          <span class="stag"><i class="sw" aria-hidden="true"></i>OUT <b id="lv-t">---</b> dBFS</span>
          <span class="stag">FS <b id="lv-fs">---</b></span>
        </div>
        <div class="scope lvl">
          <svg viewBox="-12 -4 424 42" role="img" aria-label="出力レベル">
            <g set:html={lvGrid()} />
            <rect class="dt1" id="lv-bar" x="0" y="5" width="0" height="12"/>
            <rect class="lv-hot" id="lv-hot" x="0" y="5" width="0" height="12"/>
          </svg>
        </div>
        <div class="ptab">{row(['vol']).map((d) => <ParamRow d={d} />)}</div>
      </Panel>
    </div>

    <div class="col c-b">
      <Panel hid="hd-fr" title="周波数特性" class="a-fr">
        <span slot="aux" class="aux" id="fr-aux"></span>
        <div class="sbar">
          <button type="button" class="tg" id="ch1f" aria-pressed="true" title="振幅"><i class="sw" aria-hidden="true"></i>CH1 MAG <b id="fr-vd"></b>/div</button>
          <button type="button" class="tg" id="ch2f" aria-pressed="true" title="位相"><i class="sw c2" aria-hidden="true"></i>CH2 PHASE <b>60°</b>/div</button>
          <span class="stag">X LOG <b id="fr-x"></b></span>
          <span class="stag rd" id="fr-rd"></span>
        </div>
        <div class="scope" id="fr-scope">
          <svg viewBox="-50 -16 494 282" id="fr-svg" role="img" aria-label="周波数特性">
            <defs><clipPath id="fr-clip"><rect x="0" y="0" width="400" height="240"/></clipPath></defs>
            <g id="fr-grid"></g>
            <path class="mkl" id="fr-fc"/>
            <g clip-path="url(#fr-clip)"><path class="t2 c2x" id="fr-t2"/><path class="t1 c1x" id="fr-t1"/></g>
            <path class="cur" id="fr-cur"/>
            <g id="fr-axes"></g>
          </svg>
        </div>
        <div class="ana2">{row(['n', 'bot']).map((d) => <div class="ptab"><ParamRow d={d} fold /></div>)}</div>
      </Panel>

      <Panel hid="hd-imp" title="インパルス応答" class="a-imp">
        <span slot="aux" class="aux">単位インパルス入力</span>
        <div class="sbar">
          <span class="stag"><i class="sw" aria-hidden="true"></i>CH1 <i>h</i>[<i>n</i>] <b id="im-vd"></b>/div</span>
          <span class="stag">H <b id="im-hd"></b> S/div</span>
          <span class="stag">TRIG <i>n</i> = 0</span>
          <span class="stag rd" id="im-rd"></span>
        </div>
        <div class="scope">
          <svg viewBox="-56 -16 468 282" id="im-svg" role="img" aria-label="インパルス応答">
            <defs><clipPath id="im-clip"><rect x="0" y="0" width="400" height="240"/></clipPath></defs>
            <g set:html={gridSvg()} />
            <g clip-path="url(#im-clip)"><path class="stz" id="im-z"/><path class="stm" id="im-st"/><g id="im-dots"></g></g>
            <path class="cur" id="im-cur"/>
            <g id="im-axes"></g>
          </svg>
        </div>
        <div class="ptab ana">
          <ChoiceRow k="len" sym="<i>L</i>" nm="L" name="表示長" sub="インパルス応答のグラフの 8 div に入れるサンプル数（解析長 N まで）" choices={LENS.map((v) => [v, String(v)] as const)} value={L0} layout="chips" wide msg />
        </div>
      </Panel>
    </div>

    <Panel hid="hd-out" title="計算結果" class="a-out">
      <div slot="aux" class="seg"><button type="button" id="precBtn">精密計算</button></div>
      <dl class="metrics">
        <div class="m m-main"><dt><i>f</i><sub>c</sub> での振幅 <i>A</i>(<i>f</i><sub>c</sub>)</dt><dd id="o-afc"></dd></div>
        <div class="m"><dt>最大振幅 max <i>A</i></dt><dd id="o-max"></dd></div>
        <div class="m"><dt>最大振幅の周波数</dt><dd id="o-maxf"></dd></div>
        <div class="m o2"><dt>インパルス応答の総和 Σ<i>h</i>[<i>n</i>]</dt><dd id="o-sum"></dd></div>
        <div class="m"><dt>最小振幅 min <i>A</i></dt><dd id="o-min"></dd></div>
        <div class="m"><dt>最小振幅の周波数</dt><dd id="o-minf"></dd></div>
        <div class="m o2"><dt>解析長 <i>N</i></dt><dd><span id="o-n"></span><span class="m-sub" id="o-df"></span></dd></div>
      </dl>
      <div class="ptab ana">{row(['np']).map((d) => <ParamRow d={d} fold />)}</div>
    </Panel>

    <Panel hid="hd-coef" title="ブロック図と係数" class="a-coef">
      <div slot="aux" class="seg" id="bview" role="group" aria-label="表示">
        <button type="button" data-v="blk" aria-pressed="true" title="直接形 I のブロック図（a0 = 1 に正規化した係数）">ブロック図</button><button type="button" data-v="coef" aria-pressed="false" title="伝達関数と 6 つの係数">係数</button>
      </div>
      <div id="v-blk">
        <p class="cap">直接形 I・<i>a</i><sub>0</sub> = 1</p>
        <svg class="sch" viewBox="0 0 360 216" role="img" aria-label="直接形 I の双2次フィルタのブロック図。入力 x[n] を 2 段の遅延に通し、b0・b1・b2 を掛けて加算器へ。出力 y[n] を 2 段の遅延に通し、−a1・−a2 を掛けて同じ加算器へ戻す。" set:html={blockSvg()} />
      </div>
      <div id="v-coef" hidden>
        <div class="cbar">
          <div class="seg" id="cmode" role="group" aria-label="係数の表し方">
            <button type="button" data-v="1" aria-pressed="true" title="a0 で割り、a0 = 1 にした係数">正規化</button><button type="button" data-v="0" aria-pressed="false" title="Cookbook の式そのままの係数">元の値</button>
          </div>
        </div>
        <div class="hz" id="hz" set:html={hzMath(true)} />
        <dl class="metrics coef">
          {['b0', 'b1', 'b2', 'a0', 'a1', 'a2'].map((c) => <div class="m"><dt><i>{c[0]}</i><sub>{c[1]}</sub></dt><dd id={`c-${c}`}></dd></div>)}
        </dl>
      </div>
    </Panel>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools list={related} />
  <div class="toast" id="toast" role="status" aria-live="polite" data-off></div>
  <script>
    import '../tools/biquad/client';
  </script>
</SiteLayout>
