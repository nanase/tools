---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../tools/i2c/style.css';
import { hex } from '../tools/i2c/bus';
import { HOW } from '../tools/i2c/how';
import { iconSvg } from '../tools/i2c/icons';
import { ADDR_OPT, MODE_OPT, OP_OPT, PARAMS, VDD_OPT } from '../tools/i2c/params';
import Theory from '../tools/i2c/Theory.astro';

const name = 'I2C';
const P = Object.fromEntries(PARAMS.map((d) => [d.k, d]));
const playIcon =
  '<svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.2l7.6 4.8L3 10.8z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9"/><rect x="7.2" y="1.5" width="2.8" height="9"/></svg>';
---
<SiteLayout title={name} tool={{ id: 'i2c', name }}>
  <PageTitle title={name}>2 本の線で機器がやり取りする I2C の信号を追います。</PageTitle>

  <div class="tgrid i2-grid" id="i2c">
    <div class="i2-main">
      <Panel hid="hd-bus" title="バス" fixed>
        <span slot="aux" class="aux tp-st"><span class="led" id="i2-led" aria-hidden="true"></span><span id="i2-st" aria-live="polite"></span></span>
        <div class="scope i2-scr"><canvas class="i2-cv i2-hB" id="i2-bus" role="img" aria-label="プルアップ抵抗と 2 本の線と機器の配線図"></canvas></div>
        <p class="i2-say" id="i2-say" aria-live="off"></p>
        <div class="tp">
          <button type="button" class="tp-ib" id="tp-home" title="最初へ" aria-label="最初へ"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="1.8" height="9"/><path d="M10.5 1.5v9L4 6z"/></svg></button>
          <button type="button" class="tp-pp on" id="tp-pp" title="一時停止" aria-label="一時停止" set:html={playIcon} />
          <div class="tp-tl">
            <div class="tp-trk" id="tp-trk" role="slider" tabindex="0" aria-label="再生位置" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <div class="tp-rail"></div>
              <div class="tp-fill" id="tp-fill"></div>
              <div class="tp-th" id="tp-th"></div>
            </div>
            <div class="tp-tm"><span><b id="tp-a">0</b> / <span id="tp-b">0</span> クロック</span><span id="tp-t"></span></div>
          </div>
          <div class="tp-side">
            <button type="button" class="tp-sq" id="tp-back" title="前のクロック" aria-label="前のクロック"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12 3L6 8l6 5M4 3v10"/></svg></button>
            <button type="button" class="tp-sq" id="tp-step" title="次のクロック" aria-label="次のクロック"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3l6 5-6 5M12 3v10"/></svg></button>
          </div>
        </div>
        <div class="ptab"><ParamRow d={P.rate} /></div>
      </Panel>

      <Panel hid="hd-wave" title="波形" fixed>
        <h3 class="i2-gh">全体</h3>
        <div class="scope i2-scr"><canvas class="i2-cv i2-hO" id="i2-whole" role="slider" tabindex="-1" aria-label="通信全体の波形と解読。押すとその位置へ"></canvas></div>
        <h3 class="i2-gh">拡大</h3>
        <div class="scope i2-scr"><canvas class="i2-cv i2-hZ" id="i2-zoom" role="img" aria-label="今の位置の前後の波形とビットの値"></canvas></div>
        <div class="sbar lg i2-lg">
          <span class="stag"><i class="sw" aria-hidden="true"></i>SCL クロック</span>
          <span class="stag"><i class="sw c2" aria-hidden="true"></i>SDA データ</span>
          <span class="stag"><i class="i2-sq i2-sq-m" aria-hidden="true"></i>マスタ</span>
          <span class="stag"><i class="i2-sq i2-sq-s" aria-hidden="true"></i>スレーブ</span>
          <span class="stag" id="i2-lg-m2" hidden><i class="i2-sq i2-sq-m2" aria-hidden="true"></i>マスタ 2</span>
        </div>
      </Panel>
    </div>

    <div class="i2-side">
      <Panel hid="hd-res" title="結果">
        <dl class="metrics i2-res">
          <div class="m m-wide i2-res0"><dt class="sr">結果</dt><dd id="o-res">–</dd></div>
          <div class="m"><dt>立ち上がり時間</dt><dd id="o-tr">–</dd></div>
          <div class="m"><dt>Low の電圧</dt><dd id="o-vol">–</dd></div>
          <div class="m"><dt>クロック</dt><dd id="o-clk">–</dd></div>
          <div class="m"><dt>所要時間</dt><dd id="o-dur">–</dd></div>
        </dl>
      </Panel>

      <Panel hid="hd-com" title="通信">
        <div class="ptab">
          <ChoiceRow k="op" name="操作" choices={OP_OPT} value="w" />
          <div class="prow chr wide" id="p-addr" data-nm="宛先">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-addr">宛先</span></div>
            <div class="c-rst"></div>
            <div class="c-sub"><div class="chips i2-addr" role="group" aria-labelledby="n-addr">
              {ADDR_OPT.map(([a, ic, t], i) => <button type="button" class="chip" data-v={String(a)} aria-pressed={i === 0 ? 'true' : 'false'} title={t}><Fragment set:html={iconSvg(ic)} /><span class="sr">{t} </span>{hex(a)}</button>)}
            </div></div>
          </div>
          <ParamRow d={P.d0} />
          <ParamRow d={P.d1} />
          <div class="prow chr wide">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-scene">場面</span></div>
            <div class="c-rst"></div>
            <div class="c-sub"><div class="i2-tgs" role="group" aria-labelledby="n-scene">
              <button type="button" class="tg" data-tg="stretch" aria-pressed="false" title="宛先のスレーブが SCL を Low のまま保持"><span class="led" aria-hidden="true"></span>クロックストレッチ</button>
              <button type="button" class="tg" data-tg="multi" aria-pressed="false" title="2 台のマスタが同時に送り始める"><span class="led" aria-hidden="true"></span>2 台目のマスタ</button>
            </div></div>
          </div>
        </div>
      </Panel>

      <Panel hid="hd-ele" title="電気">
        <div class="ptab">
          <ChoiceRow k="mode" name="速度" choices={MODE_OPT} value="sm" />
          <ChoiceRow k="vdd" name="電源電圧" choices={VDD_OPT} value="3.3" />
          <ParamRow d={P.rp} />
          <ParamRow d={P.cb} />
        </div>
      </Panel>
    </div>

    <Panel hid="hd-how" title="I2C のしくみ" class="i2-howp">
      <ol class="i2-how">
        {HOW.map(([h, fig, d], i) => (
          <li><h3><b>{i + 1}</b>{h}</h3><Fragment set:html={fig} /><p>{d}</p></li>
        ))}
      </ol>
    </Panel>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="i2c" />
  <script>
    import '../tools/i2c/client';
  </script>
</SiteLayout>
