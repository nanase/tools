---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import More from '../components/More.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import RowReset from '../components/RowReset.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../tools/temperament/style.css';
import { A4, PIANOS, VOL } from '../tools/temperament/params';
import Theory from '../tools/temperament/Theory.astro';
import { CHORDS, FIFTHS, INTERVALS, NAMES, TEMPERAMENTS, TIMBRES } from '../tools/temperament/tem';
import { KX, keyboard, LH, LW } from '../tools/temperament/view';

const name = '音律とうなり';
/* チューナー・オルガン・ピアノを先に、続けて同じカテゴリ（準備中を含む）、ほかのカテゴリの公開中のツール */
const KEYS = keyboard();
---
<SiteLayout title={name} tool={{ id: 'temperament', name }} note="音はこの端末の中で作り、送信しません。">
  <PageTitle title={name}>平均律・純正律・ミーントーン・ヴェルクマイスターなどの音律で和音を鳴らし、うなりの速さを数値と音で比べます。</PageTitle>

  <div class="tgrid">
    <Panel hid="hd-fig" title="部分音" class="a-fig" fixed>
      <div slot="aux" class="seg">
        <button type="button" id="playBtn" aria-pressed="false" title="和音を鳴らす・止める"><span class="led" id="playLed" aria-hidden="true"></span><span id="playT">鳴らす</span></button>
      </div>
      <div class="sbar">
        <span class="stag">A <b id="s-a">平均律</b></span>
        <span class="stag" id="s-bw">B <b id="s-b"></b></span>
        <span class="stag" id="s-ch">—</span>
        <span class="stag" id="s-tb">—</span>
        <span class="stag" id="s-rt">—</span>
        <span class="stag right ab" id="s-now" hidden>鳴っている音律 <b id="s-cur"></b></span>
      </div>
      <div class="lgd">
        <span><i class="tk" aria-hidden="true"></i>純正の位置</span>
        <span><i class="dt" aria-hidden="true"></i>部分音（ずれ ×{KX}）</span>
        <span><i class="sw" aria-hidden="true"></i>うなり [回/秒]</span>
        <span id="lg-e" hidden><i class="ring" aria-hidden="true"></i>2 次のうなり</span>
      </div>
      <div class="scope lad"><svg viewBox={`0 0 ${LW} ${LH}`} id="lad" role="img" aria-label="和音の部分音を純正な比の目盛りに並べた図"><g id="lad-g"></g></svg></div>
      <div class="zms" id="zms"></div>
      <div class="kbw"><div class="kb" id="kb" role="group" aria-label="鍵盤（押すと根音にする）">
        {KEYS.map((k) => (
          <button type="button" class={k.black ? 'b' : 'w'} data-m={k.m} style={`left:${k.left.toFixed(3)}%;width:${k.width.toFixed(3)}%`}><b>{k.black ? '' : k.m % 12 === 0 ? `C${k.m / 12 - 1}` : NAMES[k.m % 12]}</b><span class="dv"></span></button>
        ))}
      </div></div>
      <p class="lbl" id="k12-l">調ごとの長 3 度 [セント]</p>
      <div class="k12" id="k12" role="group" aria-label="調ごとの 3 度（押すとその調の主和音を鳴らす）">
        {FIFTHS.map((p) => (
          <button type="button" data-p={p} aria-pressed="false"><span class="bx" aria-hidden="true"><i></i></span><b>{NAMES[p]}</b><span class="v">—</span></button>
        ))}
      </div>
    </Panel>

    <div class="col c1">
      <Panel hid="hd-tem" title="音律" class="a-tem">
        <div slot="aux" class="seg">
          <button type="button" id="abBtn" aria-pressed="false" title="音律 A と比べる音律 B を 2 秒ごとに入れ替えて鳴らす"><span class="led" id="abLed" aria-hidden="true"></span><span>A・B 交互</span></button>
        </div>
        <div class="ttab">
          <span class="th">A</span><span class="th">B</span><span class="th">音律</span><span class="th num" id="tt-3">C–E</span><span class="th num" id="tt-5">C–G</span>
          <div class="tcol" id="p-tem" role="group" aria-label="音律 A">
            {TEMPERAMENTS.map((t, i) => <button type="button" class="rb" data-v={t.v} aria-pressed={t.v === 'et' ? 'true' : 'false'} aria-label={`音律 A を${t.name}にする`} style={`grid-row:${i + 2}`}><i></i></button>)}
          </div>
          <div class="tcol" id="p-cmp" role="group" aria-label="比べる音律 B">
            {[...TEMPERAMENTS, { v: 'none', name: '比べない' }].map((t, i) => <button type="button" class="rb b" data-v={t.v} aria-pressed={t.v === 'mt4' ? 'true' : 'false'} aria-label={t.v === 'none' ? '音律 B で比べない' : `比べる音律 B を${t.name}にする`} style={`grid-row:${i + 2}`}><i></i></button>)}
          </div>
          {TEMPERAMENTS.map((t, i) => (
            <>
              <span class="tn" style={`grid-row:${i + 2}`}>{t.name}</span>
              <span class="num v3" data-t={t.v} style={`grid-row:${i + 2}`}><span>—</span><i></i></span>
              <span class="num v5" data-t={t.v} style={`grid-row:${i + 2}`}><span>—</span><i></i></span>
            </>
          ))}
          <span class="tn none" style={`grid-row:${TEMPERAMENTS.length + 2}`}>比べない</span>
        </div>
        <More id="g-tem"><div class="ptab">
          <ChoiceRow k="ton" name="音律の主音" sub="音律の C を置く音" choices={NAMES.map((n, i) => [String(i), n] as const)} value="0" layout="chips" />
          <ParamRow d={A4} />
        </div></More>
      </Panel>

      <Panel hid="hd-chd" title="和音" class="a-chd">
        <div class="ptab">
          <div class="prow chr wide" id="p-chord" data-nm="和音・音程">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-chord">和音・音程</span><p class="desc tip" id="t-chord" role="tooltip" hidden>開いた長三和音 ＝ 根音・オクターブ・12 度・17 度（ピアノの調律で聴く形）</p></div>
            <RowReset label="和音・音程を既定値に戻す" />
            <div class="c-sub">
              <span class="cg" aria-hidden="true">和音</span>
              <div class="chips" role="group" aria-label="和音">{CHORDS.map((c) => <button type="button" class="chip" data-v={c.v} aria-pressed={c.v === 'maj' ? 'true' : 'false'}>{c.name}</button>)}</div>
              <span class="cg" aria-hidden="true">音程</span>
              <div class="chips" role="group" aria-label="音程">{INTERVALS.map((c) => <button type="button" class="chip" data-v={c.v} aria-pressed="false">{c.name}</button>)}</div>
            </div>
          </div>
        </div>
      </Panel>
    </div>

    <div class="col c2">
      <Panel hid="hd-out" title="うなり" class="a-out">
        <span slot="aux" class="aux" id="o-ab">平均律</span>
        <div class="prs" role="table" aria-label="音の組ごとのうなり">
          <div class="r hd" role="row"><span role="columnheader">音程</span><span role="columnheader">音</span><span class="hn" role="columnheader">一致する部分音</span><span role="columnheader">純正から</span><span role="columnheader">うなり</span><span role="columnheader" aria-label="うなりの灯り"></span></div>
          <div id="prs-b" role="rowgroup"></div>
        </div>
        <div class="envw">
          <div class="cap"><span>全体の音の揺れ</span><span>2 秒</span></div>
          <div class="scope env"><svg viewBox="0 0 300 64" role="img" aria-label="全体の音の波の山の高さ（2 秒）" id="env"><path class="g" d="M0 4H300M0 60H300M75 0V64M150 0V64M225 0V64" /><path class="e" id="env-p" d="" /><path class="now" id="env-now" d="M-10 0V64" /><text x="2" y="10" id="env-hi"></text><text x="2" y="58" id="env-lo"></text></svg></div>
        </div>
        <div class="nts" role="table" aria-label="和音の音">
          <div class="r hd" role="row"><span role="columnheader">音</span><span role="columnheader">周波数</span><span role="columnheader">平均律から [セント]</span><span role="columnheader">非調和性 B</span></div>
          <div id="nts-b" role="rowgroup"></div>
        </div>
      </Panel>

      <Panel hid="hd-snd" title="音" class="a-snd">
        <div class="ptab">
          <ChoiceRow k="tb" name="音色" sub="正弦波は部分音なし／ピアノは部分音が高めにずれる" choices={TIMBRES} value="organ" />
          <ChoiceRow k="pt" name="ピアノ" sub="弦の寸法はピアノ音響モデルと同じ" choices={PIANOS} value="concert" layout="chips" class="pno" />
          <ChoiceRow k="st" name="ストレッチ" sub="オクターブを部分音に合わせて広げる" choices={[['0', 'なし'], ['1', 'あり']]} value="0" class="pno" />
          <ParamRow d={VOL} />
        </div>
      </Panel>
    </div>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="temperament" />
  <script>
    import '../tools/temperament/client';
  </script>
</SiteLayout>
