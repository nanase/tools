---
import PageTitle from '../components/PageTitle.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/how.css';
import '../styles/chapters.css';
import '../tools/laplace/style.css';
import { chaptersHtml } from '../tools/laplace/chapters';

/* 章立てて解説するページ（z 変換と同じ形）。章の HTML はビルド時に作り、data-view（1 問ずつ・すべて）は lib/chapter-page.ts が切り替える */
const name = 'ラプラス変換';
const id = 'laplace';
---
<SiteLayout title={name} tool={{ id, name }}>
  <PageTitle title={name} noReset>s 平面の点を動かし、波・伝達関数・周波数特性とラプラス変換のつながりを 6 つの問いで確かめます。</PageTitle>
  <div class="chp lap" id="lap" data-view="one" set:html={chaptersHtml()} />
  <RelatedTools current={id} />
  <script>
    import '../tools/laplace/client';
  </script>
</SiteLayout>
