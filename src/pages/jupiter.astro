---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import More from '../components/More.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import PlanetSite from '../components/PlanetSite.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../lib/planet/planet.css';
import { SPEEDS } from '../tools/jupiter/params';
import Theory from '../tools/jupiter/Theory.astro';

const name = '木星';
---
<SiteLayout title={name} tool={{ id: 'jupiter', name }} note="木星の模様は NASA/ESA の Hubble 宇宙望遠鏡の OPAL（PI: Simon, GO13937、STScI がアーカイブ、DOI 10.17909/T9G593、CC BY 4.0）の全球の地図を加工したもの。ガリレオ衛星の位置は Astronomy Engine（MIT、Copyright (c) 2019-2025 Don Cross）の L1.2 の打ち切り版、大赤斑の経度は JUPOS と BAA の報告と OPAL の地図から読んだ値です。">
  <PageTitle title={name}>選んだ日時と観測地から見た木星とガリレオ衛星を描きます。模様は Hubble 宇宙望遠鏡の毎年の地図を大赤斑の位置に合わせて回したもので、衛星の影・本体の前の通過・食・掩蔽・相互食の時刻も計算します。</PageTitle>

  <div class="tgrid pn-grid">

    <Panel hid="hd-jup" title="今夜の木星" class="pn-a-scope" fixed>
      <PlanetSite slot="aux" />
      <div slot="aux" class="seg" id="p-or" role="group" aria-label="画面の向き"><button type="button" data-v="zenith" aria-pressed="false" title="観測地の天頂を上にする（空で見える向き）">天頂<span class="pn-w">が上</span></button><button type="button" data-v="planet" aria-pressed="true" title="木星の北極を上にする">木星の北<span class="pn-w">が上</span></button><button type="button" data-v="sky" aria-pressed="false" title="天の北極を上にする（望遠鏡の写真の向き）">天の北<span class="pn-w">が上</span></button></div>
      <div slot="aux" class="seg" id="p-play" data-nosave><button type="button" id="play" aria-pressed="false" title="時刻を進める（表示の設定の速さで）"><span class="led" id="playLed" aria-hidden="true"></span><span id="playT">再生</span></button></div>
      <div class="pn-clock">
        <button type="button" class="pn-nowbtn" id="nowbtn" aria-pressed="true" title="現在の日時に戻し、時計に合わせて進める"><span class="led on" id="nowLed" aria-hidden="true"></span>現在</button>
        <span class="pn-clk"><span id="clk">—</span><small id="clkz">JST</small></span>
        <span class="pn-st">日付<span class="pn-dtrow"><b id="o-date">—</b><span class="pn-dtpick"><button type="button" class="pn-calbtn" id="dtbtn" aria-label="日時を選ぶ" title="日時を選ぶ"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path></svg></button><input type="datetime-local" id="dt" step="60" tabindex="-1" aria-hidden="true"></span></span></span>
        <span class="pn-st">視直径<b id="o-diam">—</b></span>
        <span class="pn-st">等級<b id="o-mag">—</b></span>
        <span class="pn-st">中央子午線 I · II · III<b id="o-cm">—</b></span>
        <span class="pn-st">高度 · 方位<b id="o-altaz">—</b></span>
      </div>
      <div class="pn-view" id="pview">
        <canvas id="pc" role="img" aria-label="観測地から見た木星とガリレオ衛星"></canvas>
        <div class="pn-labs" id="labs" aria-hidden="true"></div>
        <div class="pn-lab" id="v-lab"></div>
        <div class="pn-lab pn-b" id="v-lab2"></div>
        <p class="pn-vmsg" id="v-msg" hidden></p>
        <div class="pn-vctl" role="group" aria-label="表示の拡大・縮小"><button type="button" class="pn-vbtn" id="vout" aria-label="縮小" title="縮小（ホイール・2 本指でも）">−</button><span class="pn-vz" id="vzoom">×1.00</span><button type="button" class="pn-vbtn" id="vin" aria-label="拡大" title="拡大（ホイール・2 本指でも）">＋</button><button type="button" class="pn-vbtn" id="vreset" title="拡大と位置をもとに戻す" hidden>もとに戻す</button></div>
      </div>
      <div class="pn-view pn-strip" id="sview">
        <canvas id="sc" aria-hidden="true"></canvas>
        <div class="pn-labs" id="slabs" aria-hidden="true"></div>
        <div class="pn-lab" id="s-lab"></div>
        <div class="pn-scale" id="s-scale"><i></i>1′</div>
      </div>
      <svg class="pn-nb" id="band" viewBox="0 -24 1000 176" role="slider" tabindex="0" aria-label="日時（今夜の帯の上を押して動かす）" aria-valuemin="0" aria-valuemax="1000" aria-valuenow="0"></svg>
      <div class="pn-tchips" id="keys" role="group" aria-label="主な日時へ移る"></div>
      <div class="pn-tstep"><span class="aux">日時を少し動かす</span><div class="seg" id="tstep" role="group" aria-label="日時を少し動かす"><button type="button" data-s="-86400">−1 日</button><button type="button" data-s="-3600">−1 時間</button><button type="button" data-s="-600">−10 分</button><button type="button" data-s="600">+10 分</button><button type="button" data-s="3600">+1 時間</button><button type="button" data-s="86400">+1 日</button></div></div>
      <More id="g-view" title="表示の設定"><div class="ana2">
        <div class="ptab">
          <ChoiceRow k="nm" name="衛星の名前" choices={[['on', 'あり'], ['off', 'なし']]} value="on" />
          <ChoiceRow k="sh" name="衛星の影" sub="木星の面に落ちる衛星の影。本影と半影を分けて描く" choices={[['on', 'あり'], ['off', 'なし']]} value="on" />
          <ChoiceRow k="map" name="模様" sub="近い年: 日付に最も近い年の Hubble の地図。最新: いつも最新の地図。どちらも大赤斑の位置に合わせて回す" choices={[['near', '近い年'], ['latest', '最新']]} value="near" />
        </div>
        <div class="ptab">
          <ChoiceRow k="tz" name="時刻" sub="日本時間（UTC+9）か世界時（UT）" choices={[['jst', '日本時間'], ['ut', '世界時']]} value="jst" />
          <ChoiceRow k="sp" name="再生の速さ" sub="実際の時間の何倍で進めるか" choices={SPEEDS} value="600" />
        </div>
      </div></More>
    </Panel>

    <Panel hid="hd-ev" title="今夜の現象" class="pn-a-ev">
      <span slot="aux" class="aux" id="ev-aux">東京で見える時刻</span>
      <ul class="pn-nl" id="evlist"></ul>
      <p class="pn-vcap">行を押すと、その時刻の木星に移ります。</p>
    </Panel>

    <Panel hid="hd-top" title="北から見た軌道" class="pn-a-top">
      <span slot="aux" class="aux">地球は下</span>
      <svg class="pn-of pn-top" id="top" viewBox="0 0 300 300" role="img" aria-label="木星の北から見たガリレオ衛星の軌道と、いまの位置"></svg>
    </Panel>

    <Panel hid="hd-wig" title="衛星の動き" class="pn-a-wig">
      <div slot="aux" class="seg" id="p-wr" role="group" aria-label="期間"><button type="button" data-v="1" aria-pressed="false">±1 日</button><button type="button" data-v="3" aria-pressed="true">±3 日</button><button type="button" data-v="8" aria-pressed="false">±8 日</button></div>
      <svg class="pn-of pn-wig" id="wig" viewBox="-40 0 600 486" role="img" aria-label="ガリレオ衛星の東西の離れの時間の変化。縦が時刻で下へ進む"></svg>
      <p class="pn-cap">横は木星の半径（灰の帯が本体）· 押すとその日時へ</p>
      <div class="pn-key" id="wkey"></div>
    </Panel>

    <Panel hid="hd-grs" title="大赤斑が中央に来る時刻" class="pn-a-grs">
      <span slot="aux" class="aux" id="grs-aux">東京で見える夜だけ</span>
      <table class="pn-evt">
        <thead><tr><th>日時</th><th>木星の高度</th><th></th></tr></thead>
        <tbody id="grs-rows"></tbody>
      </table>
      <div class="pn-grsin">
        <label class="aux" for="grs-l">大赤斑の経度（System II）</label>
        <input id="grs-l" type="text" inputmode="decimal" autocomplete="off">
        <button type="button" class="pn-vbtn pn-grsrst" id="grs-rst" title="表の値に戻す" hidden>↺</button>
        <span class="aux" id="grs-note"></span>
      </div>
    </Panel>

    <Panel hid="hd-mut" title="相互食の季節" class="pn-a-mut">
      <span slot="aux" class="aux" id="mut-aux">減光は概算</span>
      <div slot="aux" class="seg" id="p-mk" role="group" aria-label="種類"><button type="button" data-v="all" aria-pressed="true">すべて</button><button type="button" data-v="occ" aria-pressed="false">掩蔽</button><button type="button" data-v="ecl" aria-pressed="false">食</button></div>
      <div class="pn-split">
        <div>
          <div class="pn-mnav"><button type="button" class="pn-vbtn" id="mut-prev" aria-label="前の月">‹</button><span id="mut-range"></span><button type="button" class="pn-vbtn" id="mut-next" aria-label="次の月">›</button></div>
          <svg class="pn-of pn-sea" id="sea" viewBox="-44 -10 660 260" role="img" aria-label="観測地で見える相互食。横は日付、縦は夜の時刻"></svg>
        </div>
        <div class="pn-mut" id="mut-detail">
          <h3 id="mut-h"></h3>
          <p id="mut-p"></p>
          <svg class="pn-of" id="mut-curve" viewBox="0 0 300 124" role="img" aria-label="2 つの衛星の合計の明るさの変化"></svg>
          <div class="pn-key"><span><i class="pn-dotf"></i>掩蔽（手前の衛星が隠す）</span><span><i class="pn-doto"></i>食（影を落とす）</span><span>色は隠す側 · 大きさは深さ</span></div>
        </div>
      </div>
    </Panel>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="jupiter" />
  <script>
    import '../tools/jupiter/client';
  </script>
</SiteLayout>
