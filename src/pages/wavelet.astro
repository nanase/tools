---
import Collapsible from '../components/Collapsible.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../tools/audio/style.css';
import '../tools/wavelet/style.css';
import { sigs, WAV3 } from '../tools/wavelet/params';
import Theory from '../tools/wavelet/Theory.astro';

const name = 'ウェーブレット変換';
/* 同じカテゴリ（準備中を含む）の後ろに、ほかのカテゴリの公開中のツールを並べる */
/** 応用（雑音除去と圧縮）のページ。できたら先頭に置く */
type Opt = readonly (readonly [string, string])[];
/** 見出しのない選択肢の群（図の上の帯に置く）。id は保存に使う */
const seg = (id: string, label: string, opts: Opt, v: string) => ({ id, label, opts, v });
const PL_SIG = seg('pl-sig', '信号', sigs('click', 'chirp', 'doppler', 'blocks', 'bumps', 'heavisine'), 'click');
const PL_N = seg(
  'pl-n',
  'STFT の窓',
  [
    ['16', '16'],
    ['32', '32'],
    ['64', '64'],
  ],
  '32',
);
const PL_W = seg('pl-w', 'ウェーブレット', WAV3, 'haar');
const ST_SIG = seg('st-sig', '信号', sigs('doppler', 'blocks', 'heavisine', 'chirp'), 'heavisine');
const ST_W = seg('st-w', 'フィルタ', WAV3, 'db2');
const SL_SIG = seg(
  'sl-sig',
  '信号',
  [
    ['two', '2 つの音'],
    ['chirp', 'チャープ'],
    ['doppler', 'ドップラー'],
  ],
  'two',
);
const SL_REV = seg(
  'sl-reveal',
  'スカログラム',
  [
    ['all', '全体'],
    ['hand', 'なぞった所'],
  ],
  'all',
);
const T_PH = 'DWT d3  t 0.000〜0.000 s  f 000.0〜000.0 Hz  |c| 0.000';
const SL_PH = 't 0.00 s  00.0 Hz  幅 000 ms  合計 0.00';
const H8_PH = '平均 (00 + 00) / 2 = 00  差 (00 − 00) / 2 = −0.0  復元 00 ± −0.0 → 00, 00';
---
<SiteLayout title={name} tool={{ id: 'wavelet', name }} description="短い波を信号に重ねて掛けて足し、幅を変えながら似ている度合いを測ります。同じ 1 秒を変換したときにフーリエ変換では消える「いつ」が残る様子、スカログラムのでき方、隣り合う 2 つの平均と差による速い計算を、触って確かめられます。">
  <PageTitle title={name}>短い波（ウェーブレット）を信号のあちこちに重ね、幅を変えながら似ている度合いを測ります。いつ・どの高さの音が鳴ったかが同時にわかります。</PageTitle>

  <div class="tgrid">
    <Panel hid="hd-or" title="1 同じ 1 秒の変換: フーリエ変換では「いつ」が消える" class="a-or">
      <div class="bar"><span class="stag"><span class="bl" id="or-ord-l">順番</span><span class="seg" id="or-ord" role="group" aria-labelledby="or-ord-l"><button type="button" data-v="lh" aria-pressed="true">低い音 → 高い音</button><button type="button" data-v="hl" aria-pressed="false">高い音 → 低い音</button></span></span></div>
      <div class="w2">
        <figure><figcaption class="vh"><span><b>信号</b> 2 つの音</span></figcaption><div class="scope"><svg viewBox="-50 -14 462 64" id="or-x" role="img" aria-label="信号（2 つの音）"></svg></div></figure>
        <figure><figcaption class="vh"><span><b>比べる波の形</b> 正弦波は 1 s 全体・ウェーブレットは短い一部分</span></figcaption><div class="scope"><svg viewBox="-98 -2 510 62" id="or-k" role="img" aria-label="正弦波とウェーブレットの形"></svg></div></figure>
        <figure><figcaption class="vh"><span><b>フーリエ変換（1 s 全体）</b> 順番を入れ替えても同じ</span></figcaption><div class="scope"><svg viewBox="-50 -6 462 146" id="or-f" role="img" aria-label="周波数ごとの強さ"></svg></div></figure>
        <figure><figcaption class="vh"><span><b>スカログラム（1 s 全体）</b> 鳴った時刻も残る</span></figcaption><div class="scope dk"><div class="cv"><canvas id="or-m" width="800" height="480"></canvas><svg viewBox="-50 -14 462 282" id="or-s" role="img" aria-label="スカログラム。横は時間、縦は周波数"></svg></div></div></figure>
      </div>
      <p class="note">窓で短く区切る STFT なら、フーリエ変換でも時刻はわかる。ただし窓の長さは周波数によらず 1 つ（3 で比較）</p>
    </Panel>

    <Panel hid="hd-sl" title="2 短い波を重ねて、掛けて足す" class="a-sl" fixed>
      <div class="bar">
        {[SL_SIG, SL_REV].map((s) => <span class="stag"><span class="bl" id={`${s.id}-l`}>{s.label}</span><span class="seg" id={s.id} data-nosave={s === SL_REV ? true : undefined} role="group" aria-labelledby={`${s.id}-l`}>{s.opts.map(([v, l]) => <button type="button" data-v={v} aria-pressed={v === s.v ? 'true' : 'false'}>{l}</button>)}</span></span>)}
        <span class="seg"><button type="button" id="sl-sweep" title="今の幅のまま左端から右端へ移動"><span class="i-go" aria-hidden="true">▶</span><span class="i-st" aria-hidden="true">■</span> この幅で掃引</button><button type="button" id="sl-clear" class="hand-only" title="塗った所の消去">消去</button></span>
      </div>
      <div class="w2">
        <div class="sl-l">
          <figure><figcaption class="vh"><span><b>信号とウェーブレット</b> 左右に引いて位置を移動</span></figcaption><div class="scope"><svg viewBox="-50 -2 462 60" id="sl-x" role="img" aria-label="信号とウェーブレット。左右に引くと位置が動く"></svg></div></figure>
          <figure><figcaption class="vh"><span><b>掛け算</b> 形が合うと山 × 山・谷 × 谷で、積はどこも正（上側）</span></figcaption><div class="scope"><svg viewBox="-50 -2 462 60" id="sl-p" role="img" aria-label="信号とウェーブレットの積"></svg></div></figure>
          <figure><figcaption class="vh"><span><b>合計</b> 形が合うほど大きな値。合わなければ正と負が打ち消し合って 0 近く</span></figcaption><div class="scope"><svg viewBox="-50 -1 462 26" id="sl-g" role="img" aria-label="積の合計"></svg></div></figure>
          <div class="wrow"><span class="bl">幅</span><span class="sm">短い</span><div class="sl"><input type="range" id="sl-w" min="0" max="72" step="1" value="40" aria-label="ウェーブレットの幅"></div><span class="sm">長い</span></div>
        </div>
        <figure><figcaption class="vh"><span><b>スカログラム</b> 横は時間・縦は周波数・明るさは合計の大きさ</span></figcaption><div class="scope dk"><div class="cv"><canvas id="sl-m" width="800" height="480"></canvas><svg viewBox="-50 -14 462 282" id="sl-s" tabindex="0" role="img" aria-label="スカログラム。押すと位置と幅を選ぶ。矢印キーでも動かせる"></svg></div></div></figure>
      </div>
      <div class="sbar lg">
        <span class="stag"><i class="sw c2" aria-hidden="true"></i>信号</span>
        <span class="stag"><i class="sw w-sw-wv" aria-hidden="true"></i>ウェーブレット</span>
        <span class="stag"><i class="sw w-sw-pp" aria-hidden="true"></i>積が正</span>
        <span class="stag"><i class="sw w-sw-pn" aria-hidden="true"></i>積が負</span>
        <span class="stag"><i class="w-sw-coi" aria-hidden="true"></i>端の影響</span>
        <span class="stag">波の山の位置: 最もよく合う所に調整</span>
      </div>
      <div class="sbar rdbar" data-ph={SL_PH}><span class="rd" id="sl-rd"></span></div>
    </Panel>

    <Panel hid="hd-pl" title="3 高い音は短い波、低い音は長い波で測る" class="a-pl">
      <div class="bar">
        <span class="bl" id="pl-sig-l">{PL_SIG.label}</span>
        <div class="chips" id={PL_SIG.id} role="group" aria-labelledby="pl-sig-l">{PL_SIG.opts.map(([v, l]) => <button type="button" class="chip" data-v={v} aria-pressed={v === PL_SIG.v ? 'true' : 'false'}>{l}</button>)}</div>
        <span class="stag"><span class="bl" id="pl-ax-l">周波数軸</span><span class="seg" id="pl-ax" role="group" aria-labelledby="pl-ax-l"><button type="button" data-v="lin" aria-pressed="true" title="周波数を等間隔に">線形</button><button type="button" data-v="log" aria-pressed="false" title="1 オクターブを同じ高さに">対数</button></span></span>
      </div>
      <div class="pl2">
        {[{ k: 0, s: PL_N, h: 'STFT（参考）', d: '同じ大きさの箱' }, { k: 1, s: PL_W, h: 'ウェーブレット（DWT）', d: '低いほど横長の箱' }].map((p) => (
          <figure class="plf">
            <figcaption class="vh"><span><b>{p.h}</b> {p.d}</span><span class="seg" id={p.s.id} role="group" aria-label={p.s.label}>{p.s.opts.map(([v, l]) => <button type="button" data-v={v} aria-pressed={v === p.s.v ? 'true' : 'false'} title={p.k ? undefined : `窓の長さ ${l} 点`}>{l}</button>)}</span></figcaption>
            <div class="scope"><svg viewBox="-50 -6 462 64" id={`pl-x${p.k}`} role="img" aria-label="信号と、選んだ箱の波形"></svg></div>
            <div class="scope dk"><div class="cv"><canvas id={`pl-c${p.k}`} width="800" height="480"></canvas><svg viewBox="-50 -14 462 282" id={`pl-s${p.k}`} tabindex="0" role="img" aria-label={`${p.h}の時間と周波数の平面。矢印キーで箱を選ぶ`}></svg></div></div>
          </figure>
        ))}
      </div>
      <div class="sbar rdbar" data-ph={T_PH}><span class="rd" id="pl-rd"></span></div>
    </Panel>

    <Panel hid="hd-h8" title="4 速い計算: 隣り合う 2 つの平均と差" class="a-h8">
      <div class="bar">
        <span class="seg"><button type="button" id="h8-home" title="最初へ（分ける前の数）" aria-label="最初へ">⏮</button><button type="button" id="h8-next" title="次の段" aria-label="次の段">⏭</button></span>
        <b class="lev" id="h8-lev">段 3 / 3</b>
        <span class="seg" id="h8-cut" role="group" aria-label="小さい差"><button type="button" data-v="off" aria-pressed="true">そのまま</button><button type="button" data-v="on" aria-pressed="false" title="|差| ≤ 1 を 0 にして復元">小さい差を 0 に</button></span>
      </div>
      <div class="scope"><svg viewBox="-48 0 452 266" id="h8-svg" role="img" aria-label="8 つの数を平均と差に分ける。棒は上下に引いて変更"></svg></div>
      <div class="sbar lg">
        <span class="stag"><i class="sw c2" aria-hidden="true"></i>平均</span>
        <span class="stag"><i class="sw" aria-hidden="true"></i>差</span>
        <span class="stag"><i class="sw w-sw-h8g" aria-hidden="true"></i>復元した数</span>
        <span class="stag">棒は上下に引いて変更</span>
      </div>
      <div class="sbar rdbar" data-ph={H8_PH}><span class="rd" id="h8-rd"></span></div>
    </Panel>

    <Panel hid="hd-st" title="5 同じことを 256 点で" class="a-st">
      <span slot="aux" class="aux" id="st-aux"></span>
      <div class="bar">
        {[ST_SIG, ST_W].map((s) => <span class="stag"><span class="bl" id={`${s.id}-l`}>{s.label}</span><span class="seg" id={s.id} role="group" aria-labelledby={`${s.id}-l`}>{s.opts.map(([v, l]) => <button type="button" data-v={v} aria-pressed={v === s.v ? 'true' : 'false'}>{l}</button>)}</span></span>)}
      </div>
      <div class="scope"><svg viewBox="-52 -6 460 286" id="st-svg" role="img" aria-label="段ごとの分解"></svg></div>
      <div class="sbar lg">
        <span class="stag"><i class="sw c2" aria-hidden="true"></i>近似（低域）</span>
        <span class="stag"><i class="sw" aria-hidden="true"></i>詳細（高域）</span>
        <span class="stag"><i class="sw w-sw-f" aria-hidden="true"></i>フィルタ</span>
      </div>
      <div class="tp">
        <button type="button" class="tp-ib" id="st-home" title="最初から（分ける前の信号へ）" aria-label="最初から"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="1.8" height="9"/><path d="M10.5 1.5v9L4 6z"/></svg></button>
        <button type="button" class="tp-pp" id="st-pp" title="分解の再生" aria-label="分解の再生"><svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.2l7.6 4.8L3 10.8z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9"/><rect x="7.2" y="1.5" width="2.8" height="9"/></svg></button>
        <div class="tp-tl">
          <div class="phs" id="st-phs"></div>
          <div class="tp-tm"><span>係数 <b id="st-n">0</b> 組</span><span id="st-len"></span></div>
        </div>
        <div class="tp-side"><button type="button" class="tp-sq" id="st-step" title="1 段進める" aria-label="1 段進める"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3l6 5-6 5M12 3v10"/></svg></button></div>
      </div>
    </Panel>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="wavelet" />
  <script>
    import '../tools/wavelet/client';
  </script>
</SiteLayout>
