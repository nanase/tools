---
import ChoiceRow from '../components/ChoiceRow.astro';
import Collapsible from '../components/Collapsible.astro';
import PageTitle from '../components/PageTitle.astro';
import Panel from '../components/Panel.astro';
import ParamRow from '../components/ParamRow.astro';
import RelatedTools from '../components/RelatedTools.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../tools/red-black-tree/style.css';
import { rng, SHAPES, shapeAt } from '../tools/list-queue-stack/model';
import { DEFS, STAGES } from '../tools/red-black-tree/model';
import { SIZE, SPEED, VOL } from '../tools/red-black-tree/params';
import Theory from '../tools/red-black-tree/Theory.astro';

const name = '赤黒木';
/** キーの順番の選択肢の小さな絵 */
const shapeSvg = (k: (typeof SHAPES)[number][0]): string => {
  const r = rng(5),
    bars = Array.from({ length: 8 }, (_, i) => {
      const h = shapeAt(k, i / 7, r) * 11;
      return `<rect x="${(i * 3.2).toFixed(1)}" y="${(12 - h).toFixed(1)}" width="2.3" height="${h.toFixed(1)}"/>`;
    }).join('');
  return `<svg viewBox="0 0 26 12" aria-hidden="true">${bars}</svg>`;
};
/* 初めはランダムを先頭に置く */
const BARS = [...SHAPES]
  .sort((a, b) => Number(b[0] === 'rand') - Number(a[0] === 'rand'))
  .map(([k, t]) => ({ k, t, svg: shapeSvg(k) }));
---
<SiteLayout title={name} tool={{ id: 'red-black-tree', name }}>
  <PageTitle title={name}>ノードを赤と黒に塗り分け、回転と色の変更で木を低く保つ二分探索木です。順に並んだキーを入れても傾きません。</PageTitle>

  <div class="tgrid" id="rb" data-mode="one">
    <Panel hid="hd-fig" title="赤黒木" class="a-fig" fixed>
      <span slot="aux" class="aux tp-st" id="rb-st" hidden><span class="led" id="rb-led" aria-hidden="true"></span><span id="rb-stT"></span></span>
      <div slot="aux" class="seg" id="rb-mode" role="group" aria-label="表示">
        <button type="button" data-v="one" aria-pressed="true">単独</button>
        <button type="button" data-v="cmp" aria-pressed="false">比較</button>
        <button type="button" data-v="list" aria-pressed="false">一覧</button>
      </div>
      <div class="sbar rb-lg">
        <span class="rb-lgl">
          <span class="stag"><i class="rb-sw rb-r" aria-hidden="true"></i>赤</span>
          <span class="stag"><i class="rb-sw rb-k" aria-hidden="true"></i>黒</span>
          <span class="stag"><i class="rb-sw rb-cmp" aria-hidden="true"></i>比較</span>
          <span class="stag"><i class="rb-sw rb-mov" aria-hidden="true"></i>回転・色の変更</span>
          <span class="stag"><i class="rb-sw rb-bad" aria-hidden="true"></i>条件違反</span>
          <span class="stag"><i class="rb-sw rb-done" aria-hidden="true"></i>発見</span>
        </span>
        <span class="rb-end"><span class="sr" id="rb-say"></span><button type="button" class="prst" id="rb-reset2" hidden>リセット</button></span>
      </div>
      <div class="rb-steps" id="rb-steps" role="group" aria-label="工程">
        {STAGES.map(([, t, d], i) => (
          <button type="button" data-s={i} aria-pressed={i === 0 ? 'true' : 'false'}><b>{i + 1} {t}</b><em></em><span>{d}</span></button>
        ))}
      </div>
      <div class="scope rb-scr rb-solo"><canvas id="rb-cv" role="img" aria-label="赤黒木"></canvas></div>
      <div class="rb-race" id="rb-race"></div>
      <div class="tp">
        <button type="button" class="tp-ib" id="tp-home" title="最初へ" aria-label="最初へ"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="1.8" height="9"/><path d="M10.5 1.5v9L4 6z"/></svg></button>
        <button type="button" class="tp-pp" id="tp-pp" title="再生" aria-label="再生"><svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.2l7.6 4.8L3 10.8z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9"/><rect x="7.2" y="1.5" width="2.8" height="9"/></svg></button>
        <div class="tp-tl">
          <div class="tp-trk" id="tp-trk" role="slider" tabindex="0" aria-label="進み具合" aria-valuemin="0" aria-valuemax="1" aria-valuenow="0">
            <div class="tp-rail"></div>
            <div class="tp-fill" id="tp-fill"></div>
            <div class="tp-th" id="tp-th"></div>
          </div>
          <div class="tp-tm"><span><b id="tp-a">0</b> / <span id="tp-b">0</span> 手順</span><span id="tp-t"></span></div>
        </div>
        <div class="tp-side">
          <button type="button" class="tp-sq" id="tp-back" title="前の手順" aria-label="前の手順"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12 3L6 8l6 5M4 3v10"/></svg></button>
          <button type="button" class="tp-sq" id="tp-step" title="次の手順" aria-label="次の手順"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3l6 5-6 5M12 3v10"/></svg></button>
        </div>
      </div>
      <div class="ptab rb-row"><ParamRow d={SPEED} /></div>
    </Panel>

    <Panel hid="hd-mat" title="操作と計算量" class="a-mat">
      <span slot="aux" class="aux">n = キーの数</span>
      <div class="rb-mx"><table class="rb-mt" id="rb-mx"></table></div>
    </Panel>

    <Panel hid="hd-cmp" title="計算結果" class="a-cmp">
      <div class="rb-rw"><table class="rb-rt" id="rb-rt"></table></div>
    </Panel>

    <div class="col">
      <Panel hid="hd-str" title="データ構造" class="a-str">
        <span slot="aux" class="aux" id="rb-an"></span>
        <div id="rb-str">
          <div class="chips">
            {DEFS.map((d) => <button type="button" class="chip" data-v={d.id} aria-pressed={d.id === 'rb' ? 'true' : 'false'}>{d.name}</button>)}
          </div>
        </div>
        <div class="ptab rb-row" id="rb-byw" hidden>
          <ChoiceRow k="by" name="比較の対象" choices={[['str', 'データ構造'], ['shape', 'キーの順番']]} value="str" />
        </div>
      </Panel>
      <Panel hid="hd-data" title="データ" class="a-data">
        <button slot="aux" type="button" class="prst" id="rb-new">新しいデータ</button>
        <div class="ptab rb-row">
          <ParamRow d={SIZE} />
          <div class="prow chr wide">
            <div class="c-sym" aria-hidden="true"></div>
            <div class="c-name"><span class="pn" id="n-shape">キーの順番</span></div>
            <div class="c-rst"></div>
            <div class="c-sub"><div class="chips" id="rb-shape" role="group" aria-labelledby="n-shape">
              {BARS.map(({ k, t, svg }) => <button type="button" class="chip" data-v={k} aria-pressed={k === 'rand' ? 'true' : 'false'}><Fragment set:html={svg} />{t}</button>)}
            </div></div>
          </div>
          <ChoiceRow k="nil" name="NIL の葉" choices={[['0', 'なし'], ['1', '表示']]} value="0" />
        </div>
      </Panel>
    </div>
    <div class="col">
      <Panel hid="hd-ops" title="操作" class="a-ops">
        <button slot="aux" type="button" class="prst" id="rb-reset" hidden>リセット</button>
        <div class="rb-ow">
          <table class="rb-ot">
            <thead><tr><th scope="col">実行</th><th scope="col" class="rb-how">内容</th><th scope="col" class="r">計算量</th><th scope="col" class="r" title="キー 31 個で 8 通りのデータを試した 1 回の平均">n = 31 の平均</th></tr></thead>
            <tbody id="rb-ops"></tbody>
          </table>
        </div>
      </Panel>
      <Panel hid="hd-out" title="計算結果" class="a-out">
        <dl class="metrics rb-res">
          <div class="m m-main"><dt>比較と回転</dt><dd><span id="o-t">0</span><span class="u">回</span></dd></div>
          <div class="m"><dt>比較</dt><dd id="o-c">0</dd></div>
          <div class="m"><dt>回転</dt><dd id="o-r">0</dd></div>
          <div class="m"><dt>色の変更</dt><dd id="o-p">0</dd></div>
          <div class="m"><dt>高さ</dt><dd id="o-h">–</dd></div>
          <div class="m"><dt>高さの上限</dt><dd id="o-b">–</dd></div>
          <div class="m"><dt>最小の高さ</dt><dd id="o-lo">–</dd></div>
          <div class="m"><dt>黒の高さ</dt><dd id="o-bh">–</dd></div>
          <div class="m"><dt>キー</dt><dd id="o-n">0</dd></div>
          {DEFS.map((d) => <div class="m m-sub m-w" data-for={d.id}><dt>利用例</dt><dd>{d.ex}</dd></div>)}
        </dl>
      </Panel>
      <Panel hid="hd-snd" title="音" class="a-snd">
        <div slot="aux" class="seg"><button type="button" id="rb-snd" aria-pressed="true"><span class="led on" id="rb-sndL" aria-hidden="true"></span> <span id="rb-sndT">オン</span></button></div>
        <div class="ptab rb-row"><ParamRow d={VOL} /></div>
      </Panel>
    </div>

    <Collapsible hid="hd-thy" title="動作原理と式">
      <Theory />
    </Collapsible>
  </div>

  <RelatedTools current="red-black-tree" />
  <script>
    import '../tools/red-black-tree/client';
  </script>
</SiteLayout>
