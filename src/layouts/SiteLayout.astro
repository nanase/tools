---
import '../styles/site.css';
import Fonts from '../components/Fonts.astro';
import Footer from '../components/Footer.astro';
import Rail from '../components/Rail.astro';

interface Props {
  /** <title>。省略するとサイト名だけ */
  title?: string;
  description: string;
  /** ツールのページなら、その id（メニューの現在地）とページ名（上部バー） */
  tool?: { id: string; name: string };
  /** フッターの注記。省略時は出さない */
  note?: string;
}
const { title, description, tool, note } = Astro.props;
const site = 'Tools + Simulators';
/* アイコンは public/ に置く。ルート（/favicon.ico）はドメインのものなので base を付ける */
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<script is:inline>try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
<title>{title ? `${title} | ${site}` : site}</title>
<meta name="description" content={description}>
<meta property="og:title" content={title ?? site}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href}>
<meta property="og:site_name" content={site}>
<meta property="og:locale" content="ja_JP">
{/* 共有の画像は全ページ共通。作り直すときは scripts/og-image.ts */}
<meta property="og:image" content={new URL(`${base}og.png`, Astro.site).href}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${site}: 電子から音響・光学・天文まで`}>
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href}>
<link rel="icon" sizes="16x16 32x32 48x48" href={`${base}favicon.ico`}>
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}>
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
<Fonts />
</head>
<body>
<Rail current={tool?.id} page={tool?.name} />
<main class="wrap">
  <slot />
  {/* 保存した枠の開閉（lib/store.ts の o:<見出しの id>）を、描く前に戻す。動作は lib/tool-page.ts */}
  <script is:inline>try{var s=JSON.parse(localStorage.getItem('settings:'+location.pathname)||'{}');document.querySelectorAll('[data-fold]').forEach(function(p){var v=s['o:'+p.dataset.fold];if(typeof v!=='boolean')return;if(p.tagName==='DETAILS')p.open=v;else{p.classList.toggle('shut',!v);p.querySelector('.fold').setAttribute('aria-expanded',String(v))}})}catch(e){}</script>
</main>
<Footer note={note} />
</body>
</html>
