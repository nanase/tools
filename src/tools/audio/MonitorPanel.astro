---
/**
 * モニタの枠（入力の音をスピーカで鳴らす）。JJY のページの「音」の枠と同じ作りで、開閉できる。
 * マイクの間はハウリングを避けるため使わない（枠ごと畳んで開けなくする、.lock）。動作は input.ts
 */
import LedToggle from '../../components/LedToggle.astro';
import ParamRow from '../../components/ParamRow.astro';
import { VOL_PARAM } from './params';
---
<details class="pnl clps a-snd lock">
  <summary aria-disabled="true"><h2 id="hd-snd" style="font:inherit">モニタ</h2><span class="snd-note">マイクでは使いません</span></summary>
  <div class="thy-body">
    <div class="ph"><div class="pha"><LedToggle id="monBtn" label="再生" title="入力の音をスピーカへ" /></div></div>
    <div class="ptab"><ParamRow d={VOL_PARAM} /></div>
  </div>
</details>
