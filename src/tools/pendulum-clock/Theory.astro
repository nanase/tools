---
// 動作原理と式
import { Clock, type EscType, rateOf, springF, TABLES, TYPES } from './model';

type Ref = { for: string; src: string };
/** 型ごとの、巻き切りから残り 2 日までの進み遅れの変化・止まる振り角・止まるまでの日数（表から求める） */
const ROWS = (Object.keys(TYPES) as EscType[]).map((t) => {
  const d = rateOf(t, springF(2)) - rateOf(t, 1),
    c = new Clock(t, Date.UTC(2026, 0, 1, 3));
  c.setMode('avg');
  let h = 0;
  for (; h < 24 * 12 && !c.stopped; h++) c.stepAvg(3600);
  return {
    t,
    name: TYPES[t].name,
    drift: `${d >= 0 ? '+' : '−'}${Math.abs(d).toFixed(0)} s/日`,
    stop: `${TABLES[t].Aon.toFixed(1)}° 未満`,
    days: `${(h / 24).toFixed(1)} 日`,
  };
});
const REFS: readonly Ref[] = [
