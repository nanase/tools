---
// 動作原理と式。代入した式（#subst）は client.ts が入れる
import { EQS, THEORY_P } from './theory';
---
{THEORY_P.map((p) => <p set:html={p} />)}
<div class="eqs">
  <Fragment set:html={EQS} />
  <div class="subst" id="subst" role="group" aria-label="現在の値を代入した式"></div>
</div>
<p class="cite">出典: A. V. Oppenheim, R. W. Schafer『Discrete-Time Signal Processing』3rd ed., Pearson, 2010（7 章 FIR フィルタの設計）、J. F. Kaiser, "Nonrecursive Digital Filter Design Using the I<sub>0</sub>-sinh Window Function", Proc. IEEE ISCAS, 1974、E. C. Ifeachor, B. W. Jervis『Digital Signal Processing: A Practical Approach』2nd ed., Prentice Hall, 2002（窓の遷移帯域幅と阻止域の減衰）、T. W. Parks, J. H. McClellan, "Chebyshev Approximation for Nonrecursive Digital Filters with Linear Phase", IEEE Trans. Circuit Theory, CT-19(2), 1972、J. H. McClellan, T. W. Parks, L. R. Rabiner, "A Computer Program for Designing Optimum FIR Linear Phase Digital Filters", IEEE Trans. Audio Electroacoust., AU-21(6), 1973、C. S. Burrus, A. W. Soewito, R. A. Gopinath, "Least Squared Error FIR Filter Design with Transition Bands", IEEE Trans. Signal Processing, 40(6), 1992、S. J. Orfanidis, "Lecture Notes on Elliptic Filter Design", Rutgers University, 2006（IIR フィルタの次数）</p>
