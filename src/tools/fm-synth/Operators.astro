---
/**
 * オペレータの枠の中身: 1 つのオペレータを 2 段に並べる。
 * 上の段は 波形 | 周波数比 | 変調指数（キャリアなら出力レベル）、下の段は ADSR の小さな図 | A・D・S・R | デチューン。
 * 波形はボタン、数値は数値の行（ParamRow。項目名は読み上げだけ）。動作は client.ts
 */
import ParamRow from '../../components/ParamRow.astro';
import { ALG0, ampDef, detDef, envDef, OPS, ratioDef, SEGS, W0 } from './params';
import { ENV0, isCarrier, WAVES, waveAt } from './synth';

/** 波形のボタンの図柄（20 × 12 に 1 周期） */
const icon = (w: number) => {
  let d = '';
  for (let i = 0; i <= 48; i++)
    d += `${i ? 'L' : 'M'}${((i / 48) * 18 + 1).toFixed(2)} ${(6 - 4.6 * waveAt(w, (i / 48) * 2 * Math.PI)).toFixed(2)}`;
  return d;
};
/** エンベロープの行の既定値（S は %） */
const env0 = { a: ENV0.ar, d: ENV0.dr, s: ENV0.sl * 100, r: ENV0.rr } as const;
---
<div class="ops" id="ops">
  {OPS.map((n) => {
    const car = isCarrier(ALG0, n - 1);
    return (
      <div class="op" id={`op${n}`} role="group" aria-labelledby={`op${n}-h`}>
        <div class="op-h"><b id={`op${n}-h`}>OP{n}</b><span class="op-role" id={`op${n}-role`}>{car ? 'キャリア' : 'モジュレータ'}</span></div>
        <div class="seg op-w" id={`p-w${n}`} role="group" aria-label={`OP${n} の波形`}>
          {WAVES.map(([v, l], i) => <button type="button" data-v={v} aria-pressed={v === W0[n - 1] ? 'true' : 'false'} title={l} aria-label={l}><svg viewBox="0 0 20 12" aria-hidden="true"><path d={icon(i)} /></svg></button>)}
        </div>
        <div class="op-c">
          <div class="ptab"><ParamRow d={ratioDef(n)} /></div>
          <div class="ptab"><ParamRow d={ampDef(n, car)} /></div>
        </div>
        <div class="op-e">
          <svg class="op-env" id={`env${n}`} viewBox="0 0 56 24" aria-hidden="true"><path class={car ? 'car' : ''} /></svg>
          {SEGS.map((g) => <div class="ptab"><ParamRow d={envDef(n, g, env0[g])} /></div>)}
          <div class="ptab"><ParamRow d={detDef(n)} /></div>
        </div>
      </div>
    );
  })}
</div>
