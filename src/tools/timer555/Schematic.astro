---
// 回路図。最初は非安定の図をビルド時に出し、回路の切り替えと電圧・電流の動きは client.ts と flow.ts が描く
import { CIR, type Vals } from './circuits';
import { PARAMS } from './params';
import { drawCircuit } from './schematic';

const v = Object.fromEntries(PARAMS.map((d) => [d.k, CIR.astable.def[d.k] ?? d.v])) as Vals;
const svg = drawCircuit('astable', v).svg;
---
<svg class="sch t5-sch" id="t5-sch" viewBox="0 0 390 296" role="img" aria-label="回路図。配線の色は電圧、黄色い粒は電流" set:html={svg} />
