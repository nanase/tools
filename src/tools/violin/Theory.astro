  <thead><tr><th scope="col">弦</th><th scope="col" class="num"><math><mi>β</mi></math>（押さえた音）</th><th scope="col" class="num"><math><mi>β</mi></math>（開放弦）</th><th scope="col" class="num">弓の速さ</th></tr></thead>
  <tbody>
    <tr><th scope="row">E 線</th><td class="num">0.12〜0.135</td><td class="num">0.12〜0.13</td><td class="num">0.22〜0.5 m/s</td></tr>
    <tr><th scope="row">A 線</th><td class="num">0.07〜0.1</td><td class="num">0.07〜0.1</td><td class="num">0.22〜0.5 m/s</td></tr>
    <tr><th scope="row">D 線</th><td class="num">0.09〜0.11</td><td class="num">0.1〜0.115</td><td class="num">0.22〜0.5 m/s</td></tr>
    <tr><th scope="row">G 線</th><td class="num">0.1〜0.13</td><td class="num">0.115〜0.13</td><td class="num">0.22〜0.5 m/s（開放弦は 0.35 m/s まで）</td></tr>
