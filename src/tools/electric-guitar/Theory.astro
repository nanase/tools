---
// 動作原理と式
const sub = (b: string, s: string) => `<msub>${b}<mrow>${s}</mrow></msub>`;
const p = (s: string) => `<mo stretchy="false">(</mo>${s}<mo stretchy="false">)</mo>`;
const rf = (...n: number[]) => n.map((k) => `<a class="rf" href="#thy-r${k}">[${k}]</a>`).join('');
const fn = sub('<mi>f</mi>', '<mi>n</mi>'),
  an = sub('<mi>a</mi>', '<mi>n</mi>'),
  sn = sub('<mi>σ</mi>', '<mi>n</mi>'),
  wn = sub('<mi>ω</mi>', '<mi>n</mi>'),
  xp = sub('<mi>x</mi>', '<mi>p</mi>'),
  xk = sub('<mi>x</mi>', '<mi>k</mi>'),
  d0 = sub('<mi>d</mi>', '<mn>0</mn>');
---
<h3>全体の流れ</h3>
<ol class="flow"><li>弦</li><li>ピックアップ</li><li>ペダル（アンプの前）</li><li>アンプ</li><li>キャビネット</li><li>ペダル（マイクの後ろ）</li></ol>
<ul class="tl">
  <li>弦の振動をピックアップが電圧に変え、ケーブルでペダルとアンプへ送る</li>
  <li>アンプの出力をスピーカーで鳴らし、マイクで拾った音にもペダルを掛けられる</li>
  <li>ペダルは並べた順に通す。同じ組み合わせでも順が違うと音が変わる（歪みの前と後ろのリバーブなど）</li>
  <li>スルーのペダルは何もせずに通す。ペダルを外したのと同じ音になる</li>
  <li>試聴はその段を通った信号をそのまま出力にする。ピックアップを通った信号は 1 V 前後の電圧</li>
</ul>

<h3>弦</h3>
<div class="eqs">
  <math display="block" set:html={`<mi>y</mi>${p('<mi>x</mi><mo>,</mo><mi>t</mi>')}<mo>=</mo><munder><mo>∑</mo><mi>n</mi></munder>${an}<mspace width="0.15em"/><mi>sin</mi><mo>⁡</mo><mfrac><mrow><mi>n</mi><mi>π</mi><mi>x</mi></mrow><mi>L</mi></mfrac><mspace width="0.15em"/><msup><mi>e</mi><mrow><mo>−</mo>${sn}<mi>t</mi></mrow></msup><mi>cos</mi><mo>⁡</mo>${wn}<mi>t</mi>`} />
  <math display="block" set:html={`${fn}<mo>=</mo><mi>n</mi>${sub('<mi>f</mi>', '<mn>1</mn>')}<msqrt><mn>1</mn><mo>+</mo><mi>B</mi><msup><mi>n</mi><mn>2</mn></msup></msqrt>`} />
  <math display="block" set:html={`${an}<mo>=</mo><mfrac><mrow><mn>2</mn><mi>A</mi></mrow><mrow><msup><mi>n</mi><mn>2</mn></msup><msup><mi>π</mi><mn>2</mn></msup><mi>u</mi>${p('<mn>1</mn><mo>−</mo><mi>u</mi>')}</mrow></mfrac><mi>sin</mi><mo>⁡</mo><mi>n</mi><mi>π</mi><mi>u</mi>`} />
</div>
<dl class="syms">
  <dt><math><mi>L</mi></math></dt><dd>振動する長さ（弦長 648 mm をフレットで縮めた長さ）</dd>
  <dt><math><mi>B</mi></math></dt><dd>非調和性係数（弦の曲げの硬さ）</dd>
  <dt><math><mi>u</mi></math></dt><dd>弾く位置 ÷ <i>L</i></dd>
  <dt><math><mi>A</mi></math></dt><dd>弾く点の引き量</dd>
</dl>
<ul class="tl">
  <li>両端を止めた硬い弦のモードを重ねる（モード合成）<Fragment set:html={rf(1)} /></li>
  <li>弾いた点が角になった三角形から振動を始める。ピックの幅でガウスに丸める</li>
  <li>ソリッドボディは胴へ逃げるエネルギーが小さく、音が長く続く</li>
</ul>

<h3>ピックアップ</h3>
<div class="eqs">
  <math display="block" set:html={`<mi>e</mi><mo>∝</mo><munder><mo>∑</mo><mi>n</mi></munder><mfrac><mrow><mo>∂</mo><mi>y</mi></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac>${p(xp)}<mspace width="0.15em"/><msup><mi>e</mi><mrow><mo>−</mo><msup>${p('<msub><mi>k</mi><mi>n</mi></msub><mi>w</mi>')}<mn>2</mn></msup><mo>/</mo><mn>2</mn></mrow></msup><mspace width="0.4em"/><mfrac><msup>${d0}<mn>2</mn></msup><msup>${p(`${d0}<mo>−</mo><mi>y</mi>`)}<mn>2</mn></msup></mfrac>`} />
  <math display="block" set:html={`<mi>H</mi>${p('<mi>s</mi>')}<mo>=</mo><mfrac><mrow>${sub('<mi>Z</mi>', '<mi>L</mi>')}</mrow><mrow><mi>R</mi><mo>+</mo><mi>s</mi><msub><mi>L</mi><mi>c</mi></msub><mo>+</mo>${sub('<mi>Z</mi>', '<mi>L</mi>')}</mrow></mfrac><mo>,</mo><mspace width="0.6em"/><mfrac><mn>1</mn>${sub('<mi>Z</mi>', '<mi>L</mi>')}</mfrac><mo>=</mo><mi>s</mi><mi>C</mi><mo>+</mo><mfrac><mn>1</mn>${sub('<mi>R</mi>', '<mi>v</mi>')}</mfrac><mo>+</mo><mfrac><mrow><mi>s</mi>${sub('<mi>C</mi>', '<mi>t</mi>')}</mrow><mrow><mn>1</mn><mo>+</mo><mi>s</mi>${sub('<mi>R</mi>', '<mi>t</mi>')}${sub('<mi>C</mi>', '<mi>t</mi>')}</mrow></mfrac>`} />
</div>
<dl class="syms">
  <dt><math set:html={xp} /></dt><dd>ピックアップの位置（駒からネック 158 mm・センター 98 mm・ブリッジ 42 mm）</dd>
  <dt><math><mi>w</mi></math></dt><dd>磁石が拾う幅（シングルコイル 3.5 mm、ハムバッカーは 18 mm 離れた 2 つのコイルの平均）</dd>
  <dt><math set:html={d0} /></dt><dd>弦とポールピースの間の距離 2.8 mm</dd>
  <dt><math><mi>R</mi></math>・<math><msub><mi>L</mi><mi>c</mi></msub></math></dt><dd>コイルの抵抗とインダクタンス（シングルコイル 6 kΩ・2.4 H、ハムバッカー 8.2 kΩ・4.2 H）</dd>
  <dt><math><mi>C</mi></math></dt><dd>コイルの容量とケーブルの容量（100 pF/m）の和</dd>
  <dt><math set:html={sub('<mi>R</mi>', '<mi>v</mi>')} /></dt><dd>ボリュームのポットとアンプの入力（1 MΩ）の並列</dd>
  <dt><math set:html={sub('<mi>R</mi>', '<mi>t</mi>')} /></dt><dd>トーンのポット（コンデンサ <i>C</i><sub>t</sub> と直列）</dd>
</dl>
<ul class="tl">
  <li>磁石の上の弦の速さに比例した電圧が出る。真上が節になる倍音は出ない<Fragment set:html={rf(2, 3)} /></li>
  <li>弦が磁石に近づくほど磁束が強く、波形の上下がそろわない（偶数の倍音が出る）</li>
  <li>コイルと容量で 2〜5 kHz に共振の山ができる。ケーブルを長くすると山が下がり、トーンを絞ると山が消える<Fragment set:html={rf(2)} /></li>
  <li>2 つのピックアップを選ぶと出力を足し合わせる。位置の違う 2 つの拾い方が打ち消し合い、細い音になる</li>
</ul>

<h3>歪み</h3>
<div class="eqs">
  <math display="block" set:html={`<mi>y</mi><mo>=</mo><mi>x</mi><mo>+</mo><mn>0.6</mn><mspace width="0.15em"/><mi>tanh</mi><mo>⁡</mo><mfrac><mrow><mi>G</mi><mspace width="0.15em"/>${sub('<mi>x</mi>', '<mtext>HP</mtext>')}</mrow><mn>0.6</mn></mfrac><mspace width="1em"/><mi>G</mi><mo>=</mo><mn>1</mn><mo>+</mo><mfrac><mrow><mn>51</mn><mtext> k</mtext><mo>+</mo><mn>500</mn><mtext> k</mtext><mo>×</mo><mi>g</mi></mrow><mrow><mn>4.7</mn><mtext> k</mtext></mrow></mfrac>`} />
  <math display="block" set:html={`<msub><mi>y</mi><mi>k</mi></msub><mo>=</mo><mfrac><mrow><mi>F</mi>${p(xk)}<mo>−</mo><mi>F</mi>${p(sub('<mi>x</mi>', '<mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow>'))}</mrow><mrow>${xk}<mo>−</mo>${sub('<mi>x</mi>', '<mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow>')}</mrow></mfrac>`} />
</div>
<ul class="tl">
  <li>前のフィルタ → 記憶のない非線形 → 音色のフィルタの 3 段で近づける<Fragment set:html={rf(4)} /></li>
  <li>オーバードライブは高い音だけを増幅して頭を丸め、元の音に足す（上の式。<i>g</i> はゲインのつまみ）</li>
  <li>ディストーションは平らに切り、ファズは正と負で飽和の位置がずれる形</li>
  <li>非線形で増えた倍音のうち標本化周波数の半分を超える分は低い音に折り返す。原始関数 <i>F</i> の差で求めると折り返しが減る（下の式）<Fragment set:html={rf(5)} /></li>
</ul>

<h3>アンプとキャビネット</h3>
<ul class="tl">
  <li>増幅の段（クリーン 1 段・クランチ 2 段・ハイゲイン 3 段）のあとに、トーンの回路と出力段を置く<Fragment set:html={rf(6)} /></li>
  <li>増幅の段は正と負で飽和がずれる tanh の形で、段の間に高域通過と低域通過を置く</li>
  <li>トーンの回路は '59 Bassman の 3 次の伝達関数で、ベース・ミドル・トレブルのポットの位置で係数が変わる。ミドルを下げると谷が深くなる<Fragment set:html={rf(7)} /></li>
  <li>キャビネットは低い共振・中ほどの山・コーンの分割振動の谷・5 kHz 付近より上を落とす低域通過で近づける。マイクを端に寄せると高い音が減る</li>
</ul>

<h3>ほかのエフェクター</h3>
<ul class="tl">
  <li>コンプレッサー: 出力の大きさを dB で求め、しきい値を超えた分を 1/6 にする。立ち上がり 2 ms・戻り 180 ms でならす<Fragment set:html={rf(8)} /></li>
  <li>ワウ: 状態変数フィルタの帯域通過の山を 380 Hz〜2.3 kHz で動かす。オートは弾く強さで動かす<Fragment set:html={rf(9)} /></li>
  <li>コーラス・フランジャー: 揺らした遅れの音を混ぜる。フランジャーは遅れが短く、帰還がある<Fragment set:html={rf(10)} /></li>
  <li>フェイザー: 全域通過の 4 段の山を揺らし、元の音と混ぜて谷を動かす。トレモロは大きさを揺らす</li>
  <li>ディレイ: 帰還の中に 3.5 kHz の低域通過を置き、くり返すほど丸い音にする</li>
  <li>スプリングリバーブ: 遅延と全域通過の列で、低い音ほど遅れて届く。ばねの「びよん」という音<Fragment set:html={rf(11)} /></li>
  <li>ルームリバーブ: 8 本の遅延線をアダマール行列で混ぜる<Fragment set:html={rf(12)} /></li>
</ul>

<h3>チョーキングとフィードバック</h3>
<div class="eqs">
  <math display="block" set:html={`${wn}<mo>→</mo>${wn}<mspace width="0.15em"/><msup><mn>2</mn><mrow><mi>s</mi><mo>/</mo><mn>12</mn></mrow></msup><mspace width="1.2em"/>${an}<mo>←</mo>${an}<mo>+</mo><mi>κ</mi><mspace width="0.15em"/><mi>p</mi>${p('<mi>t</mi><mo>−</mo><mi>τ</mi>')}<mspace width="0.15em"/><mi>sin</mi><mo>⁡</mo><mfrac><mrow><mi>n</mi><mi>π</mi>${sub('<mi>x</mi>', '<mi>b</mi>')}</mrow><mi>L</mi></mfrac>`} />
</div>
<dl class="syms">
  <dt><math><mi>s</mi></math></dt><dd>チョーキング・ビブラートの量 [半音]</dd>
  <dt><math><mi>p</mi></math></dt><dd>キャビネットの出力</dd>
  <dt><math><mi>τ</mi></math></dt><dd>スピーカーから弦までの遅れ 6 ms</dd>
  <dt><math set:html={sub('<mi>x</mi>', '<mi>b</mi>')} /></dt><dd>音が弦を押す点（駒から 30 mm）</dd>
</dl>
<ul class="tl">
  <li>チョーキングは弦を押し上げて張力を上げる。すべての倍音の周波数が同じ比で上がる</li>
  <li>フィードバックは、スピーカーの音が胴と駒を通して弦を揺らし、その音がまた増幅されてスピーカーから出る輪</li>
  <li>歪んだアンプは大きさを頭打ちにするので、輪の中の大きさは一定に落ち着き、弦が鳴り続ける</li>
</ul>

<h3>このツールで決めたこと</h3>
<ul class="tl">
  <li>減衰率は σ = σ<sub>0</sub> + σ<sub>2</sub> f<sup>2</sup> で、巻弦の 4〜6 弦は高い音ほど早く消える。値は録音の残響時間の目安</li>
  <li>8 kHz より上の倍音は計算しない（コイルの共振より上は、ほとんど出ないため）</li>
  <li>ピックアップの出力の大きさ（シングルコイル 0.07 V/(m/s)、ハムバッカー 0.13 V/(m/s)）</li>
  <li>アンプの段の飽和の形・ゲインの範囲、キャビネットの共振と山と谷、ディレイとリバーブの値</li>
  <li>フィードバックの強さ（つまみ 10 で、キャビネットの出力 1 につき 1 サンプルで 0.15 µm を弦のモードへ足す）</li>
  <li>フレーズと音色のプリセットは、このツールのために作った</li>
  <li>ペダルはアンプの前とマイクの後ろに 5 台ずつまで。モノラルのペダルは左右を足して 1 つにしてから通す</li>
  <li>MIDI: 押した音を、押さえるフレットがいちばん低くなる空いた弦で弾く。ピッチベンドは ±2 半音、モジュレーションのホイールはビブラート（最大 ±0.5 半音）</li>
  <li>音を出す前は、同じ計算を 24 kHz で画面の側だけで回して波形を描く</li>
</ul>

