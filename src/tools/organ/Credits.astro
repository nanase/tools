---
// 楽譜の出典と、各曲の標準のテンポとレジストレーション。BWV 645 の音符は CC BY-SA 2.5、BWV 578 は CC BY-SA 4.0 の楽譜から変換したので、ここに帰属を表示する。BWV 565 は CC0 の演奏の MIDI。
// あとから足した曲（MORE）は、Mutopia と MuseScore（PDMX）の楽譜の MIDI。CC BY-SA の曲（結婚行進曲・ヴィドール 第 5 番・ダンドリュー）も、ここに帰属を表示する
import { type Piece, pieceOf } from './score';
import { stopName } from './stops';

/* 曲ごとの標準のテンポとレジストレーション。箇条書きの項目名と値の組 */
const meta = (v: string): [string, string][] => {
  const p = pieceOf(v);
  return [
    ['標準のテンポ', p.tempo],
    [p.regs ? '始めのストップ' : 'ストップ', p.stops.map(stopName).join('・')],
    ...(p.couplers.length ? [['カプラー', p.couplers.join('・')] as [string, string]] : []),
  ];
};
const MU = 'https://www.mutopiaproject.org/cgibin/piece-info.cgi?id=';
const MS = 'https://musescore.com/user/';
const PDMX = 'https://zenodo.org/records/15571083';
const LIC = {
  'by-sa-4.0': ['CC BY-SA 4.0', 'https://creativecommons.org/licenses/by-sa/4.0/deed.ja'],
  'by-sa-3.0': ['CC BY-SA 3.0', 'https://creativecommons.org/licenses/by-sa/3.0/deed.ja'],
  'by-sa-2.5': ['CC BY-SA 2.5', 'https://creativecommons.org/licenses/by-sa/2.5/deed.ja'],
  cc0: ['CC0', 'https://creativecommons.org/publicdomain/zero/1.0/deed.ja'],
  pdm: ['パブリックドメイン（Public Domain Mark 1.0）', 'https://creativecommons.org/publicdomain/mark/1.0/deed.ja'],
  pd: ['パブリックドメイン', ''],
} as const;
const OCT = "ペダルを 1 オクターブ上げた（MIDI は 16' の高さ）";
/*
 * あとから足した曲。src は Mutopia の番号か MuseScore の [楽譜の番号, 利用者の番号]、who は入力・作成者、
 * base は底本、mod は変換のほかに加えた変更
 */
const MORE: {
  v: string;
  src: number | readonly [number, number];
  who: string;
  date: string;
  base?: string;
  lic: keyof typeof LIC;
  mod?: string;
}[] = [
  {
    v: 'wedding',
    src: 2198,
    who: 'Alexander Brock',
    date: 'Mutopia-2017/10/24-2198',
    base: 'Durand & Cie., Paris（D. & F. 9516）',
    lic: 'by-sa-4.0',
    mod: '最初の音の前の 3 拍の休みを除いた',
  },
  { v: 'stanley65', src: [1814311, 7279491], who: 'dolch', date: '2016/02/28', lic: 'pdm' },
  { v: 'widor6', src: [4692306, 7540966], who: 'Noxygen', date: '2017/10/09', lic: 'cc0' },
  {
    v: 'widor5',
    src: 1201,
    who: 'Bart Golsteijn',
    date: 'Mutopia-2008/09/08-1201',
    base: 'J. Maho et J. Hamelle, Paris, 1880',
    lic: 'by-sa-3.0',
    mod: '前打音を本音符の開始で切った',
  },
  { v: 'gigout', src: [916706, 11441], who: 'karlk62', date: '2015/06/02', lic: 'pdm' },
  { v: 'pomp', src: [5103275, 18351], who: 'musikmann', date: '2018/05/20', lic: 'cc0' },
  {
    v: 'dandrieu',
    src: 696,
    who: 'Gérard Gréco',
    date: 'Mutopia-2006/03/13-696',
    base: 'Archives des Maîtres de l’Orgue, vol. 7（A. Guilmant 編、A. Durand et fils, 1905）',
    lic: 'by-sa-2.5',
  },
  {
    v: 'buxwv155',
    src: 2075,
    who: 'Pierre Masson',
    date: 'Mutopia-2015/11/18-2075',
    base: 'Breitkopf & Härtel, Leipzig, 1888, rev. 1903–04',
    lic: 'pd',
  },
  { v: 'canon', src: [5577547, 3785676], who: 'PhantomTones', date: '2019/05/20', lic: 'cc0' },
  { v: 'bwv593', src: [5907027, 33765145], who: 'Sonxaj', date: '2019/12/28', lic: 'cc0', mod: OCT },
  {
    v: 'bwv525',
    src: [115160, 101554],
    who: 'Johann Sebastian Bach（MuseScore の利用者名）',
    date: '2013/06/27',
    lic: 'pdm',
  },
  { v: 'bwv639', src: [6304139, 30732005], who: 'leonkopecny11', date: '2020/08/20', lic: 'cc0', mod: OCT },
  { v: 'bwv564', src: [5946480, 33765145], who: 'Sonxaj', date: '2020/01/29', lic: 'cc0', mod: OCT },
  {
    v: 'bwv542',
    src: 984,
    who: 'Urs Metzger',
    date: 'Mutopia-2007/05/20-984',
    base: 'C. F. Peters, Leipzig（8657）',
    lic: 'pd',
    mod: `楽譜の forte の声部を第 1 手鍵盤、piano の声部を第 2 手鍵盤で弾く。${OCT}`,
  },
];
const switches = (p: Piece) => (p.regs ? Object.keys(p.regs).length : 0);
const SCORES = 'https://github.com/nanase/tools/tree/main/src/tools/organ/scores';
/* Mutopia の MIDI には装飾が入っていないので、.ly の原本から展開したことを書く */
const ORN =
  'MIDI に入っていない装飾（トリル・モルデント）は、Mutopia の .ly の原本で位置と種類を調べ、バロックの奏法に従って音符にしています。';
const ORN_WAYS: [string, string][] = [
  ['トリル', '上の補助音から主音と交互に 1 秒に 8〜12 音で弾いて主音で終える'],
  ['モルデント', '主音・下の補助音・主音'],
];
---
<ul class="srcs">
  <li>
    <h3>トッカータとフーガ ニ短調 BWV 565 <small>J. S. バッハの作とされる</small></h3>
    <p>楽譜ではなく、人の演奏を記録した MIDI を使っています。<a href="https://opengameart.org/content/nes-bach-bwv-565">OpenGameArt の「NES - Bach - BWV 565」</a>（投稿 TheOuterLinux、2019）の zip に入っている MIDI で、<a href="https://creativecommons.org/publicdomain/zero/1.0/deed.ja">CC0</a>（パブリックドメインへの献呈）として公開されています。</p>
    <p>帰属の表示は要りませんが、変換と編集への謝意として投稿者の名前を書いています。同じデータは 2018 年から作成者の名前なしで出回っており、元の演奏・作成者は分かっていません。</p>
    <p>変換した音符のデータ（<a href={SCORES}>src/tools/organ/scores</a> の bwv565）も CC0 で公開します。</p>
    <ul class="tl">
      {meta('bwv565').map(([k, v]) => <li><b>{k}:</b> {v}</li>)}
    </ul>
    <p>MIDI は、次のように使っています。</p>
    <ul class="tl">
      <li><b>演奏の表情:</b> 演奏のテンポの変化とアルペジオ、モルデントやトリル、音の長さと時刻を、そのまま使う</li>
      <li><b>鍵盤:</b> Great・Swell・Pedal のトラックを、第 1 手鍵盤・第 2 手鍵盤・ペダルで弾く</li>
      <li><b>レジストレーション:</b> MIDI の Main Piston（ジェネラル・ピストン）の切り替え 10 回を、このオルガンのストップのレジストレーションの切り替えに当てて、演奏中に切り替える。番号に当てたストップは、区間の音楽からこのツールで選んだもの</li>
      <li><b>除いた音:</b> Mutopia の楽譜と照らして、明らかな弾き損じ 1 音だけを除いた。MIDI の 48 秒付近の二重の打鍵</li>
    </ul>
  </li>
  <li>
    <h3>コラール前奏曲「目覚めよと呼ぶ声あり」BWV 645 <small>J. S. バッハ「シューブラー・コラール集」より</small></h3>
    <p>音符は、<a href={`${MU}601`}>Mutopia Project の楽譜</a>の MIDI から変換し、反復を展開しました。</p>
    <ul class="tl">
      <li><b>入力:</b> Bart Golsteijn</li>
      <li><b>底本:</b> Bach-Gesellschaft, Leipzig</li>
      <li><b>楽譜の番号:</b> Mutopia-2006/06/29-601</li>
      {meta('bwv645').map(([k, v]) => <li><b>{k}:</b> {v}</li>)}
    </ul>
    <p>原作のライセンスは <a href="https://creativecommons.org/licenses/by-sa/2.5/deed.ja">クリエイティブ・コモンズ 表示 - 継承 2.5（CC BY-SA 2.5）</a>で、元の MIDI と、そこから作った音符のデータ（<a href={SCORES}>src/tools/organ/scores</a> の bwv645）も同じライセンスで公開します。</p>
    <p>{ORN}</p>
    <ul class="tl">
      {ORN_WAYS.map(([k, v]) => <li><b>{k}:</b> {v}</li>)}
    </ul>
    <p>右手（ritornello）は第 2 手鍵盤、左手（コラールの旋律）は第 1 手鍵盤で弾きます。</p>
  </li>
  <li>
    <h3>パッサカリアとフーガ ハ短調 BWV 582 <small>J. S. バッハ</small></h3>
    <p>音符は、<a href={`${MU}741`}>Mutopia Project の楽譜</a>の MIDI から変換しました。</p>
    <ul class="tl">
      <li><b>入力:</b> Urs Metzger</li>
      <li><b>底本:</b> C. F. Peters, Leipzig (8656)</li>
      <li><b>楽譜の番号:</b> Mutopia-2006/04/21-741</li>
      <li><b>ライセンス:</b> パブリックドメイン</li>
      {meta('bwv582').map(([k, v]) => <li><b>{k}:</b> {v}</li>)}
    </ul>
    <p>MIDI に含まれていた、ストップの代わりに 1 オクターブ上下へ写した声部（4'・16' の複製）は除いています。テンポの変化は MIDI の値を使っています。</p>
    <p>{ORN}</p>
    <ul class="tl">
      {ORN_WAYS.map(([k, v]) => <li><b>{k}:</b> {v}</li>)}
    </ul>
  </li>
  <li>
    <h3>フーガ ト短調 BWV 578（小フーガ） <small>J. S. バッハ</small></h3>
    <p>音符は、<a href="https://imslp.org/wiki/File:PMLP153148-Bach_578_Fugue_Gm.mid">IMSLP の MIDI</a>から変換しました。</p>
    <ul class="tl">
      <li><b>作成:</b> Pierre Gouin、Les Éditions Outremontaises、2017</li>
      {meta('bwv578').map(([k, v]) => <li><b>{k}:</b> {v}</li>)}
    </ul>
    <p>原作のライセンスは <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.ja">クリエイティブ・コモンズ 表示 - 継承 4.0 国際（CC BY-SA 4.0）</a>で、元の MIDI と、そこから作った音符のデータ（<a href={SCORES}>src/tools/organ/scores</a> の bwv578）も同じライセンスで公開します。</p>
    <p>MIDI でペダルに重ねてあった 1 オクターブ下の音（16' の代わり）は除き、テンポの変化と、音の長さや時刻の細かなずれ（演奏の表情）は MIDI のものを使っています。トリルなどの装飾は、MIDI に演奏として入っています。両手とも第 1 手鍵盤で弾きます。</p>
  </li>
</ul>
<p>次の曲は、<a href="https://www.mutopiaproject.org/">Mutopia Project</a> の楽譜か、MuseScore の楽譜（<a href={PDMX}>PDMX</a>、Long ほか 2024 に収録されたもの）の MIDI から変換しました。ストップの切り替えは MIDI にないので、強弱の変わり目・エコー・ペダルの休む区間からこのツールで決めました。音符のデータ（<a href={SCORES}>src/tools/organ/scores</a>）は、元の MIDI と同じライセンスで公開します。</p>
<ul class="srcs">
  {
    MORE.map((m) => {
      const p = pieceOf(m.v),
        [lic, url] = LIC[m.lic],
        n = switches(p);
      return (
        <li>
          <h3>
            {p.name} <small>{p.by}</small>
          </h3>
          <ul class="tl">
            <li>
              <b>出典:</b>{' '}
              {typeof m.src === 'number' ? (
                <a href={`${MU}${m.src}`}>Mutopia Project の楽譜</a>
              ) : (
                <a href={`${MS}${m.src[1]}/scores/${m.src[0]}`}>MuseScore の楽譜</a>
              )}
              （{m.date}）
            </li>
            <li>
              <b>{typeof m.src === 'number' ? '入力' : '作成'}:</b> {m.who}
            </li>
            {m.base && (
              <li>
                <b>底本:</b> {m.base}
              </li>
            )}
            <li>
              <b>ライセンス:</b> {url ? <a href={url}>{lic}</a> : lic}
            </li>
            {m.mod && (
              <li>
                <b>変更:</b> {m.mod}
              </li>
            )}
            {meta(m.v).map(([k, v]) => (
              <li>
                <b>{k}:</b> {v}
              </li>
            ))}
            {n > 1 && (
              <li>
                <b>切り替え:</b> {n} 種のレジストレーション
              </li>
            )}
          </ul>
        </li>
      );
    })
  }
</ul>
