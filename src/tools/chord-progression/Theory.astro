---
// 動作原理と式
const sub = (b: string, s: string) => `<msub>${b}<mrow>${s}</mrow></msub>`;
const p = (s: string) => `<mo stretchy="false">(</mo>${s}<mo stretchy="false">)</mo>`;
const rf = (...n: number[]) => n.map((k) => `<a class="rf" href="#thy-r${k}">[${k}]</a>`).join('');
const yn = (s: string) => `<mi>y</mi><mo stretchy="false">[</mo>${s}<mo stretchy="false">]</mo>`;
const ROWS: [string, string, string, string][] = [
  ['Ⅰ', 'Ⅳ・Ⅴ', 'Ⅵ', 'Ⅱ・Ⅲ'],
  ['Ⅱ', 'Ⅴ', 'Ⅳ・Ⅵ', 'Ⅰ・Ⅲ'],
  ['Ⅲ', 'Ⅵ', 'Ⅳ', 'Ⅰ・Ⅱ・Ⅴ'],
  ['Ⅳ', 'Ⅴ', 'Ⅰ・Ⅱ', 'Ⅲ・Ⅵ'],
  ['Ⅴ', 'Ⅰ', 'Ⅳ・Ⅵ', 'Ⅱ・Ⅲ'],
  ['Ⅵ', 'Ⅱ・Ⅴ', 'Ⅲ・Ⅳ', 'Ⅰ'],
  ['Ⅶ', 'Ⅲ', 'Ⅰ', '—'],
];
---
<h3>全体の流れ</h3>
<ol class="flow"><li>ブロックの並び</li><li>調・拍子・テンポ・奏法・音色</li><li>コードの音の高さ</li><li>奏法で時間に並べる</li><li>音色で鳴らす</li></ol>
<ul class="tl">
  <li>ブロックを左から読み、転調・拍子などのブロックはその後ろのコードに効く</li>
  <li>コードは調の主音からの半音の数（度数）と種類で持つ。転調のブロックの後ろは、同じ度数のまま高さだけが移る</li>
  <li>くり返しの終わりで回数が残っていれば、くり返しの始め（なければ曲の頭か前のくり返しの終わり）へ戻る。回数を無制限にすると止めるまで続く</li>
</ul>

<h3>つながりの強さ</h3>
<div class="tt-w"><table class="tt">
  <thead><tr><th>前の度数</th><th>定番</th><th>よく使う</th><th>ときどき</th></tr></thead>
  <tbody>{ROWS.map(([a, b, c, d]) => <tr><td>{a}</td><td>{b}</td><td>{c}</td><td>{d}</td></tr>)}</tbody>
</table></div>
<ul class="tl">
  <li>根音の度数どうしの進み方を、和声の教科書の表（usually・sometimes・less often）から 3 段に分ける<Fragment set:html={rf(1)} /></li>
  <li>長調と短調で同じ表を使う。♭・♯ の付いた根音は文字の度数で引く（♭Ⅶ は Ⅶ）</li>
  <li>属七の形（長 3 度と短 7 度を持つ）のコードから 5 度下への進行は定番。Ⅴ 以外の属七（セカンダリードミナント）がほかへ進むときは、ときどきまでに下げる</li>
  <li>調の外のコードが前か後ろにあれば 1 段下げる</li>
</ul>

<h3>終止と名前のある進行</h3>
<ul class="tl">
  <li>完全終止: Ⅴ（Ⅴ7）→ Ⅰ。変格終止: Ⅳ → Ⅰ。偽終止: Ⅴ → Ⅵm（短調では Ⅴ → Ⅵ）<Fragment set:html={rf(1)} /></li>
  <li>ツーファイブ: Ⅱm（Ⅱm7・Ⅱm7(♭5)）→ Ⅴ。ドミナント進行: 属七の形から 5 度下へ</li>
  <li>名前のある進行は、度数と長短の並びが同じ所を左から探す。短調は平行長調の度数に直して比べる（Ⅰm → Ⅵm）</li>
</ul>

<h3>和音の並べ方</h3>
<ul class="tl">
  <li>上の声部は根音（転回形では指定の構成音）から積み、最も低い音を E3〜D♯4 に置く。3 和音には根音のオクターブ上を足して 4 音にする</li>
  <li>ベースは最も低い構成音を E2〜D♯3 に置く。伴奏のベースはその 1 オクターブ下</li>
  <li>奏法は 8 分音符を 1 歩として、何歩目に何番目の音を弾くかを並べる。ギターとエレピの音はコードの終わりまで鳴らしたままにする</li>
  <li>自分で作る奏法は、8 分か 16 分の刻みの格子に、ベースと上の 5 声のどれを弾くかを置く。1 周をコードの長さまでくり返し、和音の音が足りない段は弾かない。作った奏法は曲と一緒に保存する</li>
</ul>

<h3>音色</h3>
<div class="eqs">
  <math display="block" set:html={`${yn('<mi>n</mi>')}<mo>=</mo><mi>ρ</mi>${p(`<mfrac><mn>1</mn><mn>4</mn></mfrac>${yn('<mi>n</mi><mo>−</mo><mi>N</mi>')}<mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac>${yn('<mi>n</mi><mo>−</mo><mi>N</mi><mo>−</mo><mn>1</mn>')}<mo>+</mo><mfrac><mn>1</mn><mn>4</mn></mfrac>${yn('<mi>n</mi><mo>−</mo><mi>N</mi><mo>−</mo><mn>2</mn>')}`)}<mo>,</mo><mspace width="0.6em"/>${sub('<mi>f</mi>', '<mn>0</mn>')}<mo>=</mo><mfrac>${sub('<mi>f</mi>', '<mi>s</mi>')}<mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac>`} />
  <math display="block" set:html={`<mi>x</mi>${p('<mi>t</mi>')}<mo>=</mo><mi>A</mi>${p('<mi>t</mi>')}<mspace width="0.15em"/><mi>sin</mi><mo>⁡</mo>${p(`<mn>2</mn><mi>π</mi><mi>f</mi><mi>t</mi><mo>+</mo><mi>I</mi>${p('<mi>t</mi>')}<mspace width="0.15em"/><mi>sin</mi><mo>⁡</mo><mn>2</mn><mi>π</mi><mi>f</mi><mi>t</mi>`)}`} />
</div>
<dl class="syms">
  <dt><math><mi>N</mi></math></dt><dd>遅延の長さ [サンプル]</dd>
  <dt><math><mi>ρ</mi></math></dt><dd>1 周ごとの減衰（0.9988〜0.9996。高い音ほど小さい）</dd>
  <dt><math set:html={sub('<mi>f</mi>', '<mi>s</mi>')} /></dt><dd>標本化周波数</dd>
  <dt><math><mi>I</mi></math></dt><dd>変調の深さ（鳴らした直後 2.2 から 0.25 へ減る）</dd>
</dl>
<ul class="tl">
  <li>アコースティックギターとクラシックギター: <a href="../guitar/">ギター音響モデル</a>のページの物理モデル（弦の固有振動と胴の響き）で鳴らす。スチール弦はドレッドノートの胴とピック、ナイロン弦はクラシックの胴と指</li>
  <li>和音の音は標準の調弦の弦とフレットに割り当てる。低い音ほど低い弦に置き、押さえる幅が狭い押さえ方を選ぶ。コードの終わりで指を離す</li>
  <li>ハープ: 上の式の撥弦の合成<Fragment set:html={rf(2)} />。遅延線の中の 3 点の低域通過で遅れが 1 サンプル増えるので、再生の速さで高さを合わせる<Fragment set:html={rf(3)} /></li>
  <li>ハープの弾き始めの形は、指の腹で弦の 40 % の所を引いた、角の丸い三角形。響板の山（250 Hz・900 Hz）を通し、指を離しても長く響かせる</li>
  <li>エレピ: 同じ周波数の 2 つの正弦波の周波数変調<Fragment set:html={rf(4)} />。打った直後ほど倍音が多い</li>
  <li>ピアノ: 早く消える明るい成分と、遅く消える柔らかい成分を重ね、少しずらした 2 本でうなりを作る</li>
  <li>オルガン: 1〜4 倍の正弦波の和</li>
  <li>ストリングス: 少しずつずらした 3 本ののこぎり波に、遅れて掛かるビブラートと胴の響きの山（300 Hz・1 kHz・2.8 kHz）</li>
  <li>シンセパッド: 3 本ののこぎり波を、ゆっくり動く低域通過に通す。ブラス: 吹き始めに低域通過を開いてから少し閉じ、遅れてビブラートを掛ける</li>
  <li>マリンバとビブラフォン: 板の 1 次と 4 倍の振動。ビブラフォンは長く響き、5.5 Hz で音量が揺れる</li>
  <li>ベル: 周波数比 3.5 の周波数変調<Fragment set:html={rf(4)} /></li>
  <li>メトロノーム: 短い雑音を帯域通過に通した当たりと、すぐ消える正弦波</li>
  <li>残響: サイト共通の遅延線の網<Fragment set:html={rf(5)} />で部屋の響きを作り、すべての音に畳み込む。聴く位置は 3 m</li>
  <li>音色ごとの大きさは、同じ和音を鳴らしたときの実効値がそろうように合わせる</li>
</ul>

<h3>このツールで決めたこと</h3>
<ul class="tl">
  <li>つながりの強さの段の名前（定番・よく使う・ときどき）と、調の外のコードやセカンダリードミナントで段を下げる決まり</li>
  <li>機能の分け方: Ⅰ・Ⅲ・Ⅵ（調の中の和音）はトニック、Ⅴ と Ⅶ の減三和音と属七の形はドミナント、ほかはサブドミナント</li>
  <li>名前のある進行（カノン進行・王道進行・小室進行・丸サ進行・循環進行・ツーファイブワン・12 小節のブルース）は、日本で広く使われている呼び名</li>
  <li>サンプルの進行・テンポ・奏法・音色は、このツールのために選んだ。特定の曲を写したものではない</li>
  <li>音色の値（減衰・弾く位置・変調の深さ・倍音の大きさ・フィルタ・ビブラート）と、和音を置く高さ</li>
  <li>ギターの弦とフレットの割り当て方（12 フレットまで、押さえる幅と高いフレットを減点）</li>
  <li>くり返しは入れ子にしない。終わりのブロックは手前の始めまで戻る</li>
</ul>

