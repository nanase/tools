---
/** しくみの枠: コード進行の決まりを 7 つの小さな図と短い説明で順に見せる */
const W = 150;
const box = (x: number, y: number, w: number, h: number, fn: string, t: string, s = '') =>
  `<rect class="cp-hb cp-h${fn}" x="${x}" y="${y}" width="${w}" height="${h}" rx="3"/><rect class="cp-hf cp-h${fn}" x="${x}" y="${y}" width="3.5" height="${h}"/><text class="cp-ht" x="${x + 8}" y="${y + 15}">${t}</text>${s ? `<text class="cp-hs" x="${x + 8}" y="${y + 28}">${s}</text>` : ''}`;
const arr = (x0: number, x1: number, y: number, w = 2) =>
  `<path class="cp-hl" d="M${x0} ${y}H${x1 - 5}" stroke-width="${w}"/><path class="cp-hh" d="M${x1} ${y}l-6 -4v8z"/>`;
const ROM = ['Ⅰ', 'Ⅱ', 'Ⅲ', 'Ⅳ', 'Ⅴ', 'Ⅵ', 'Ⅶ'];
const FN = ['T', 'S', 'T', 'S', 'D', 'T', 'D'];
const STEPS: { h: string; svg: string; p: string }[] = [
  {
    h: 'ダイアトニックコード',
    svg: ROM.map((r, i) => {
      const x = 12 + i * 19.5;
      return `${[0, 2, 4].map((k) => `<circle class="cp-hd cp-h${FN[i]}" cx="${x}" cy="${44 - (i + k) * 3.2}" r="3"/>`).join('')}<text class="cp-hs" x="${x}" y="62" text-anchor="middle">${r}</text>`;
    }).join(''),
    p: '音階の音に 1 つおきに 2 音を重ねた 7 つの和音。根音の度数で Ⅰ〜Ⅶ と呼ぶ',
  },
  {
    h: '機能',
    svg: `${box(4, 22, 40, 22, 'T', 'T')}${box(55, 22, 40, 22, 'S', 'S')}${box(106, 22, 40, 22, 'D', 'D')}${arr(44, 55, 33)}${arr(95, 106, 33)}<path class="cp-hl" d="M126 44V54H24V49" stroke-width="2"/><path class="cp-hh" d="M24 44l-4 6h8z"/><text class="cp-hs" x="10" y="16">落ち着く</text><text class="cp-hs" x="108" y="16">戻りたい</text>`,
    p: 'トニック・サブドミナント・ドミナントの 3 つの役割。ドミナントはトニックへ戻りたがる',
  },
  {
    h: 'つながりの強さ',
    svg: `${box(4, 22, 30, 22, 'D', 'Ⅴ')}${[
      ['Ⅰ', 3, 6, 'T'],
      ['Ⅵm', 2, 27, 'T'],
      ['Ⅱm', 1, 48, 'S'],
    ]
      .map(
        ([t, lv, y, f]) =>
          `<path class="cp-hl${lv === 1 ? ' d' : ''}" d="M34 33L${100 - 5} ${Number(y) + 9}" stroke-width="${[0, 1.2, 2.2, 3.6][Number(lv)]}"/>${box(100, Number(y), 34, 18, String(f), String(t))}`,
      )
      .join('')}`,
    p: '和声の教科書の表から 3 段。定番ほど太い矢印',
  },
  {
    h: '終止',
    svg: `${box(4, 4, 26, 18, 'D', 'Ⅴ')}${arr(30, 42, 13)}${box(42, 4, 26, 18, 'T', 'Ⅰ')}<text class="cp-hc" x="76" y="17">完全終止</text>${box(4, 25, 26, 18, 'S', 'Ⅳ')}${arr(30, 42, 34)}${box(42, 25, 26, 18, 'T', 'Ⅰ')}<text class="cp-hc" x="76" y="38">変格終止</text>${box(4, 46, 26, 18, 'D', 'Ⅴ')}${arr(30, 42, 55)}${box(42, 46, 30, 18, 'T', 'Ⅵm')}<text class="cp-hc" x="80" y="59">偽終止</text>`,
    p: '区切りを作るつながりの名前。偽終止は Ⅰ の代わりに Ⅵm へ進んで続ける',
  },
  {
    h: '五度圏',
    svg: `${Array.from({ length: 12 }, (_, i) => {
      const a = ((i * 30 - 90) * Math.PI) / 180,
        lit = i === 0 || i === 1 || i === 11;
      return `<circle class="${lit ? 'cp-hd cp-hT' : 'cp-ho'}" cx="${(75 + Math.cos(a) * 27).toFixed(1)}" cy="${(34 + Math.sin(a) * 27).toFixed(1)}" r="${lit ? 4 : 3}"/>`;
    }).join(
      '',
    )}<text class="cp-hs" x="66" y="6" text-anchor="end">C</text><text class="cp-hs" x="106" y="18">G</text><text class="cp-hs" x="38" y="18" text-anchor="end">F</text><path class="cp-hl" d="M80 12Q95 12 95 22" stroke-width="2"/><path class="cp-hh" d="M98 18l-4 7l-3 -6z"/>`,
    p: '隣どうしが 5 度違いの 12 の調の輪。同じ調の和音は隣り合う 3 つにまとまる',
  },
  {
    h: '奏法',
    svg: `${[0, 1, 2, 3, 4, 3, 2, 1, 0, 1, 2, 3, 4, 3, 2, 1].map((v, s) => `<circle class="cp-hd cp-hT" cx="${10 + s * 8.6}" cy="${52 - v * 9}" r="2.6"/>`).join('')}<path class="cp-hg" d="M6 58H146"/><text class="cp-hs" x="6" y="10">高い音</text>`,
    p: '和音の音を時間に並べる弾き方。全音符・ストローク・アルペジオなど',
  },
  {
    h: '転調とくり返し',
    svg: `${box(4, 8, 32, 22, 'T', 'Ⅰ', '')}${box(40, 8, 32, 22, 'D', 'Ⅴ')}<rect class="cp-hm" x="78" y="8" width="20" height="22" rx="3"/><text class="cp-hs" x="88" y="23" text-anchor="middle">D</text>${box(102, 8, 32, 22, 'T', 'Ⅰ')}<text class="cp-hs" x="20" y="44" text-anchor="middle">C</text><text class="cp-hs" x="56" y="44" text-anchor="middle">G</text><text class="cp-hs" x="118" y="44" text-anchor="middle">D</text><path class="cp-hg" d="M4 54H146"/><text class="cp-hs" x="6" y="64">度数のまま高さだけ移る</text>`,
    p: 'コードは調からの度数で持つので、転調のブロックの後ろは同じ形のまま移る',
  },
];
---
<ol class="cp-how">
  {STEPS.map((s, i) => (
    <li><h3><b>{i + 1}</b>{s.h}</h3><svg class="cp-mini" viewBox={`0 0 ${W} 66`} aria-hidden="true" set:html={s.svg} /><p>{s.p}</p></li>
  ))}
</ol>
