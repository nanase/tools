---
// 動作原理と式。代入した式（#subst）は client.ts が入れる
import {
  EQS_CP,
  EQS_FIND,
  EQS_L,
  EQS_R,
  EQS_SER,
  EQS_SHAPE,
  RF_GROVER,
  THY_CP,
  THY_FIND,
  THY_L,
  THY_LIMIT,
  THY_OWN,
  THY_PAR,
  THY_R,
  THY_SER,
  THY_SHAPE,
} from './theory';
---
<h3>うずまきの形</h3>
<Fragment set:html={THY_SHAPE} />
<div class="eqs" set:html={EQS_SHAPE} />
<h3>インダクタンス</h3>
<Fragment set:html={THY_L} />
<div class="eqs" set:html={EQS_L} />
<h3>抵抗と Q</h3>
<Fragment set:html={THY_R} />
<div class="eqs" set:html={EQS_R} />
<h3>2 層以上</h3>
<Fragment set:html={THY_SER} />
<h4>並列</h4>
<Fragment set:html={THY_PAR} />
<div class="eqs" set:html={EQS_SER} />
<h4>層の間の容量</h4>
<Fragment set:html={THY_CP} />
<div class="eqs" set:html={EQS_CP} />
<h3>条件から探す</h3>
<Fragment set:html={THY_FIND} />
<div class="eqs" set:html={EQS_FIND} />
<h3>計算に含めないもの</h3>
<Fragment set:html={THY_LIMIT} />
<h3>今の値を代入した式</h3>
<div class="eqs">
  <div class="subst" id="subst" role="group" aria-label="現在の値を代入した式"></div>
</div>
<h3>出典</h3>
<ol class="refs">
