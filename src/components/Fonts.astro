---
/**
 * 数値・ロゴ用の Fira Mono（500 / 700）を自前でホストする。
 * latin に加え、単位の μ・Ω のために greek も置く。unicode-range により greek は使うページでだけ読まれる
 */
import greek500 from '@fontsource/fira-mono/files/fira-mono-greek-500-normal.woff2?url';
import greek700 from '@fontsource/fira-mono/files/fira-mono-greek-700-normal.woff2?url';
import latin500 from '@fontsource/fira-mono/files/fira-mono-latin-500-normal.woff2?url';
import latin700 from '@fontsource/fira-mono/files/fira-mono-latin-700-normal.woff2?url';

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const GREEK = 'U+0370-0377,U+037A-037F,U+0384-038A,U+038C,U+038E-03A1,U+03A3-03FF';
const face = (w: number, url: string, range: string) =>
  `@font-face{font-family:"Fira Mono";font-style:normal;font-weight:${w};font-display:swap;src:url(${url}) format("woff2");unicode-range:${range}}`;
const css = [
  face(500, latin500, LATIN),
  face(700, latin700, LATIN),
  face(500, greek500, GREEK),
  face(700, greek700, GREEK),
].join('');
---
<link rel="preload" href={latin500} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={latin700} as="font" type="font/woff2" crossorigin>
<style is:inline set:html={css}></style>
