---
/**
 * 楽器のページの演奏の枠の操作（2026-10-18 決定の案 B）: 頭へ戻す・演奏と一時停止・演奏の位置（小節の目盛り付き）。
 * 右端の slot には、楽器ごとの音の操作（リリース・消音など）をアイコンのボタン（.tp-sq）で置く。
 * 枠線の上の右端の状態の表示は TransportState。動作は lib/transport.ts
 */
---
<div class="tp">
  <button type="button" class="tp-ib" id="tp-home" title="曲の頭へ戻す" aria-label="曲の頭へ戻す"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="1.5" y="1.5" width="1.8" height="9"/><path d="M10.5 1.5v9L4 6z"/></svg></button>
  <button type="button" class="tp-pp" id="tp-pp" title="今の位置から演奏する" aria-label="演奏する"><svg class="i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.2l7.6 4.8L3 10.8z"/></svg><svg class="i-pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1.5" width="2.8" height="9"/><rect x="7.2" y="1.5" width="2.8" height="9"/></svg></button>
  <div class="tp-tl">
    <div class="tp-trk" id="tp-trk" role="slider" tabindex="0" aria-label="演奏の位置" aria-valuemin="1" aria-valuemax="1" aria-valuenow="1">
      <div class="tp-rail"></div>
      <div class="tp-fill" id="tp-fill"></div>
      <svg class="tp-tk" id="tp-tk" aria-hidden="true"><path class="mn"/><path class="mj"/></svg>
      <div class="tp-th" id="tp-th"></div>
    </div>
    <div class="tp-tm"><span><b id="tp-bar">1</b> / <span id="tp-bars">–</span> 小節</span><span id="tp-time"></span></div>
  </div>
  <div class="tp-side"><slot /></div>
</div>
