---
/**
 * 数値入力の 1 行。値・目盛り・▲▼ の行き先はブラウザ側（lib/param.ts の ParamGroup）が入れる。
 * 補足（d.sub）は項目名の吹き出しに出す。fold なら入力欄を畳んで出す（FoldSwitch）
 */
import type { ParamDef } from '../lib/param-def';
import FoldSwitch from './FoldSwitch.astro';

interface Props {
  d: ParamDef;
  fold?: boolean;
}
const { d, fold } = Astro.props;
---
<div class:list={['prow', { fold, shut: fold }]} id={`p-${d.k}`}>
  <div class="c-sym" aria-hidden="true" set:html={d.sym} />
  <div class="c-name"><label class="pn" for={`in-${d.k}`}><span class="sr">{d.nm} </span>{d.name}</label><p class="desc tip" id={`t-${d.k}`} role="tooltip" hidden>{d.sub}</p>{fold && <FoldSwitch k={d.k} name={d.name} />}</div>
  <div class="fbody" id={`fb-${d.k}`}>
    <div class="c-val"><div class="fld">
      <button type="button" class="stp" data-d="-1"><svg viewBox="0 0 12 8" aria-hidden="true"><path d="M6 7L1 1H11Z"/></svg><small></small></button>
      <input id={`in-${d.k}`} type="text" inputmode={d.inputmode ?? 'text'} autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="done" placeholder={d.ph} aria-describedby={`t-${d.k} u-${d.k} m-${d.k}`}>
      <button type="button" class="stp" data-d="1"><svg viewBox="0 0 12 8" aria-hidden="true"><path d="M6 1L11 7H1Z"/></svg><small></small></button>
    </div></div>
    <div class="c-unit" id={`u-${d.k}`}>{d.unit}</div>
    <div class="c-sub">
      <p class="msg" id={`m-${d.k}`} aria-live="polite"></p>
      {d.slider !== false && <div class="sl"><input type="range" min="0" step="1" aria-label={`${d.nm} ${d.name}`}><div class="tk" aria-hidden="true"></div></div>}
      {d.pre.length > 0 && (
        <div class="chips" role="group" aria-label={`${d.nm} のよく使う値`}>
          {d.pre.map(([v, l, t]) => <button type="button" class="chip" data-v={v} aria-pressed="false" title={t}>{l}</button>)}
        </div>
      )}
    </div>
  </div>
</div>
