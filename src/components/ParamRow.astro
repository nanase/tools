---
/**
 * 数値入力の 1 行: 記号 | 項目名 | 数値欄 | 単位 | ↺。数値欄そのものがスライダーで、左右にドラッグすると値の並びを移り、
 * 押すと入力欄に変わる（下に範囲・プリセット・既定値の吹き出し）。値・地の位置・‹ › の行き先はブラウザ側
 * （lib/param.ts の ParamGroup）が入れる。補足（d.sub）は項目名の吹き出しに出す
 */
import type { ParamDef } from '../lib/param-def';
import RowReset from './RowReset.astro';

interface Props {
  d: ParamDef;
}
const { d } = Astro.props;
const k = d.k;
---
<div class="prow num" id={`p-${k}`} data-nm={d.nm}>
  <div class="c-sym" aria-hidden="true" set:html={d.sym} />
  <div class="c-name"><span class="pn" id={`n-${k}`}><span class="sr">{d.nm} </span>{d.name}</span><p class="desc tip" id={`t-${k}`} role="tooltip" hidden>{d.sub}</p></div>
  <div class="c-val">
    <div class="sc" tabindex="0" role="slider" aria-labelledby={`n-${k}`} aria-describedby={`t-${k} u-${k} m-${k}`}>
      <span class="sc-f" aria-hidden="true"></span><span class="sc-c" aria-hidden="true"></span><span class="sc-p" aria-hidden="true"></span>
      <button type="button" class="sc-a" data-d="-1" tabindex="-1"><svg viewBox="0 0 6 10" aria-hidden="true"><path d="M5 1L1 5L5 9"/></svg></button>
      <span class="sc-v"></span>
      <button type="button" class="sc-a" data-d="1" tabindex="-1"><svg viewBox="0 0 6 10" aria-hidden="true"><path d="M1 1L5 5L1 9"/></svg></button>
    </div>
    <input class="sc-in" id={`in-${k}`} type="text" inputmode={d.inputmode ?? 'text'} autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="done" placeholder={d.ph} aria-labelledby={`n-${k}`} aria-describedby={`t-${k} u-${k} rg-${k}`}>
    <div class="sc-pop" role="group" aria-labelledby={`n-${k}`}>
      <p class="sc-rg" id={`rg-${k}`}></p>
      <p class="msg sc-m" aria-live="polite"></p>
      {d.pre.length > 0 && (
        <div class="chips" role="group" aria-label={`${d.nm} のよく使う値`}>
          {d.pre.map(([v, l, t]) => <button type="button" class="chip" data-v={v} aria-pressed="false" title={t}>{l}</button>)}
        </div>
      )}
      <button type="button" class="sc-df"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4.5V9h4.5"/></svg><span></span></button>
    </div>
  </div>
  <div class="c-unit" id={`u-${k}`}>{d.unit}</div>
  <RowReset label={`${d.nm} を既定値に戻す`} />
  <div class="c-sub"><p class="msg" id={`m-${k}`} aria-live="polite"></p></div>
</div>
