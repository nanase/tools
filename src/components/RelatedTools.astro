---
/** 関連ツール。表示件数の調整は lib/tool-page.ts */
import { order, TOOLS, type Tool } from '../data/tools';
import Panel from './Panel.astro';
import ToolCard from './ToolCard.astro';

type Props =
  | {
      current: string;
      /** 同じカテゴリのツールを並べる */
      category: string;
    }
  | {
      /** 並べるツールを直接渡す（カテゴリにほかのツールがない場合など） */
      list: Tool[];
    };
const p = Astro.props;
const list = 'list' in p ? p.list : order(TOOLS.filter((t) => t.c === p.category && t.id !== p.current));
---
<Panel hid="hd-rel" title="関連ツール" class="rel">
  <a slot="aux" class="aux" href={import.meta.env.BASE_URL}>すべてのツール</a>
  <div class="units" id="related">
    {list.map((t) => <ToolCard t={t} />)}
  </div>
</Panel>
