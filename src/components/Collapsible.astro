---
/**
 * 開閉できる枠（閉じると見出しの載った水平線だけ）。初期状態は閉じる。動作は lib/tool-page.ts。
 * class を省くと動作原理と式の枠（a-thy）になる。入力を置く枠は class で並びの名前を渡す。
 * 開いている間は、右上に枠の入力を既定値へ戻す「↺ n 件」を出す（lib/reset.ts）
 */
interface Props {
  hid: string;
  title: string;
  class?: string;
}
const { hid, title, class: cls = 'a-thy' } = Astro.props;
---
<details class:list={['pnl clps', cls]}>
  <summary><h2 id={hid} style="font:inherit">{title}</h2></summary>
  <div class="pha"><button type="button" class="prst" hidden></button></div>
  <div class="thy-body"><slot /></div>
</details>
