---
import { href, keys, type Tool } from '../data/tools';
import { artAt } from '../lib/card-art';

interface Props {
  t: Tool;
  /** トップの絞り込みの対象にする（検索文字列を持たせる） */
  filterable?: boolean;
}
const { t, filterable } = Astro.props;
const soon = !!t.s;
const Tag = soon ? 'div' : 'a';
---
<Tag class:list={['unit', { soon }]} href={soon ? undefined : href(t)} data-k={filterable ? keys(t) : undefined}>
  <div class="scr"><svg class="ic" viewBox="0 0 120 48" aria-hidden="true" data-art={soon ? undefined : t.ic} set:html={artAt(t.ic)} /></div>
  {soon && <div class="u-meta">準備中</div>}
  <h3>{t.t}</h3><p>{t.d}</p>
</Tag>
<script>
  import '../scripts/card-motion';
</script>
