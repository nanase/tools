---
import { CATS, href, keys, order, TOOLS } from '../data/tools';

interface Props {
  /** 現在のツールの id（トップでは省略） */
  current?: string | undefined;
  /** 見出しが隠れたときに上部バーへ出すページ名 */
  page?: string | undefined;
}
const { current, page } = Astro.props;
const groups = CATS.map((c) => [c, order(TOOLS.filter((t) => t.c === c))] as const);
/** 開いたときに選んでおくカテゴリ: 今のツールのカテゴリ（トップでは先頭） */
const here = TOOLS.find((t) => t.id === current)?.c;
const sel = here ?? CATS[0];
---
<header class="rail">
  <div class="wrap">
    <a class="brand" href={import.meta.env.BASE_URL} data-page={page}>
      <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><rect x="1" y="1" width="28" height="28" rx="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M5 20H10V9H16V20H22V9H25" fill="none" stroke="#f2c230" stroke-width="2" stroke-linejoin="round"/></svg>
      <span><b id="brandT">Tools + Simulators</b><small id="brandS">nanase.cc / tools</small></span>
    </a>
    <nav class="rnav" aria-label="サイト">
      <button type="button" class="rb" id="themeBtn" data-s="system" aria-label="配色: 自動">
        <svg class="ic-s t-sys" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
        <svg class="ic-s t-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
        <svg class="ic-s t-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
      </button>
      <button type="button" class="rb" id="menuBtn" aria-expanded="false" aria-controls="menu" aria-label="ツールを探す" title="ツールを探す（Ctrl+K）">
        <svg class="ic-s" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </nav>
  </div>
  <div class="scrim" id="scrim" hidden></div>
  {/* 左にカテゴリ、右に選んだカテゴリのツール。図柄はメニューを初めて開くときに data-art から読み込む（lib/site.ts） */}
  <div class="menu" id="menu" role="dialog" aria-label="ツール一覧" tabindex="-1" hidden data-art={`${import.meta.env.BASE_URL}menu-art.json`}>
    <label class="menu-q">
      <svg class="ic-s" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
      <span class="sr">ツールを絞り込み</span>
      <input id="mq" type="search" placeholder="ツールを絞り込み" autocomplete="off" spellcheck="false" enterkeyhint="go">
      <kbd class="menu-kbd" id="mkbd">Ctrl K</kbd>
    </label>
    <div class="menu-body">
      <div class="menu-cats" id="menuCats" role="tablist" aria-label="カテゴリ" aria-orientation="vertical">
        {groups.map(([c, L], i) => (
          <button type="button" class="menu-cat" role="tab" id={`mc${i}`} aria-controls={`mp${i}`} aria-selected={c === sel ? 'true' : 'false'} tabindex={c === sel ? 0 : -1}>
            <span class="menu-cn">{c}</span>{c === here && <span class="led on" aria-hidden="true"></span>}<span class="menu-n">{L.length}</span>
          </button>
        ))}
      </div>
      <div class="menu-pane" id="menuList">
        {groups.map(([c, L], i) => (
          <section class="menu-sec" id={`mp${i}`} role="tabpanel" aria-labelledby={`mc${i}`} hidden={c !== sel}>
            <h2>{c}<span class="menu-n">{L.length}</span></h2>
            <ul>
              {L.map(t => (
                <li data-k={keys(t)}>
                  {t.s
                    ? <span class="menu-tile soon"><span class="menu-scr" data-ic={t.ic} aria-hidden="true"></span><span class="menu-tn">{t.t}<span class="tag">準備中</span></span></span>
                    : <a class="menu-tile" href={href(t)} aria-current={t.id === current ? 'page' : undefined}><span class="menu-scr" data-ic={t.ic} aria-hidden="true"></span><span class="menu-tn">{t.id === current && <span class="led on" aria-hidden="true"></span>}{t.t}</span></a>}
                </li>
              ))}
            </ul>
          </section>
        ))}
        <p class="none" hidden>該当なし</p>
      </div>
    </div>
  </div>
</header>
