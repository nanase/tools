---
/**
 * 選択肢だけの行（パラメータ表の 1 行）。動作は lib/choice.ts の Choice（new Choice($('#p-{k}'), fn)）。
 * layout="seg": 値の欄に区切りボタン、"chips": 補足の段にチップを並べる。
 * 補足（sub）は項目名の吹き出しに出す。項目名の直後に置くもの（「?」ボタンなど）は slot="help"。
 * fold なら選択肢を畳んで出す（FoldSwitch）
 */
import FoldSwitch from './FoldSwitch.astro';

type V = string | number | boolean;

interface Props {
  k: string;
  /** 記号の HTML。'' なら空欄 */
  sym?: string;
  /** 記号の欄に足すクラス */
  symClass?: string;
  /** 読み上げ用の短い名前（項目名の前に読む） */
  nm?: string;
  name: string;
  sub?: string;
  /** [値, 表示, title] */
  choices: readonly (readonly [V, string] | readonly [V, string, string])[];
  value: V;
  layout?: 'seg' | 'chips';
  /** 項目名を行の幅いっぱいに出す（chips 向け） */
  wide?: boolean;
  /** メッセージの欄を置く（Choice の note・setOff で使う） */
  msg?: boolean;
  fold?: boolean;
  class?: string;
}
const {
  k,
  sym = '',
  symClass,
  nm,
  name,
  sub = '',
  choices,
  value,
  layout = 'seg',
  wide,
  msg,
  fold,
  class: cls,
} = Astro.props;
const nid = `n-${k}`,
  tid = `t-${k}`;
const btns = choices.map(([v, l, t]) => ({ v: String(v), l, t, on: String(v) === String(value) }));
---
<div class:list={['prow', { wide, fold, shut: fold }, cls]} id={`p-${k}`}>
  <div class:list={['c-sym', symClass]} aria-hidden="true" set:html={sym} />
  <div class="c-name"><span class="pn" id={nid}>{nm && <span class="sr">{nm} </span>}{name}</span><p class="desc tip" id={tid} role="tooltip" hidden>{sub}</p><slot name="help" />{fold && <FoldSwitch k={k} name={name} />}</div>
  <div class="fbody" id={`fb-${k}`}>
    {layout === 'seg' && (
      <div class="c-val"><div class="seg" role="group" aria-labelledby={nid} aria-describedby={tid}>
        {btns.map((b) => <button type="button" data-v={b.v} aria-pressed={b.on ? 'true' : 'false'} title={b.t}>{b.l}</button>)}
      </div></div>
    )}
    {(msg || layout === 'chips') && (
      <div class="c-sub">
        {msg && <p class="msg" aria-live="polite"></p>}
        {layout === 'chips' && (
          <div class="chips" role="group" aria-labelledby={nid} aria-describedby={tid}>
            {btns.map((b) => <button type="button" class="chip" data-v={b.v} aria-pressed={b.on ? 'true' : 'false'} title={b.t}>{b.l}</button>)}
          </div>
        )}
      </div>
    )}
  </div>
</div>
