---
/**
 * 枠: 細い線に見出しを載せる。右端に載せる補足・ボタンは slot="aux"。
 * aux の左に、枠の中の入力のうち既定値と違うものを戻す「↺ n 件」を置く（lib/reset.ts が出し入れする）
 */
interface Props {
  hid: string;
  title: string;
  class?: string;
}
const { hid, title, class: cls } = Astro.props;
---
<section class:list={['pnl', cls]} aria-labelledby={hid}>
  <div class="ph"><h2 id={hid}>{title}</h2><div class="pha"><button type="button" class="prst" hidden></button><slot name="aux" /></div></div>
  <slot />
</section>
